package com.bul.zydex.model.support;

/**
 *
 * @author Administrator
 */
public class ForgotPwd {

    private int level;
    private String email;
    private String password;
    private String emailL1;
    private String emailL2;
    private String emailL3;
    private String textL3;

    public String getEmail() {
        return email;
    }

    public void setEmail(String email) {
        this.email = email;
    }
    
    public String getEmailL1() {
        return emailL1;
    }

    public String getEmailL2() {
        return emailL2;
    }

    public String getEmailL3() {
        return emailL3;
    }

    public int getLevel() {
        return level;
    }

    public String getTextL3() {
        return textL3;
    }

    public void setEmailL1(String emailL1) {
        this.emailL1 = emailL1;
    }

    public void setEmailL2(String emailL2) {
        this.emailL2 = emailL2;
    }

    public void setEmailL3(String emailL3) {
        this.emailL3 = emailL3;
    }

    public void setLevel(int level) {
        this.level = level;
    }

    public void setTextL3(String textL3) {
        this.textL3 = textL3;
    }

    public String getPassword() {
        return password;
    }

    public void setPassword(String password) {
        this.password = password;
    }
    
    
}
