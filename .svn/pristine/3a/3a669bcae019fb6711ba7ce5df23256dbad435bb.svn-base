package com.bul.zydex.validator.location;

import com.bul.zydex.model.VisitorVisitedLocation;
import org.springframework.validation.Errors;
import org.springframework.validation.Validator;

/**
 *
 * @author BlackBull
 */
public class VisitorVisitedLocationValidator implements Validator{

    @Override
    public boolean supports(Class<?> clazz) {
        return VisitorVisitedLocation.class.equals(clazz);
    }
 
    @Override
    public void validate(Object target, Errors errors) {
    }
    
    
    
}
