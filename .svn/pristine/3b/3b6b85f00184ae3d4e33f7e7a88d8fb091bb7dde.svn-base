package com.bul.zydex.controller.location;

import com.bul.zydex.controller.CustomAbstract;
import com.bul.zydex.model.VisitorVisitedLocation;
import org.springframework.validation.Validator;
import com.bul.zydex.service.location.VisitorVisitedLocationService;

/**
 *
 * @author BlackBull
 */
public class VisitorVisitedLocationAbstract extends CustomAbstract{
    
    protected Validator visitorVisitedLocationValidator;
    protected VisitorVisitedLocationService<VisitorVisitedLocation> visitorVisitedLocationService;

    public Validator getVisitorVisitedLocationValidator() {
        return visitorVisitedLocationValidator;
    }

    public void setVisitorVisitedLocationValidator(Validator visitorVisitedLocationValidator) {
        this.visitorVisitedLocationValidator = visitorVisitedLocationValidator;
    }

    public VisitorVisitedLocationService<VisitorVisitedLocation> getVisitorVisitedLocationService() {
        return visitorVisitedLocationService;
    }

    public void setVisitorVisitedLocationService(VisitorVisitedLocationService<VisitorVisitedLocation> visitorVisitedLocationService) {
        this.visitorVisitedLocationService = visitorVisitedLocationService;
    }
    
}
