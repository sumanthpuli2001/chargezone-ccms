package com.bul.zydex.util;

/**
 * 
 * @author Er. Jayesh Prajapati < Jayesh at www.bulwarks.com >
 */
public enum ActionType {

	CREATE("Create"), UPDATE("Update"), READ("Read"), DELETE("Delete"), DOWNLOAD(
			"Download"), VIEW("View"), LOGIN("Login"), LOGOUT("Logout"), AUTHORIZE(
			"Authorize"), REVIEWER("Reviewer");

	private final String text;

	/**
	 * @param text
	 */
	private ActionType(final String text) {
		this.text = text;
	}

	/*
	 * (non-Javadoc)
	 * 
	 * @see java.lang.Enum#toString()
	 */
	@Override
	public String toString() {
		return text;
	}
}
