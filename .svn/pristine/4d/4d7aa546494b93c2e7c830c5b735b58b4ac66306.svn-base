/**
 *
 * @author admin
 */
public class LocationMasterAbstract extends CustomAbstract {

    protected Validator locationMasterValidator;
    protected LocationMasterService<LocationMaster> locationMasterService;

    public Validator getLocationMasterValidator() {
        return locationMasterValidator;
    }

    public void setLocationMasterValidator(Validator locationMasterValidator) {
        this.locationMasterValidator = locationMasterValidator;
    }

    public LocationMasterService<LocationMaster> getLocationMasterService() {
        return locationMasterService;
    }

    public void setLocationMasterService(LocationMasterService<LocationMaster> locationMasterService) {
        this.locationMasterService = locationMasterService;
    }
}
