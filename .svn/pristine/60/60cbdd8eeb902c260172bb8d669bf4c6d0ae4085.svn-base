package com.bul.zydex.util;

/**
 *
 * @author Irfan
 */
public class CallingCounter {

    private int count;

    public CallingCounter(final int counts) {
        count = counts;
    }

    public int getCounter() {
        return count;
    }

    public void increment() {
        count++;
    }

}
