                                        <div class="box-body no-padding">
                                            <div class="row">
                                                <div class="col-md-12 col-sm-12">
                                                    <!--                                                    <div id="fill1" class=" col-sm-12" align="right">
                                                                                                            <input type="button" class="btn btn-primary" value="Fill Data" style="width: 100px;" onclick="fillData();">
                                                                                                        </div>-->
                                                    <br/>
                                                    <br/>
                                                    <div class="table-responsive">
                                                        <table id="demo_1" class="table table-bordered table-striped table-hover" style="" align="Center"  >

                                                            <tr id="cell1">
                                                                <th style="text-align: left">Summary Reconciliation</th>
                                                                    <c:forEach var="expenseReconsilationList" items="${expenseReconsilationList}">
                                                                    <th style="text-align: center">${expenseReconsilationList[0]}</th>
                                                                    </c:forEach>

                                                            </tr>
                                                            <tr id="cell2">
                                                                <td style="vertical-align: middle">Expense in this Report</td>
                                                                <c:forEach var="expenseReconsilationList" items="${expenseReconsilationList}">
                                                                    <td><input type="text"  class="form-control" value="${expenseReconsilationList[1]}" readonly=""/></td>
                                                                    </c:forEach>
                                                            </tr>
                                                            <tr id="cell3">
                                                                <td style="vertical-align: middle">Expense paid by Company</td>
                                                                <c:forEach var="expenseReconsilationList" items="${expenseReconsilationList}">
                                                                    <td><input type="text"  class="form-control" value="${expenseReconsilationList[2]}" readonly=""/></td>
                                                                    </c:forEach>
                                                            </tr>
                                                            <tr id="cell4">
                                                                <td style="vertical-align: middle">Cash Advance</td>
                                                                <c:forEach var="expenseReconsilationList" items="${expenseReconsilationList}">
                                                                    <td><input type="text"  class="form-control" value="${expenseReconsilationList[3]}" readonly=""/></td>
                                                                    </c:forEach>
                                                            </tr>
                                                            <tr id="cell5">
                                                                <td style="vertical-align: middle">Cash Returned</td>
                                                                <c:forEach var="expenseReconsilationList" items="${expenseReconsilationList}">
                                                                    <td><input type="text"  class="form-control" value="${expenseReconsilationList[4]}" readonly=""/></td>
                                                                    </c:forEach>
                                                            </tr>
                                                            <tr id="cell6">
                                                                <td style="vertical-align: middle">Variance Owed to Employee</td>
                                                                <c:forEach var="expenseReconsilationList" items="${expenseReconsilationList}">
                                                                    <td><input type="text"  class="form-control" value="${expenseReconsilationList[5]}" readonly=""/></td>
                                                                    </c:forEach>
                                                            </tr>
                                                            <input type='hidden' id='count11' name='count11' value='0'>
                                                            <input type='hidden' id='count12' name='count12' value='0'>


                                                        </table>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!--Reason In Detail completes Here-->
                                    <div class="form-group">
                                        <div class="col-sm-12" style="text-align: center;">
                                            <input type="button" class="btn btn-primary" name="btnType"  value="Back" style="width: 100px" onclick="window.history.back()">
