                                                                                    <!--<span><input type="checkbox" name="otherListCheck" value="$/{policyOtherList.id}" <//c:if test="$/{policyOtherList.status eq 1 }">checked="true"<//c:if>/></span>-->
                                                                                </td>
                                                                            </tr>
                                                                    </c:forEach>
                                                                </c:when>
                                                                <c:otherwise>
                                                                </c:otherwise>
                                                            </c:choose>

                                                        </table>
                                                    </div>

                                                </div>


                                                <div class="col-md-12 col-sm-12">
                                                    <div class="table-responsive">
                                                        <table id="demo3" class="table table-bordered table-striped table-hover" style="display: none" align="Center"  >
                                                            <tr>
                                                                <th style="text-align: center; vertical-align: middle;width: 5%">Sr.No.</th>
                                                                <th style="text-align: center; vertical-align: middle">Invoice/Bill Date</th>
                                                                <th style="text-align: center; vertical-align: middle">Invoice/Bill No.</th>
                                                                <th style="text-align: center; vertical-align: middle">Amount</th>
                                                                <th style="text-align: center; vertical-align: middle">Currency</th>
                                                                <th style="text-align: center; vertical-align: middle;width: 6%">Approve</th>
                                                                <!--<th style="text-align: center; vertical-align: middle;width: 7%">Add New</th>-->
                                                                <!--<input type="hidden" name="othersCount" id="othersCount" value="1"/>-->
                                                            </tr>
                                                            <c:choose>
                                                                <c:when test="${not empty othersList}">
                                                                    <c:forEach var="otherList1" items="${othersList}" varStatus="countVal">
                                                                        <input type="hidden" name="othersCount" id="othersCount" value="${fn:length(othersList)}"/>
                                                                        <input type="hidden" name="otherListId${countVal.count}" id="otherListId${countVal.count}" value="${otherList1.id}"/>
                                                                        <tr>
                                                                            <td style="text-align: center">${countVal.count}</td>
                                                                            <td style="width: 20%">
                                                                                <input class="form-control" name="billDate${countVal.count}" size="16" type="text" value="${otherList1.billDate}" readonly="true">
                                                                            </td>
                                                                            <td><input type="text" name="billNo${countVal.count}" class="form-control" value="${otherList1.bilNo}" readonly="true"></td>
                                                                            <td><input type="number" name="policyAmount${countVal.count}" class="form-control" value="${otherList1.amount}" readonly="true"></td>
                                                                            <td><div>
                                                                                    <select id="currencyOtherDiv1" name="otherCurrency${countVal.count}" class="form-control" disabled="true">
                                                                                        <c:forEach var="currency" items="${currencyMap}">
                                                                                            <c:choose>
                                                                                                <c:when test="${otherList1.currency == currency.key}">
                                                                                                    <option value="${currency.key}" selected="selected">${currency.value}</option>
                                                                                                </c:when>
                                                                                                <c:otherwise>
                                                                                                    <option value="${currency.key}" >${currency.value}</option>
                                                                                                </c:otherwise>
                                                                                            </c:choose>
                                                                                        </c:forEach>
                                                                                    </select>
                                                                                </div></td>
                                                                            <td style="text-align: center">
                                                                                <c:if test="${otherList1.status eq 1 }"><span class="glyphicon glyphicon-ok" style="font-size: 20px; color: green;"></span></c:if>
                                                                                <!--<span><input type="checkbox" name="otherListCheck"  value="${otherList1.id}"<c:if test="${otherList1.status eq 1 }">checked="true"</c:if>/></span>-->
                                                                                </td>
                                                                            </tr>
                                                                    </c:forEach>
                                                                </c:when>
                                                                <c:otherwise>
                                                                </c:otherwise>
                                                            </c:choose>

                                                        </table>
                                                    </div>

                                                </div>
