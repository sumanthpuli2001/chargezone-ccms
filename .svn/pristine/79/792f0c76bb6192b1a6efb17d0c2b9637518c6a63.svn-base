
/* Custom chart styling */
.jOrgChart {
    margin                : 10px;
    padding               : 20px;
}

/* Custom node styling */
.jOrgChart .node {
    font-size 			: 14px;
    background-color 	: #35363B;
    border-radius 		: 38px;
    border 				: 0px solid #CCCCCC;
    color 				: #F38630;
    -moz-border-radius 	: 0px;
}
.node p{
    font-family 	: tahoma;
    font-size 		: 10px;
    line-height 	: 11px;
    padding 		: 2px;
}