    public ModelAndView viewResultCEOSide(HttpServletRequest request, HttpServletResponse response) throws Exception {
        ModelAndView mv = new ModelAndView();
        TravelRequestMaster travelRequestMaster = new TravelRequestMaster();
        EmployeeMaster employeeMaster = new EmployeeMaster();
        EmployeeMaster employeeMaster1 = new EmployeeMaster();
        TravelDetail travelDetail = new TravelDetail();
        HotelAccommodation hotelAccommodation = new HotelAccommodation();
        UserMaster userMaster = new UserMaster();
        String id = request.getParameter("id");
        travelRequestMaster.setId(Integer.parseInt(id));
        String userId = request.getParameter("empId");
        employeeMaster = employeeMasterService.readById(Integer.parseInt(userId));
        int reportingId = 0;
        List<?> empDetailList = employeeMasterService.readEmployeeDetailUserIdWise(employeeMaster);
        if (!empDetailList.isEmpty()) {
            request.setAttribute("employeeMaster", empDetailList.get(0));

            Object[] arrayOfObject = (Object[]) empDetailList.get(0);
            String reportmanager = (String) arrayOfObject[6];
            if (!reportmanager.equals("")) {
                reportingId = Integer.parseInt(reportmanager);
            }

            employeeMaster1.setId(reportingId);
        }
        List<?> reportmanager1 = employeeMasterService.readByReportManager(employeeMaster1);
        if (!reportmanager1.isEmpty()) {
            employeeMaster1 = (EmployeeMaster) reportmanager1.get(0);
            request.setAttribute("reportingManager", employeeMaster1.getEmployeeName());
        }

        travelRequestMaster = travelRequestMasterService.readById(Integer.parseInt(id));
        travelDetail.setTravelRequestMaster(travelRequestMaster);
        List<?> travelDetailList = travelDetailService.readTravelDetail(travelDetail);

        hotelAccommodation.setTravelRequestMaster(travelRequestMaster);
        List<?> accommodationList = hotelAccommodationService.readAccommodationDetail(hotelAccommodation);
        readcurrencyList(request);
        request.setAttribute("accommodationList", accommodationList);
        request.setAttribute("travelDetailList", travelDetailList);
        request.setAttribute("empid", userId);

        mv.getModelMap().put("travelRequestMaster", travelRequestMaster);
        mv.setViewName("Travel/TravelRequestFinalApprove");
        return mv;
    }

    public ModelAndView approveCEO(HttpServletRequest request, HttpServletResponse response) throws Exception {
        ModelAndView mv = new ModelAndView();
        TravelRequestMaster travelRequestMaster = new TravelRequestMaster();
        String id = request.getParameter("id");
        String CEORemark = request.getParameter("adminRemark");
        String btnSubmit = request.getParameter("btnSubmit");
        travelRequestMaster = travelRequestMasterService.readById(Integer.parseInt(id));
        EmployeeMaster employeeMaster1 = new EmployeeMaster();
        employeeMaster1 = employeeMasterService.readById(travelRequestMaster.getEmployeeMasterByEmployeeMasterId().getId());
        HttpSession session = request.getSession();
        EmployeeMaster employeeMaster = (EmployeeMaster) session.getAttribute("employeeInfo");
        SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy HH:mm");
        String requestdate = sdf.format(new Date());
        TravelApproverHistory travelApproverHistory = new TravelApproverHistory();
        travelApproverHistory.setTravelRequestMaster(travelRequestMaster);

        travelApproverHistory.setEmployeeMasterByEmployeeMasterId(employeeMaster1);
        travelApproverHistory.setEmployeeMasterByTravelApproverId(employeeMaster);
        travelApproverHistory.setTravelApproveHistoryDate(requestdate);
        travelApproverHistory.setTravelApproverRemark(CEORemark);
        travelApproverHistory.setReturnFlag(0);

        if (btnSubmit.equals("approve")) {
            travelRequestMaster.setAdminRemark(CEORemark);
            travelRequestMaster.setEmployeeMasterByApprover2Id(employeeMaster);
            travelRequestMaster.setStatus(5);
            travelRequestMasterService.update(travelRequestMaster);

            travelApproverHistory.setTravelApproveStatus(5);
            travelApproverHistoryService.create(travelApproverHistory);

            request.setAttribute("successMessage",
                    "Information : The Travel Request Approved successfully.");
//            Send to Employee
            try {

                EmployeeMaster employeemastermodel = (EmployeeMaster) request.getSession().getAttribute("employeeInfo");
                DesignationMaster designationMaster = new DesignationMaster();
                designationMaster = designationMasterService.readById(employeemastermodel.getDesignationMaster().getId());
                EmailTemplate emailTemplate = new EmailTemplate();
                emailTemplate = emailTemplateService.readById(125);
                //id=125 for travel request approve by CEO..
                EmployeeMaster employeeMaster2 = new EmployeeMaster();
                String empStr = request.getParameter("empid");
                if (null != empStr && !"".equals(empStr)) {
                    int empID = Integer.parseInt(empStr);
//                    List list = employeeMasterService.readByEmployeeNo(empID);
                    employeeMaster2 = employeeMasterService.readById(empID);

//                    if (list != null) {
//                        employeeMaster2 = (EmployeeMaster) list.get(0);
                    String To = employeeMaster2.getOfficeEmailId();
                    String from = employeemastermodel.getOfficeEmailId();
                    String subject = emailTemplate.getSubject();
                    subject = subject.replaceAll("\\{user\\}", employeeMaster2.getEmployeeName());
                    String msg = emailTemplate.getBodytext();
                    msg = msg.replaceAll("\\{to_user\\}", employeeMaster2.getEmployeeName());
                    msg = msg.replaceAll("\\{from_user\\}", employeemastermodel.getEmployeeName());
                    msg = msg.replaceAll("\\{from_designation\\}", designationMaster.getDesignationName());
                    sendMail.sendMail(from, To, subject, msg);

//                    }
                }

            } catch (Exception e) {
            }
//            Send To TravelAdmin
            try {

                EmployeeMaster employeemastermodel = (EmployeeMaster) request.getSession().getAttribute("employeeInfo");
                DesignationMaster designationMaster = new DesignationMaster();
                designationMaster = designationMasterService.readById(employeemastermodel.getDesignationMaster().getId());
                EmailTemplate emailTemplate = new EmailTemplate();
                emailTemplate = emailTemplateService.readById(25);
                //id=125 for travel request approve by CEO..
                EmployeeMaster employeeMaster2 = new EmployeeMaster();
                List travelAdminList = userRightMasterService.readTravelAdmin();
                Iterator itr = travelAdminList.iterator();
                while (itr.hasNext()) {
                    Object[] next = (Object[]) itr.next();
                    String userId = "" + next[0];
                    String travelId = "" + next[1];
                    employeeMaster2 = employeeMasterService.readById(Integer.parseInt(travelId));
                    String To = employeeMaster2.getOfficeEmailId();
                    String from = employeemastermodel.getOfficeEmailId();
                    String subject = emailTemplate.getSubject();
                    subject = subject.replaceAll("\\{user\\}", employeeMaster2.getEmployeeName());
                    String msg = emailTemplate.getBodytext();
                    msg = msg.replaceAll("\\{to_user\\}", employeeMaster2.getEmployeeName());
                    msg = msg.replaceAll("\\{from_user\\}", employeemastermodel.getEmployeeName());
                    msg = msg.replaceAll("\\{from_designation\\}", designationMaster.getDesignationName());
                    sendMail.sendMail(from, To, subject, msg);

                }

            } catch (Exception e) {
            }

        } else if (btnSubmit.equals("rework")) {
            travelRequestMaster.setStatus(1);
            travelRequestMaster.setAdminRemark(CEORemark);
            travelRequestMaster.setEmployeeMasterByApprover2Id(employeeMaster);
            travelRequestMasterService.update(travelRequestMaster);

            travelApproverHistory.setTravelApproveStatus(1);
            travelApproverHistoryService.create(travelApproverHistory);
            request.setAttribute("successMessage",
                    "Information : The Travel Request Reworked successfully.");

            try {

                EmployeeMaster employeemastermodel = (EmployeeMaster) request.getSession().getAttribute("employeeInfo");
                DesignationMaster designationMaster = new DesignationMaster();
                designationMaster = designationMasterService.readById(employeemastermodel.getDesignationMaster().getId());
                EmailTemplate emailTemplate = new EmailTemplate();
                //id=126 for travel request rework by CEO...
                emailTemplate = emailTemplateService.readById(126);
                EmployeeMaster employeeMaster2 = new EmployeeMaster();
                String empStr = request.getParameter("empid");
                if (null != empStr && !"".equals(empStr)) {
                    int empID = Integer.parseInt(empStr);
//                    List list = employeeMasterService.readByEmployeeNo(empID);

                    employeeMaster2 = employeeMasterService.readById(empID);
                    String To = employeeMaster2.getOfficeEmailId();
                    String from = employeemastermodel.getOfficeEmailId();
                    String subject = emailTemplate.getSubject();
                    subject = subject.replaceAll("\\{user\\}", employeeMaster2.getEmployeeName());
                    String msg = emailTemplate.getBodytext();
                    msg = msg.replaceAll("\\{to_user\\}", employeeMaster2.getEmployeeName());
                    msg = msg.replaceAll("\\{from_user\\}", employeemastermodel.getEmployeeName());
                    msg = msg.replaceAll("\\{from_designation\\}", designationMaster.getDesignationName());
                    sendMail.sendMail(from, To, subject, msg);

                }

            } catch (Exception e) {
            }

        }
        mv = requestResultCEO(request, response);
        return mv;
    }

    public void getTravelDatesAjax(HttpServletRequest request, HttpServletResponse response) throws Exception {
        String travelNo = request.getParameter("travelNo");
        TravelRequestMaster travelRequestMaster = new TravelRequestMaster();
        if (!travelNo.equals("")) {

            travelRequestMaster = travelRequestMasterService.readById(Integer.parseInt(travelNo));
        }
        PrintWriter out = response.getWriter();
        out.print(travelRequestMaster.getStartDateTime() + "~" + travelRequestMaster.getEndDateTime() + "~" + travelRequestMaster.getTravelType());

    }

    public ModelAndView exportToExcelTravel(HttpServletRequest request, HttpServletResponse response, EmployeeMaster employeeMaster) throws Exception {
        ModelAndView mv = new ModelAndView();
        List<?> travelRequestList = (List<?>) request.getSession().getAttribute("travelRequestList");
        response.setContentType("application/vnd.ms-excel");
        response.setHeader("Content-Disposition", "attachment; filename=TravelRequestData.xls");
        mv.addObject("travelRequestList", travelRequestList);
        mv.setViewName("Travel/TravelRequestExcelData");
        return mv;
    }

    public ModelAndView exportToPdfTravelReport(HttpServletRequest request, HttpServletResponse response) throws Exception {
        ModelAndView mv = new ModelAndView();
        TravelRequestMaster travelRequestMaster = new TravelRequestMaster();
        TravelDetail travelDetail = new TravelDetail();
        HotelAccommodation hotelAccommodation = new HotelAccommodation();
        String id = request.getParameter("id");
        EmployeeMaster employeeMaster = new EmployeeMaster();
        EmployeeMaster employeeMaster1 = new EmployeeMaster();
        UserMaster user = (UserMaster) request.getSession().getAttribute("user");
        user.getId();
        employeeMaster.setUserMaster(user);
        String empNo = "";
        readcurrencyList(request);
        int reportingId = 0;
        List<?> empDetailList = employeeMasterService.readEmployeeDetailUserIdWise(employeeMaster);
        if (!empDetailList.isEmpty()) {
            Object[] obj = (Object[]) empDetailList.get(0);
            empNo = "" + obj[0];

            request.setAttribute("employeeMaster", empDetailList.get(0));
            Object[] arrayOfObject = (Object[]) empDetailList.get(0);
            String reportmanager = (String) arrayOfObject[6];
            if (!reportmanager.equals("")) {
                reportingId = Integer.parseInt(reportmanager);
            }

            employeeMaster1.setId(reportingId);
        }
        List<?> reportmanager1 = employeeMasterService.readByReportManager(employeeMaster1);
        if (!reportmanager1.isEmpty()) {
            employeeMaster1 = (EmployeeMaster) reportmanager1.get(0);
            request.setAttribute("reportingManager", employeeMaster1.getEmployeeName());

        }
        List<?> empId = employeeMasterService.readByUserName(employeeMaster);
        if (!empId.isEmpty()) {
            employeeMaster = (EmployeeMaster) empId.get(0);
        }
        travelRequestMaster.setEmployeeMasterByEmployeeMasterId(employeeMaster);
        travelRequestMaster = travelRequestMasterService.readById(Integer.parseInt(id));

        travelDetail.setTravelRequestMaster(travelRequestMaster);
        List<?> travelDetailList = travelDetailService.readTravelDetail(travelDetail);

        hotelAccommodation.setTravelRequestMaster(travelRequestMaster);
        List<?> accommodationList = hotelAccommodationService.readAccommodationDetail(hotelAccommodation);

        request.setAttribute("accommodationList", accommodationList);
        request.setAttribute("travelDetailList", travelDetailList);

        mv.getModelMap().put("travelRequestMaster", travelRequestMaster);
        mv.setViewName("Travel/TravelReportExportToPdf");
        return mv;
    }

