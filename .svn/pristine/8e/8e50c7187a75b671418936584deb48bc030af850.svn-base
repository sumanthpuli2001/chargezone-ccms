    public ModelAndView updateCashAdvanceSectionByAdmin(HttpServletRequest request, HttpServletResponse response) throws Exception {
        ModelAndView mv = new ModelAndView();
        TravelRequestMaster travelRequestMaster = new TravelRequestMaster();

        String travelId = request.getParameter("travelId");
        String empId = request.getParameter("empId");
        EmployeeMaster employeeMaster = new EmployeeMaster();
        EmployeeMaster employeeMaster1 = new EmployeeMaster();
        readcurrencyList(request);

        employeeMaster = employeeMasterService.readById(Integer.parseInt(empId));

        int reportingId = 0;
        List<?> empDetailList = employeeMasterService.readEmployeeDetailUserIdWise(employeeMaster);
        if (!empDetailList.isEmpty()) {
            request.setAttribute("employeeMaster", empDetailList.get(0));

            Object[] arrayOfObject = (Object[]) empDetailList.get(0);
            String reportmanager = (String) arrayOfObject[6];
            if (!reportmanager.equals("")) {
                reportingId = Integer.parseInt(reportmanager);
            }

            employeeMaster1.setId(reportingId);
        }
        List<?> reportmanager1 = employeeMasterService.readByReportManager(employeeMaster1);
        if (!reportmanager1.isEmpty()) {
            employeeMaster1 = (EmployeeMaster) reportmanager1.get(0);
            request.setAttribute("reportingManager", employeeMaster1.getEmployeeName());
        }

        travelRequestMaster = travelRequestMasterService.readById(Integer.parseInt(travelId));
        mv.getModelMap().put("travelRequestMaster", travelRequestMaster);
        mv.setViewName("Travel/TravelCashAdvanceUpdate");
        return mv;
    }

    public ModelAndView submitCashAdvanceSectionByAdmin(HttpServletRequest request, HttpServletResponse response) throws Exception {
        ModelAndView mv = new ModelAndView();
        TravelRequestMaster travelRequestMaster = new TravelRequestMaster();
        TravelRequestMaster travelRequestMaster1 = new TravelRequestMaster();
        bind(request, travelRequestMaster);
        travelRequestMaster1 = travelRequestMasterService.readById(travelRequestMaster.getId());
        travelRequestMaster1.setCashRequired(travelRequestMaster.getCashRequired());
        if (travelRequestMaster.getCashRequired().equals("No")) {
            travelRequestMaster1.setCashRequired(travelRequestMaster.getCashRequired());
            travelRequestMaster1.setAmount(Float.parseFloat("0"));
            travelRequestMaster1.setCurrency("");
        } else {
            travelRequestMaster1.setCashRequired(travelRequestMaster.getCashRequired());
            travelRequestMaster1.setAmount(travelRequestMaster.getAmount());
            travelRequestMaster1.setCurrency(travelRequestMaster.getCurrency());

        }
        travelRequestMasterService.update(travelRequestMaster1);
        request.setAttribute("successMessage",
                "Information : The Information is Saved Successfully.");
        mv.setViewName("forward:travelRequestMaster.htm?act=viewCashAdvanceSectionByAdmin");
        return mv;
    }

}
