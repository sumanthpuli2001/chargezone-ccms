    public ModelAndView applyClick(HttpServletRequest request, HttpServletResponse response) throws Exception {
        ModelAndView mv = new ModelAndView();
        TravelRequestMaster travelRequestMaster = new TravelRequestMaster();
        EmployeeMaster employeeMaster = new EmployeeMaster();
        EmployeeMaster employeeMaster1 = new EmployeeMaster();
        UserMaster user = (UserMaster) request.getSession().getAttribute("user");
        user.getId();
        employeeMaster.setUserMaster(user);
        String empNo = "";
        String empCompany = "";
        int reportingId = 0;
        List<?> empDetailList = employeeMasterService.readEmployeeDetailUserIdWise(employeeMaster);
        if (!empDetailList.isEmpty()) {
            Object[] obj = (Object[]) empDetailList.get(0);
            empNo = "" + obj[0];
            empCompany = "" + obj[7];

            request.setAttribute("employeeMaster", empDetailList.get(0));
            Object[] arrayOfObject = (Object[]) empDetailList.get(0);
            String reportmanager = (String) arrayOfObject[6];
            if (!reportmanager.equals("")) {
                reportingId = Integer.parseInt(reportmanager);
            }

            employeeMaster1.setId(reportingId);
        }
        List<?> reportmanager1 = employeeMasterService.readByReportManager(employeeMaster1);
        if (!reportmanager1.isEmpty()) {
            employeeMaster1 = (EmployeeMaster) reportmanager1.get(0);
            request.setAttribute("reportingManager", employeeMaster1.getEmployeeName());
        }

        List<?> empId = employeeMasterService.readByUserName(employeeMaster);
        if (!empId.isEmpty()) {
            employeeMaster = (EmployeeMaster) empId.get(0);
        }
        travelRequestMaster.setEmployeeMasterByEmployeeMasterId(employeeMaster);
        List<?> totalList = travelRequestMasterService.readTotalRequest(travelRequestMaster);
        if (!totalList.isEmpty()) {

        }
        int count = totalList.size() + 1;
        Calendar now = Calendar.getInstance();

        String[] monthName = {"January", "February",
            "March", "April", "May", "June", "July",
            "August", "September", "October", "November",
            "December"};
        int year = now.get(Calendar.YEAR);
        readcurrencyList(request);
//        int month = now.get(Calendar.MONTH) + 1;
        String name = monthName[now.get(Calendar.MONTH)];
        if ((empCompany.equals("Zydex Industries") || empCompany.equalsIgnoreCase("ZydexIndustries")) && !empCompany.equals("")) {
            empCompany = "ZI";
        } else {
            empCompany = "ZIPL";
        }

        String requestNo = empCompany + "/" + year + "/" + name + "/" + empNo + "/" + count + "";
        request.setAttribute("requestNo", requestNo);
        mv.getModelMap().put("travelRequestMaster", travelRequestMaster);
        mv.setViewName("Travel/TravelRequestForm");
//        mv.setViewName("Travel/DateTimePickerTravel");
        return mv;

    }

    public ModelAndView applySubmit(HttpServletRequest request, HttpServletResponse response) throws Exception {
        ModelAndView mv = new ModelAndView();
        TravelRequestMaster travelRequestMaster = new TravelRequestMaster();
        TravelDetail travelDetail = new TravelDetail();
        HotelAccommodation hotelAccommodation = new HotelAccommodation();
        EmployeeMaster employeeMaster = new EmployeeMaster();
        EmployeeMaster employeeMaster1 = new EmployeeMaster();
        EmployeeMaster employeeMaster2 = new EmployeeMaster();
        UserMaster user = (UserMaster) request.getSession().getAttribute("user");
        user.getId();
        employeeMaster.setUserMaster(user);
        List<?> empId = employeeMasterService.readByUserName(employeeMaster);
        if (!empId.isEmpty()) {
            employeeMaster = (EmployeeMaster) empId.get(0);
        }
        travelRequestMaster.setEmployeeMasterByEmployeeMasterId(employeeMaster);
//        String reportingManager1 = employeeMaster.getReportingManagerLevel1();
//
//        String reportingManager2 = employeeMaster.getReportingManagerLevel2();
//        if (null != reportingManager1) {
//
//            employeeMaster1.setId(Integer.parseInt(reportingManager1));
//        }
//        if (null != reportingManager2) {
//            employeeMaster2.setId(Integer.parseInt(reportingManager2));
//        }
//        travelRequestMaster.s
//        travelRequestMaster.setEmployeeMasterByApprover1Id(employeeMaster1);
//        travelRequestMaster.setEmployeeMasterByApprover2Id(employeeMaster2);

        SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy");
//        Calendar cal = Calendar.getInstance();
        Date date11 = new Date();
//        sdf.format(date11);
        String dd = sdf.format(date11);
        travelRequestMaster.setDateOfSubmit(dd);

        BindException errors = new BindException(travelRequestMaster, "travelRequestMaster");
        bind(request, travelRequestMaster);
        String cashRequiredId = request.getParameter("cashRequiredId");
        String interCurrency = request.getParameter("interCurrency");
        travelRequestMaster.setCashRequired(cashRequiredId);
        travelRequestMaster.setCurrency(interCurrency);
        travelRequestMasterValidator.validate(travelRequestMaster, errors);
        if (errors.hasErrors()) {
            request.setAttribute("failureMessage",
                    "Error : The Entered Information is not valid.");
            mv.addAllObjects(errors.getModel());
//            List<?> empDetailList = employeeMasterService.readEmployeeDetailUserIdWise(employeeMaster);
//            if (!empDetailList.isEmpty()) {
//
//                request.setAttribute("employeeMaster", empDetailList.get(0));
//            }
            int reportingId = 0;
            List<?> empDetailList = employeeMasterService.readEmployeeDetailUserIdWise(employeeMaster);
            if (!empDetailList.isEmpty()) {
                request.setAttribute("employeeMaster", empDetailList.get(0));
                Object[] arrayOfObject = (Object[]) empDetailList.get(0);
                String reportmanager = (String) arrayOfObject[6];
                if (!reportmanager.equals("")) {
                    reportingId = Integer.parseInt(reportmanager);
                }

                employeeMaster1.setId(reportingId);
            }
            List<?> reportmanager1 = employeeMasterService.readByReportManager(employeeMaster1);
            if (!reportmanager1.isEmpty()) {
                employeeMaster1 = (EmployeeMaster) reportmanager1.get(0);
                request.setAttribute("reportingManager", employeeMaster1.getEmployeeName());
            }
            mv.getModelMap().put("travelRequestMaster", travelRequestMaster);
            mv.setViewName("Travel/TravelRequestForm");

        } else {
            if (!travelRequestMaster.getTravelType().contains("Local")) {

                Date startDate = sdf.parse(travelRequestMaster.getStartDateTime());
                Date endDate = sdf.parse(travelRequestMaster.getEndDateTime());
                if (!startDate.after(endDate)) {
                    boolean flag = false;
                    TravelRequestMaster travelRequestMaster1 = new TravelRequestMaster();
                    travelRequestMaster1.setEmployeeMasterByEmployeeMasterId(employeeMaster);
                    List<?> l1 = travelRequestMasterService.readTravelEmployeePastRequest(travelRequestMaster1);
                    for (Object o1 : l1) {
                        try {

                            travelRequestMaster1 = (TravelRequestMaster) o1;
                            Date pastSDate = sdf.parse(travelRequestMaster1.getStartDateTime());
                            Date pastEDate = sdf.parse(travelRequestMaster1.getEndDateTime());
                            if (startDate.equals(pastSDate) || (startDate.after(pastSDate) && startDate.before(pastEDate)) || (endDate.after(pastSDate) && endDate.before(pastEDate)) || (endDate.equals(pastEDate))) {
                                flag = true;
                                break;
                            } else {
                                flag = false;
                            }
                        } catch (Exception e) {

                        }

                    }
                    if (flag) {

                        request.setAttribute("failureMessage",
                                "Error : You can't Apply Request on Same Day..");
                        mv = applyClick(request, response);

                    } else {
//                    travelRequestMaster.setStatus(11); // Go to Travel Admin
                        travelRequestMasterService.create(travelRequestMaster);

                        // For Emailtemplate
                        try {
                            EmailTemplate emailTemplate = new EmailTemplate();
                            EmployeeMaster employeeMasterModel = (EmployeeMaster) request.getSession().getAttribute("employeeInfo");
                            DesignationMaster designationMaster = new DesignationMaster();
                            designationMaster = designationMasterService.readById(employeeMasterModel.getDesignationMaster().getId());
                            EmployeeMaster employeeMasterHr = new EmployeeMaster();
                            employeeMasterHr = employeeMasterService.readById(Integer.parseInt(employeeMasterModel.getReportingManagerLevel1()));
                            // id 24 is apply status
                            emailTemplate = emailTemplateService.readById(24);
                            String To = employeeMasterHr.getOfficeEmailId();
                            String from = employeeMasterModel.getOfficeEmailId();
                            String Subject = emailTemplate.getSubject();
                            Subject = Subject.replaceAll("\\{user\\}", employeeMasterModel.getEmployeeName());
                            String msg = emailTemplate.getBodytext();
                            msg = msg.replaceAll("\\{to_user\\}", employeeMasterHr.getEmployeeName());
                            msg = msg.replaceAll("\\{from_user\\}", employeeMasterModel.getEmployeeName());
                            msg = msg.replaceAll("\\{from_designation\\}", designationMaster.getDesignationName());
                            sendMail.sendMail(from, To, Subject, msg);
                        } catch (Exception e) {
                        }

//                        mv.setViewName("redirect:leaveEmployeeDetail.htm?act=searchOwnLeaveDetail");
                        travelDetail.setTravelRequestMaster(travelRequestMaster);
                        hotelAccommodation.setTravelRequestMaster(travelRequestMaster);
                        int countId = Integer.parseInt(request.getParameter("countId"));
                        int countDetailId = Integer.parseInt(request.getParameter("countDetailId"));
                        for (int i = 1; i <= countId; i++) {

                            String date = request.getParameter("date" + i);
                            String fromLocation = request.getParameter("fromLocation" + i);
                            String toLocation = request.getParameter("toLocation" + i);
                            String travelModeId = request.getParameter("travelModeId" + i);
                            String policyDeviation = request.getParameter("deviateId" + i);
                            String comments = request.getParameter("comments" + i);
                            if (!"".equals(date) && null != date && !"".equals(fromLocation) && null != fromLocation && !"".equals(toLocation) && null != toLocation && !"".equals(travelModeId) && null != travelModeId) {
                                travelDetail.setDate(date);
                                travelDetail.setFromLocation(fromLocation);
                                travelDetail.setToLocation(toLocation);
                                travelDetail.setModeOfTravel(travelModeId);
                                travelDetail.setPolicyDeviation(policyDeviation);
                                travelDetail.setComments(comments);
                                travelDetailService.create(travelDetail);
                            } else {
                                request.setAttribute("failureMessage",
                                        "Error : Please Enter the Valid Data.");
                            }

                        }
                        for (int j = 1; j <= countDetailId; j++) {
                            String location = request.getParameter("location" + j);
                            String checkInDate = request.getParameter("checkInDate" + j);
//                String pickUpCheckBoxId = request.getParameter("pickUpCheckBoxId" + j);
                            String pickUpId = request.getParameter("pickUpId" + j);
                            String preferredHotel = request.getParameter("preferredHotel" + j);
                            String hotelBookingRequired = request.getParameter("hotelBookingRequired" + j);
                            String checkOutDate = request.getParameter("checkOutDate" + j);
//                String dropCheckBoxId = request.getParameter("dropCheckBoxId" + j);
                            String dropId = request.getParameter("dropId" + j);
                            String remark = request.getParameter("remark" + j);

                            hotelAccommodation.setLocation(location);
                            hotelAccommodation.setCheckInDate(checkInDate);
//                if (pickUpCheckBoxId.equals("on")) {
//
//                    hotelAccommodation.setPickUpCheck(true);
//                } else {
//                    hotelAccommodation.setPickUpCheck(false);
//
//                }
                            hotelAccommodation.setPickLocation(pickUpId);
                            hotelAccommodation.setPreferredHotel(preferredHotel);
                            hotelAccommodation.setHotelBookingRequired(hotelBookingRequired);
                            hotelAccommodation.setCheckOutDate(checkOutDate);
//                if (dropCheckBoxId.equals("on")) {
//
//                    hotelAccommodation.setDropCheck(true);
//                } else {
//                    hotelAccommodation.setDropCheck(false);
//
//                }
                            hotelAccommodation.setDropLocation(dropId);
                            hotelAccommodation.setComments(remark);
                            hotelAccommodationService.create(hotelAccommodation);

                        }
                        request.setAttribute("successMessage",
                                "Information : The Information is Saved Successfully.");
                        mv = requestResult(request, response);
                    }

                } else {
                    request.setAttribute("failureMessage",
                            "Error : Please Insert Start Date Before End Date.");
                    mv = applyClick(request, response);
                }
            } else {
                travelRequestMasterService.create(travelRequestMaster);

                try {
                    EmailTemplate emailTemplate = new EmailTemplate();
                    EmployeeMaster employeeMasterModel = (EmployeeMaster) request.getSession().getAttribute("employeeInfo");
                    DesignationMaster designationMaster = new DesignationMaster();
                    designationMaster = designationMasterService.readById(employeeMasterModel.getDesignationMaster().getId());
                    EmployeeMaster employeeMasterHr = new EmployeeMaster();
                    employeeMasterHr = employeeMasterService.readById(Integer.parseInt(employeeMasterModel.getReportingManagerLevel1()));
                    // id 24 is apply status
                    emailTemplate = emailTemplateService.readById(24);
                    String To = employeeMasterHr.getOfficeEmailId();
                    String from = employeeMasterModel.getOfficeEmailId();
                    String Subject = emailTemplate.getSubject();
                    Subject = Subject.replaceAll("\\{user\\}", employeeMasterModel.getEmployeeName());
                    String msg = emailTemplate.getBodytext();
                    msg = msg.replaceAll("\\{to_user\\}", employeeMasterHr.getEmployeeName());
                    msg = msg.replaceAll("\\{from_user\\}", employeeMasterModel.getEmployeeName());
                    msg = msg.replaceAll("\\{from_designation\\}", designationMaster.getDesignationName());
                    sendMail.sendMail(from, To, Subject, msg);
                } catch (Exception e) {
                }

                request.setAttribute("successMessage",
                        "Information : The Information is Saved Successfully.");
                mv = requestResult(request, response);

            }
        }
//                mv = applyClick(request, response);
//        mv.setViewName("Travel/TravelRequestForm");
        return mv;

    }

    public ModelAndView requestResult(HttpServletRequest request, HttpServletResponse response) throws Exception {
        ModelAndView mv = new ModelAndView();
        TravelRequestMaster travelRequestMaster = new TravelRequestMaster();
        TravelRequestMaster travelRequestMaster1 = new TravelRequestMaster();
        EmployeeMaster employeeMaster = new EmployeeMaster();
        UserMaster user = (UserMaster) request.getSession().getAttribute("user");
        user.getId();
        employeeMaster.setUserMaster(user);
        List<?> resultList = new ArrayList();
        List<List<?>> resultList1 = new LinkedList<List<?>>();
        List<?> empId = employeeMasterService.readByUserName(employeeMaster);
        if (!empId.isEmpty()) {
            employeeMaster = (EmployeeMaster) empId.get(0);
        }
        travelRequestMaster.setEmployeeMasterByEmployeeMasterId(employeeMaster);
        List<List<String>> finalList = new LinkedList<List<String>>();

        List<String> approverList = null;
        //Internationl
        List<String> approverInternationalList = new ArrayList<String>();
        if (!approverInternationalList.contains(employeeMaster.getReportingManagerLevel1())) {
            approverInternationalList.add(employeeMaster.getReportingManagerLevel1());
        }
        if (!approverInternationalList.contains(employeeMaster.getReportingManagerLevel2())) {
            approverInternationalList.add(employeeMaster.getReportingManagerLevel2());
        }
        if (!approverInternationalList.contains(employeeMaster.getReportingManagerLevel3())) {
            approverInternationalList.add(employeeMaster.getReportingManagerLevel3());
        }
        if (!approverInternationalList.contains(employeeMaster.getReportingManagerLevel4())) {
            approverInternationalList.add(employeeMaster.getReportingManagerLevel4());
        }
        if (!approverInternationalList.contains(employeeMaster.getReportingManagerLevel5())) {
            approverInternationalList.add(employeeMaster.getReportingManagerLevel5());
        }
        if (!approverInternationalList.contains(employeeMaster.getReportingManagerLevel6())) {
            approverInternationalList.add(employeeMaster.getReportingManagerLevel6());
        }

//        Set<String> internationalSet = new HashSet<String>(approverInternationalList);
//Domestic
        List<String> approverDomesticList = new ArrayList<String>();
        if (!approverDomesticList.contains(employeeMaster.getReportingManagerLevel1()) && (!employeeMaster.getReportingManagerLevel1().equals("") || null != employeeMaster.getReportingManagerLevel1())) {
            approverDomesticList.add(employeeMaster.getReportingManagerLevel1());
        }
        if (!approverDomesticList.contains(employeeMaster.getReportingManagerLevel2()) && (!employeeMaster.getReportingManagerLevel2().equals("") || null != employeeMaster.getReportingManagerLevel2())
                && !employeeMaster.getReportingManagerLevel2().equals(employeeMaster.getReportingManagerLevel6())) {
            approverDomesticList.add(employeeMaster.getReportingManagerLevel2());
        }
        if (!approverDomesticList.contains(employeeMaster.getReportingManagerLevel3()) && (!employeeMaster.getReportingManagerLevel3().equals("") || null != employeeMaster.getReportingManagerLevel3())
                && !employeeMaster.getReportingManagerLevel3().equals(employeeMaster.getReportingManagerLevel6())) {
            approverDomesticList.add(employeeMaster.getReportingManagerLevel3());
        }
        if (!approverDomesticList.contains(employeeMaster.getReportingManagerLevel4()) && (!employeeMaster.getReportingManagerLevel4().equals("") || null != employeeMaster.getReportingManagerLevel4())
                && !employeeMaster.getReportingManagerLevel4().equals(employeeMaster.getReportingManagerLevel6())) {
            approverDomesticList.add(employeeMaster.getReportingManagerLevel4());
        }
        if (!approverDomesticList.contains(employeeMaster.getReportingManagerLevel5()) && (!employeeMaster.getReportingManagerLevel5().equals("") || null != employeeMaster.getReportingManagerLevel5())
                && !employeeMaster.getReportingManagerLevel5().equals(employeeMaster.getReportingManagerLevel6())) {
            approverDomesticList.add(employeeMaster.getReportingManagerLevel5());
        }
//        approverDomesticList.add(employeeMaster.getReportingManagerLevel6());
//        Set<String> domesticSet = new HashSet<String>(approverDomesticList);

        String flag1 = "";
        Object flag = request.getAttribute("flag");
        if (flag != null) {
            flag1 = flag.toString();
        }
        if (flag1.equals("1")) {
            resultList = (List<?>) request.getAttribute("list");
        } else {
            resultList = travelRequestMasterService.requestDetail(travelRequestMaster);
        }
        TravelApproverHistory travelApproverHistory = new TravelApproverHistory();
        if (!resultList.isEmpty()) {
            for (Object empId1 : resultList) {
                List templist = new LinkedList();
                String pattern = "";
                List<List<?>> fialList = new LinkedList<List<?>>();
                List<Object> actualList = new ArrayList();

                Object[] obj = (Object[]) empId1;
                String travelId = "" + obj[5];
                String travelType = "" + obj[0];

                templist.add("" + obj[0]);
                templist.add("" + obj[1]);
                templist.add("" + obj[2]);
                templist.add("" + obj[3]);
                templist.add("" + obj[4]);
                templist.add("" + obj[5]);
                templist.add("" + obj[6]);
                templist.add("" + obj[7]);
                templist.add("" + obj[8]);
                travelRequestMaster1.setId(Integer.parseInt(travelId));
                travelApproverHistory.setTravelRequestMaster(travelRequestMaster1);
                if (travelType.equals("Domestic") || travelType.equals("Local")) {
                    approverList = new ArrayList<String>(approverDomesticList);
                } else {
                    approverList = new ArrayList<String>(approverInternationalList);

                }

                int pass = 0;
                for (String appoverObj : approverList) {

                    EmployeeMaster employeeMaster1 = new EmployeeMaster();
                    if (!appoverObj.equals("")) {

                        employeeMaster1.setId(Integer.parseInt(appoverObj));
                        travelApproverHistory.setEmployeeMasterByTravelApproverId(employeeMaster1);

                        List<?> statusList = travelApproverHistoryService.readApproverStatusList(travelApproverHistory);

                        if (!statusList.isEmpty()) {
                            Object[] oo = (Object[]) statusList.get(0);

                            if (pass == 0) {
                                pattern += oo[1] + "_" + oo[2] + "_" + oo[3] + "";
                            } else {
                                pattern += "~" + oo[1] + "_" + oo[2] + "_" + oo[3] + "";
                            }
                        } else {
                            EmployeeMaster employeeMaster2 = new EmployeeMaster();
                            employeeMaster2 = employeeMasterService.readById(Integer.parseInt(appoverObj));
                            if (pass == 0) {
                                pattern += employeeMaster2.getEmployeeName() + "_Pending_ ";
                            } else {
                                pattern += "~ " + employeeMaster2.getEmployeeName() + "_Pending_ ";
                            }
                        }
                    }
                    pass++;
                }
                templist.add(pattern);
                finalList.add(templist);
            }

        }

        request.setAttribute("resultList", finalList);
        mv.getModelMap().put("employeeMaster", employeeMaster);
        mv.getModelMap().put("travelRequestMaster", travelRequestMaster);
        mv.setViewName("Travel/TravelRequestResult");
        return mv;

    }

    public ModelAndView viewRequest(HttpServletRequest request, HttpServletResponse response) throws Exception {
        ModelAndView mv = new ModelAndView();
        TravelRequestMaster travelRequestMaster = new TravelRequestMaster();
        TravelDetail travelDetail = new TravelDetail();
        HotelAccommodation hotelAccommodation = new HotelAccommodation();
        String id = request.getParameter("id");
        EmployeeMaster employeeMaster = new EmployeeMaster();
        EmployeeMaster employeeMaster1 = new EmployeeMaster();
        UserMaster user = (UserMaster) request.getSession().getAttribute("user");
        user.getId();
        employeeMaster.setUserMaster(user);
        String empNo = "";
        readcurrencyList(request);
        int reportingId = 0;
        List<?> empDetailList = employeeMasterService.readEmployeeDetailUserIdWise(employeeMaster);
        if (!empDetailList.isEmpty()) {
            Object[] obj = (Object[]) empDetailList.get(0);
            empNo = "" + obj[0];

            request.setAttribute("employeeMaster", empDetailList.get(0));
            Object[] arrayOfObject = (Object[]) empDetailList.get(0);
            String reportmanager = (String) arrayOfObject[6];
            if (!reportmanager.equals("")) {
                reportingId = Integer.parseInt(reportmanager);
            }

            employeeMaster1.setId(reportingId);
        }
        List<?> reportmanager1 = employeeMasterService.readByReportManager(employeeMaster1);
        if (!reportmanager1.isEmpty()) {
            employeeMaster1 = (EmployeeMaster) reportmanager1.get(0);
            request.setAttribute("reportingManager", employeeMaster1.getEmployeeName());

        }
        List<?> empId = employeeMasterService.readByUserName(employeeMaster);
        if (!empId.isEmpty()) {
            employeeMaster = (EmployeeMaster) empId.get(0);
        }
        travelRequestMaster.setEmployeeMasterByEmployeeMasterId(employeeMaster);
        travelRequestMaster = travelRequestMasterService.readById(Integer.parseInt(id));

        travelDetail.setTravelRequestMaster(travelRequestMaster);
        List<?> travelDetailList = travelDetailService.readTravelDetail(travelDetail);

        hotelAccommodation.setTravelRequestMaster(travelRequestMaster);
        List<?> accommodationList = hotelAccommodationService.readAccommodationDetail(hotelAccommodation);

        request.setAttribute("accommodationList", accommodationList);
        request.setAttribute("travelDetailList", travelDetailList);
        request.setAttribute("travelId", id);
        mv.getModelMap().put("travelRequestMaster", travelRequestMaster);
        mv.setViewName("Travel/TravelRequestEdit");
        return mv;

    }

    public ModelAndView editRequest(HttpServletRequest request, HttpServletResponse response) throws Exception {
        ModelAndView mv = new ModelAndView();
        TravelRequestMaster travelRequestMaster = new TravelRequestMaster();
        TravelDetail travelDetail = new TravelDetail();
        HotelAccommodation hotelAccommodation = new HotelAccommodation();
        EmployeeMaster employeeMaster = new EmployeeMaster();
        EmployeeMaster employeeMaster1 = new EmployeeMaster();
        EmployeeMaster employeeMaster2 = new EmployeeMaster();
        UserMaster user = (UserMaster) request.getSession().getAttribute("user");
        user.getId();
        employeeMaster.setUserMaster(user);
        List<?> empId = employeeMasterService.readByUserName(employeeMaster);
        if (!empId.isEmpty()) {
            employeeMaster = (EmployeeMaster) empId.get(0);
        }
        travelRequestMaster.setEmployeeMasterByEmployeeMasterId(employeeMaster);
//        travelRequestMaster.setEmployeeMasterByEmployeeMasterId(employeeMaster);
//        String reportingManager1 = employeeMaster.getReportingManagerLevel1();
//        String reportingManager2 = employeeMaster.getReportingManagerLevel2();
//        employeeMaster1.setId(Integer.parseInt(reportingManager1));
//        employeeMaster2.setId(Integer.parseInt(reportingManager2));
//        travelRequestMaster.s
//        travelRequestMaster.setEmployeeMasterByApprover1Id(employeeMaster1);
//        travelRequestMaster.setEmployeeMasterByApprover2Id(employeeMaster2);
        String id = request.getParameter("id");
        travelRequestMaster.setId(Integer.parseInt(id));
        BindException errors = new BindException(travelRequestMaster, "travelRequestMaster");
        bind(request, travelRequestMaster);
        String cashRequiredId = request.getParameter("cashRequiredId");
        String interCurrency = request.getParameter("interCurrency");
        travelRequestMaster.setCashRequired(cashRequiredId);
        travelRequestMaster.setCurrency(interCurrency);
        String btnSubmit = request.getParameter("btnSubmit");
        if (btnSubmit.equals("submit")) {

            travelRequestMasterValidator.validate(travelRequestMaster, errors);
            if (errors.hasErrors()) {
                request.setAttribute("failureMessage",
                        "Error : The Entered Information is not valid.");
                mv.addAllObjects(errors.getModel());
                mv.getModelMap().put("travelRequestMaster", travelRequestMaster);
                mv.setViewName("Travel/TravelRequestEdit");

            } else {
                if (travelRequestMaster.getStatus() == 1) {
                    // Rework Submit
                    travelRequestMaster.setStatus(10);
                    SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy");
                    String requestdate = sdf.format(new Date());
                    travelRequestMaster.setDateOfSubmit(requestdate);
                    TravelApproverHistory travelApproverHistory = new TravelApproverHistory();
                    travelApproverHistory.setTravelRequestMaster(travelRequestMaster);
                    List list = travelApproverHistoryService.readSameTravelId(travelApproverHistory);
                    // Set all return flag 1
                    for (Object o : list) {
                        travelApproverHistory = (TravelApproverHistory) o;
                        travelApproverHistory.setReturnFlag(1);
                        travelApproverHistoryService.update(travelApproverHistory);
                    }
                } else {
                    travelRequestMaster.setStatus(0);
                }
                travelRequestMasterService.update(travelRequestMaster);
                travelDetail.setTravelRequestMaster(travelRequestMaster);
                hotelAccommodation.setTravelRequestMaster(travelRequestMaster);
                int countId = Integer.parseInt(request.getParameter("countId"));
                int countDetailId = Integer.parseInt(request.getParameter("countDetailId"));
                for (int i = 1; i <= countId; i++) {

                    String travelDetailId = request.getParameter("travelDetailId_" + i);
                    String date = request.getParameter("date" + i);
                    String fromLocation = request.getParameter("fromLocation" + i);
                    String toLocation = request.getParameter("toLocation" + i);
                    String travelModeId = request.getParameter("travelModeId" + i);
                    String policyDeviation = request.getParameter("deviateId" + i);
                    String comments = request.getParameter("comments" + i);

                    travelDetail.setDate(date);
                    travelDetail.setFromLocation(fromLocation);
                    travelDetail.setToLocation(toLocation);
                    travelDetail.setModeOfTravel(travelModeId);
                    travelDetail.setPolicyDeviation(policyDeviation);
                    travelDetail.setComments(comments);
                    if (null != travelDetailId) {
                        travelDetail.setId(Integer.parseInt(travelDetailId));
                        travelDetailService.update(travelDetail);
                    } else {
                        travelDetailService.create(travelDetail);

                    }

                }
                for (int j = 1; j <= countDetailId; j++) {

                    String accommodationId = request.getParameter("accommodationId_" + j);
                    String location = request.getParameter("location" + j);
                    String checkInDate = request.getParameter("checkInDate" + j);
//                String pickUpCheckBoxId = request.getParameter("pickUpCheckBoxId_" + j);
                    String pickUpId = request.getParameter("pickUpId" + j);
                    String preferredHotel = request.getParameter("preferredHotel" + j);
                    String hotelBookingRequired = request.getParameter("hotelBookingRequired" + j);
                    String checkOutDate = request.getParameter("checkOutDate" + j);
//                String dropCheckBoxId = request.getParameter("dropCheckBoxId_" + j);
                    String dropId = request.getParameter("dropId" + j);
                    String remark = request.getParameter("remark" + j);

                    hotelAccommodation.setLocation(location);
                    hotelAccommodation.setCheckInDate(checkInDate);
//                if (pickUpCheckBoxId.equals("on")) {
//
//                    hotelAccommodation.setPickUpCheck(true);
//                } else {
//                    hotelAccommodation.setPickUpCheck(false);
//
//                }
                    hotelAccommodation.setPickLocation(pickUpId);
                    hotelAccommodation.setPreferredHotel(preferredHotel);
                    hotelAccommodation.setHotelBookingRequired(hotelBookingRequired);
                    hotelAccommodation.setCheckOutDate(checkOutDate);
//                if (dropCheckBoxId.equals("on")) {
//
//                    hotelAccommodation.setDropCheck(true);
//                } else {
//                    hotelAccommodation.setDropCheck(false);
//
//                }
                    hotelAccommodation.setDropLocation(dropId);
                    hotelAccommodation.setComments(remark);
                    if (!accommodationId.equals("null")) {
                        hotelAccommodation.setId(Integer.parseInt(accommodationId));
                        hotelAccommodationService.update(hotelAccommodation);
                    } else {
                        hotelAccommodationService.create(hotelAccommodation);
                    }

                }
                request.setAttribute("successMessage",
                        "Information : The Information is Updated Successfully.");
                try {
                    EmailTemplate emailTemplate = new EmailTemplate();
                    EmployeeMaster employeeMasterModel = (EmployeeMaster) request.getSession().getAttribute("employeeInfo");
                    DesignationMaster designationMaster = new DesignationMaster();
                    designationMaster = designationMasterService.readById(employeeMasterModel.getDesignationMaster().getId());
                    EmployeeMaster employeeMasterHr = new EmployeeMaster();
                    employeeMasterHr = employeeMasterService.readById(Integer.parseInt(employeeMasterModel.getReportingManagerLevel1()));
                    // id 122 is for travel request edit click...
                    emailTemplate = emailTemplateService.readById(122);
                    String To = employeeMasterHr.getOfficeEmailId();
                    String from = employeeMasterModel.getOfficeEmailId();
                    String Subject = emailTemplate.getSubject();
                    Subject = Subject.replaceAll("\\{user\\}", employeeMasterModel.getEmployeeName());
                    String msg = emailTemplate.getBodytext();
                    msg = msg.replaceAll("\\{to_user\\}", employeeMasterHr.getEmployeeName());
                    msg = msg.replaceAll("\\{from_user\\}", employeeMasterModel.getEmployeeName());
                    msg = msg.replaceAll("\\{from_designation\\}", designationMaster.getDesignationName());
                    sendMail.sendMail(from, To, Subject, msg);
                } catch (Exception e) {
                }
                mv = requestResult(request, response);
            }
        } else if (btnSubmit.equals("Withdraw")) {
            if (travelRequestMaster.getStatus() == 0 || travelRequestMaster.getStatus() == 1) {

                if (travelRequestMaster.getStatus() == 1) {

                    TravelApproverHistory travelApproverHistory = new TravelApproverHistory();
                    travelRequestMaster.setId(Integer.parseInt(id));
                    travelApproverHistory.setTravelRequestMaster(travelRequestMaster);
                    List travelHistory = travelApproverHistoryService.readSameTravelId(travelApproverHistory);

                    for (Object o : travelHistory) {
                        travelApproverHistory = (TravelApproverHistory) o;
                        travelApproverHistoryService.delete(travelApproverHistory.getId());
                    }
                }
                travelRequestMasterService.delete(Integer.parseInt(id));
                mv = requestResult(request, response);
            } else if (travelRequestMaster.getStatus() == 3 || travelRequestMaster.getStatus() == 10) {
                travelRequestMaster.setStatus(4);
                travelRequestMasterService.update(travelRequestMaster);
                request.setAttribute("successMessage",
                        "Information : The Request for Withdraw a Travel is sent Successfully.");
//                mv = viewRequest(request, response);
                try {
                    EmailTemplate emailTemplate = new EmailTemplate();
                    EmployeeMaster employeeMasterModel = (EmployeeMaster) request.getSession().getAttribute("employeeInfo");
                    DesignationMaster designationMaster = new DesignationMaster();
                    designationMaster = designationMasterService.readById(employeeMasterModel.getDesignationMaster().getId());
                    EmployeeMaster employeeMasterHr = new EmployeeMaster();
                    employeeMasterHr = employeeMasterService.readById(Integer.parseInt(employeeMasterModel.getReportingManagerLevel1()));
                    // id 28 is for travel request withdraw...
                    emailTemplate = emailTemplateService.readById(28);
                    String To = employeeMasterHr.getOfficeEmailId();
                    String from = employeeMasterModel.getOfficeEmailId();
                    String Subject = emailTemplate.getSubject();
                    Subject = Subject.replaceAll("\\{user\\}", employeeMasterModel.getEmployeeName());
                    String msg = emailTemplate.getBodytext();
                    msg = msg.replaceAll("\\{to_user\\}", employeeMasterHr.getEmployeeName());
                    msg = msg.replaceAll("\\{from_user\\}", employeeMasterModel.getEmployeeName());
                    msg = msg.replaceAll("\\{from_designation\\}", designationMaster.getDesignationName());
                    sendMail.sendMail(from, To, Subject, msg);
                } catch (Exception e) {
                }

                mv = requestResult(request, response);
            }

        }

        return mv;

    }

    public ModelAndView deleteSubmit(HttpServletRequest request, HttpServletResponse response) throws Exception {
        ModelAndView mv = new ModelAndView();
        TravelRequestMaster travelRequestMaster = new TravelRequestMaster();
        String checkId[] = request.getParameterValues("checkId");
        for (String xx : checkId) {
            try {
                travelRequestMasterService.delete(Integer.parseInt(xx));
                request.setAttribute("successMessage",
                        "Info : One or more records are deleted successfully.");
            } catch (Exception e) {
                request.setAttribute("failureMessage",
                        "Error : One or more records are Already deleted.");

            }
        }
        mv = requestResult(request, response);
        return mv;
    }

