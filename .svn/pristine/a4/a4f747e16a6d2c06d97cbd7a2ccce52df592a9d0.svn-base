<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
<class name="com.bul.zydex.model.AppraisalkraActivity" table="appraisal_kra_activity" catalog="employee_cafe">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="appraisalPerformanceMaster" class="com.bul.zydex.model.AppraisalPerformanceMaster" fetch="select">
            <column name="appraisal_performance_id" not-null="true" />
        </many-to-one>
        <property name="kraDeletedDate" type="string">
            <column name="kra_deleted_date" length="45" />
        </property>
        <property name="deletedKra" type="string">
            <column name="deleted_kra" />
        </property>
        <property name="deletedMetric" type="string">
            <column name="deleted_metric" />
        </property>
         <property name="deletedWeightage" type="string">
            <column name="deleted_weightage" length="45" />
        </property>
         <property name="deletedBy" type="string">
            <column name="deleted_by" length="65" />
        </property>
         <property name="status" type="string">
            <column name="status" length="45" />
        </property>
    </class>
  

</hibernate-mapping>
