package com.bul.zydex.dao.shift;

import com.bul.zydex.dao.GenericsDAOImpl;
import com.bul.zydex.model.EmployeeShiftData;
import java.text.Format;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.List;
import org.hibernate.Query;

/**
 *
 * @author Dhaval Patel
 */
public class EmployeeShiftDataDAOImpl<T> extends GenericsDAOImpl<T> implements EmployeeShiftDataDAO<T> {

    @Override
    protected Class getDomainClass() {
        return EmployeeShiftData.class;
    }

    @Override
    public List<?> dailyTimeEntry(T object) {
        EmployeeShiftData employeeShiftData = (EmployeeShiftData) object;
        String query = "";
        Date date = new Date();
        Date dateBefore = new Date(date.getTime() - 24 * 60 * 60 * 1000);
        Format formatter = new SimpleDateFormat("dd/MM/YYYY");
        String s = formatter.format(date);
//        String s = "04/04/2016";

        String s1 = formatter.format(dateBefore);

        query += " From EmployeeShiftData a "
                + " Where a.employeeMaster.id = '" + employeeShiftData.getEmployeeMaster().getId() + "'"
                + "and STR_TO_DATE(a.inDateTime,'%d/%m/%Y') = STR_TO_DATE('" + s + "','%d/%m/%Y')";
//                + "and STR_TO_DATE(a.inDateTime,'%d/%m/%Y') IN (STR_TO_DATE('" + s + "','%d/%m/%Y'),STR_TO_DATE('" + s1 + "','%d/%m/%Y'))";

        return getHibernateTemplate().find(query);
    }

    @Override
    public List<?> attendanceRegularizationEntry(T object) {
        EmployeeShiftData employeeShiftData = (EmployeeShiftData) object;
        String query = "";
        query += " From EmployeeShiftData a "
                + " Where a.employeeMaster.id = '" + employeeShiftData.getEmployeeMaster().getId() + "'"
                + "and STR_TO_DATE(a.inDateTime,'%d/%m/%Y') = STR_TO_DATE('" + employeeShiftData.getInDateTime() + "','%d/%m/%Y')";

        return getHibernateTemplate().find(query);
    }

    @Override
    public List<?> todaysData() {
        String query = "";
        Date date = new Date();
        Format formatter = new SimpleDateFormat("dd/MM/YYYY");
        String s = formatter.format(date);
        query += " From EmployeeShiftData a "
                + "Where STR_TO_DATE(a.inDateTime,'%d/%m/%Y') = STR_TO_DATE('" + s + "','%d/%m/%Y')";

        return getHibernateTemplate().find(query);
    }

    @Override
    public List<?> poolcarApproiveAttendenceRegularization(T object) {
        EmployeeShiftData employeeShiftData = (EmployeeShiftData) object;
        String query = "";
        query += " From EmployeeShiftData a "
                + " Where a.employeeMaster.id = '" + employeeShiftData.getEmployeeMaster().getId() + "'"
                //                + "and STR_TO_DATE(a.inDateTime,'%d/%m/%Y') IN (STR_TO_DATE('" + employeeShiftData.getInDateTime() + "','%d/%m/%Y')),"
                //                + " STR_TO_DATE(STR_TO_DATE('" + employeeShiftData.getOutDateTime() + "','%d/%m/%Y')";
                + "and STR_TO_DATE(a.inDateTime,'%d/%m/%Y') IN (STR_TO_DATE('" + employeeShiftData.getEmployeeMaster().getId() + "','%d/%m/%Y'),STR_TO_DATE('" + employeeShiftData.getOutDateTime() + "','%d/%m/%Y'))";

        return getHibernateTemplate().find(query);
    }

    @Override
    public List<?> empOrDateWiseSearch(T object) {
        EmployeeShiftData employeeShiftData = (EmployeeShiftData) object;
        String query = "";

        String condition = "";

        if (null != employeeShiftData.getId()) {
            condition += "b.id = " + employeeShiftData.getId();
        }
        if (null != employeeShiftData.getInDateTime() && !"".equals(employeeShiftData.getInDateTime())) {
//            condition += " and  a.inDateTime = '" + employeeShiftData.getInDateTime() + "' ";
            condition += " and a.inDateTime BETWEEN '" + employeeShiftData.getInDateTime() + "' AND '" + employeeShiftData.getOutDateTime() + "' ";
        }
        if (null != employeeShiftData.getOutDateTime() && !"".equals(employeeShiftData.getOutDateTime())) {
//            condition += " and  a.outDateTime = '" + employeeShiftData.getOutDateTime() + "' ";
            condition += " and a.outDateTime BETWEEN '" + employeeShiftData.getInDateTime() + "' AND '" + employeeShiftData.getOutDateTime() + "' ";
        }
        if (condition == "") {
            query += " Select b.employeeId, a.inDateTime, a.outDateTime "
                    + " From EmployeeShiftData a "
                    + " LEFT JOIN a.employeeMaster b ";

        } else {

            query = "select"
                    + "     DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),'%d/%m/%Y') As selecteddate ,"
                    + "    case"
                    + "        when"
                    + "            (select"
                    + "                    a.in_date_time"
                    + "                from"
                    + "                    employee_shift_data a"
                    + "                where"
                    + "                    a.employee_master_id = " + employeeShiftData.getId() + " and DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                            '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                            '%d/%m/%Y')"
                    + "                limit 1) is not null"
                    + "        then"
                    + "            case"
                    + "                when"
                    + "                    (select"
                    + "                            '1' as fullDay"
                    + "                        from"
                    + "                            employee_shift_data a,"
                    + "                            shift_master sm"
                    + "                        where"
                    + "                            a.shift_master_id = sm.id and a.employee_master_id = " + employeeShiftData.getId() + " and DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') and (((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time1, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time1, '%H:%i'),"
                    + "                                    '%H:%i'))) and ((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time2, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time2, '%H:%i'),"
                    + "                                    '%H:%i'))))"
                    + "                        limit 1) is not null"
                    + "                then"
                    + "                    (select"
                    + "                            concat('1',"
                    + "                                        ' ` ',"
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),"
                    + "                                        ' ! ', "
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),' @ ',"
                    + "                                        'fullday',' # ',sm.shift_name,' $ ',"
                    + "                                sm.late_hours,"
                    + "                                ' % ',"
                    + "                                sm.half_end_time1,"
                    + "                                ' ^ ',"
                    + "                                sm.half_start_time2,"
                    + "                                ' & ',"
                    + "                                sm.half_end_time2) as fullDay"
                    + "                        from"
                    + "                            employee_shift_data a,"
                    + "                            shift_master sm"
                    + "                        where"
                    + "                            a.shift_master_id = sm.id and a.employee_master_id = " + employeeShiftData.getId() + " and DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') and (((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time1, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time1, '%H:%i'),"
                    + "                                    '%H:%i'))) and ((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time2, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time2, '%H:%i'),"
                    + "                                    '%H:%i'))))"
                    + "                        limit 1)"
                    + "                when"
                    + "                    (select"
                    + "                            '0.5' as leaveDay"
                    + "                        from"
                    + "                            employee_shift_data a,"
                    + "                            shift_master sm,"
                    + "                            leave_employee_detail c"
                    + "                        where"
                    + "                            a.employee_master_id = c.employee_master_id "
                    + "                            and a.shift_master_id = sm.id and c.status = 3 and a.employee_master_id = " + employeeShiftData.getId() + " "
                    + "                            and STR_TO_DATE(a.in_date_time, '%d/%m/%Y') = "
                    + "                            STR_TO_DATE(selected_date, '%Y-%m-%d') and "
                    + "                            ((DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(c.start_date, '%d/%m/%Y'),"
                    + "                                    '%d/%m/%Y')) or (DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') =  DATE_FORMAT(STR_TO_DATE(c.end_date, '%d/%m/%Y'),"
                    + "                                    '%d/%m/%Y')))"
                    + "                        limit 1) is not null"
                    + "                then"
                    + "                    (select"
                    + "                            concat('0.5',"
                    + "                                        ' ` ',"
                    + "                                         DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),"
                    + "                                        ' ! ', "
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),"
                    + "                                        ' @ ',"
                    + "                                        (select a.leave_type from leave_type_master a where a.id=c.leave_type_id),' # ',sm.shift_name,' $ ',"
                    + "                                sm.late_hours,"
                    + "                                ' % ',"
                    + "                                sm.half_end_time1,"
                    + "                                ' ^ ',"
                    + "                                sm.half_start_time2,"
                    + "                                ' & ',"
                    + "                                sm.half_end_time2,"
                    + "                                ' * ',DATE_FORMAT(STR_TO_DATE(c.start_date, '%d/%m/%Y - %H:%i'),'%H:%i'),"
                    + "                                 ' - ',DATE_FORMAT(STR_TO_DATE(c.end_date, '%d/%m/%Y - %H:%i'),'%H:%i'),"
                    + "                                 ' + ',sm.half_start_time1) as leaveDay"
                    + "                        from"
                    + "                            employee_shift_data a,"
                    + "                            shift_master sm,"
                    + "                            leave_employee_detail c"
                    + "                        where"
                    + "                            a.employee_master_id = c.employee_master_id "
                    + "                            and a.shift_master_id = sm.id and c.status = 3 and a.employee_master_id = " + employeeShiftData.getId() + " "
                    + "                            and STR_TO_DATE(a.in_date_time, '%d/%m/%Y') = "
                    + "                            STR_TO_DATE(selected_date, '%Y-%m-%d') and "
                    + "                            ((DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(c.start_date, '%d/%m/%Y'),"
                    + "                                    '%d/%m/%Y')) or (DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') =  DATE_FORMAT(STR_TO_DATE(c.end_date, '%d/%m/%Y'),"
                    + "                                    '%d/%m/%Y')))"
                    + "                        limit 1)"
                    + "     when"
                    + "                     (SELECT"
                    + "                           a.start_date_time"
                    + "                         FROM"
                    + "                           attendance_regularization a,"
                    + "                         employee_master b"
                    + "                     WHERE"
                    + "                          b.id = " + employeeShiftData.getId()
                    + "                          and b.user_master_id=a.user_master_id"
                    + "                             and a.status=1"
                    + "                         AND DATE_FORMAT(STR_TO_DATE(a.start_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                         '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                          '%d/%m/%Y')"
                    + "                        limit 1)is not null "
                    + " then"
                    + " (SELECT"
                    + "                            CONCAT('0',"
                    + "                                        ' ` ',"
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                                '%H:%i'),"
                    + "                                        ' ! ',"
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                                '%H:%i'),"
                    + "                                        ' @ ',"
                    + "                                        'AR',"
                    + "                                        ' # ',"
                    + "                                        sm.shift_name,"
                    + "                                        ' $ ',"
                    + "                                        sm.late_hours,"
                    + "                                        ' % ',"
                    + "                                        sm.half_end_time1,"
                    + "                                        ' ^ ',"
                    + "                                        sm.half_start_time2,"
                    + "                                        ' & ',"
                    + "                                        sm.half_end_time2,"
                    + "                                        ' + ',"
                    + "                                        sm.half_start_time1) AS inOutPunch"
                    + "                        FROM"
                    + "                            employee_shift_data a,"
                    + "                            shift_master sm,"
                    + "                            attendance_regularization ar,"
                    + "                            employee_master em"
                    + "                        WHERE"
                    + "                            a.shift_master_id = sm.id"
                    + "                              and a.employee_master_id = " + employeeShiftData.getId()
                    + "                              and a.employee_master_id=em.id"
                    + "                                and em.user_master_id=ar.user_master_id"
                    + "                               and ar.status=1"
                    + "                                AND DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y')"
                    + "                                      AND DATE_FORMAT(STR_TO_DATE(ar.start_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') limit 1)"
                    + "                when"
                    + "                    (select"
                    + "                            concat('0.5',"
                    + "                                        ' ` ',"
                    + "                                        a.in_date_time,"
                    + "                                        ' ! ',"
                    + "                                        a.out_date_time) as halfDay"
                    + "                        from"
                    + "                            employee_shift_data a,"
                    + "                            shift_master sm"
                    + "                        where"
                    + "                            a.shift_master_id = sm.id and a.employee_master_id = " + employeeShiftData.getId() + " and DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') and (((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time1, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time1, '%H:%i'),"
                    + "                                    '%H:%i'))) or ((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time2, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time2, '%H:%i'),"
                    + "                                    '%H:%i'))))"
                    + "                        limit 1) is not null"
                    + "                then"
                    + "                    (select"
                    + "                            concat('0.5',"
                    + "                                        ' ` ',"
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),"
                    + "                                        ' ! ', "
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),' @ ',"
                    + "                                        'AB',' # ',sm.shift_name,' $ ',"
                    + "                                sm.late_hours,"
                    + "                                ' % ',"
                    + "                                sm.half_end_time1,"
                    + "                                ' ^ ',"
                    + "                                sm.half_start_time2,"
                    + "                                ' & ',"
                    + "                                sm.half_end_time2,"
                    + "                                ' + ',sm.half_start_time1) as halfDay"
                    + "                        from"
                    + "                            employee_shift_data a,"
                    + "                            shift_master sm"
                    + "                        where"
                    + "                            a.shift_master_id = sm.id and a.employee_master_id = " + employeeShiftData.getId() + " and DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') and (((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time1, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time1, '%H:%i'),"
                    + "                                    '%H:%i'))) or ((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time2, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time2, '%H:%i'),"
                    + "                                    '%H:%i'))))"
                    + "                        limit 1)"
                    + "       When"
                    + "              (SELECT"
                    + "                    a.in_date_time"
                    + "                FROM"
                    + "                    employee_shift_data a"
                    + "                WHERE"
                    + "                    a.employee_master_id = " + employeeShiftData.getId()
                    + "                        AND DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                            '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                            '%d/%m/%Y')"
                    + "                LIMIT 1) IS NOT NULL"
                    + "                THEN"
                    + "                 (SELECT"
                    + "                                      concat('0',"
                    + "                                        ' ` ',"
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),"
                    + "                                        ' ! ', "
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),' @ ',"
                    + "                                        'AB',' # ',sm.shift_name,' $ ',"
                    + "                                sm.late_hours,"
                    + "                                ' % ',"
                    + "                                sm.half_end_time1,"
                    + "                                ' ^ ',"
                    + "                                sm.half_start_time2,"
                    + "                                ' & ',"
                    + "                                sm.half_end_time2,"
                    + "                                ' + ',sm.half_start_time1) as inOutPunch"
                    + "                FROM"
                    + "                    employee_shift_data a,"
                    + "                    shift_master sm"
                    + "                WHERE"
                    + "                        a.shift_master_id = sm.id and a.employee_master_id = " + employeeShiftData.getId()
                    + "                        AND DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                            '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                            '%d/%m/%Y')"
                    + "                LIMIT 1)"
                    + "                else 'AB'"
                    + "            end"
                    + "        when"
                    + "            (select"
                    + "                    sm.weekof"
                    + "                from"
                    + "                    employee_shift_data a,"
                    + "                    shift_master sm"
                    + "                where"
                    + "                    a.employee_master_id = " + employeeShiftData.getId() + " and sm.id = a.shift_master_id and sm.weekof like CONCAT('%',"
                    + "                            DAYNAME(DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                            '%Y-%m-%d')),"
                    + "                            '%')"
                    + "                limit 1) is not null"
                    + "        then"
                    + "            (select"
                    + "                    'WO' as sunday"
                    + "                from"
                    + "                    employee_shift_data a,"
                    + "                    shift_master sm"
                    + "                where"
                    + "                    a.employee_master_id = " + employeeShiftData.getId() + " and sm.id = a.shift_master_id and sm.weekof like CONCAT('%',"
                    + "                            DAYNAME(DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                            '%Y-%m-%d')),"
                    + "                            '%')"
                    + "                limit 1)"
                    + "        when"
                    + "            (select"
                    + "                    c.start_date"
                    + "                from"
                    + "                    leave_employee_detail c"
                    + "                where"
                    + "                    c.employee_master_id = " + employeeShiftData.getId() + " "
                    + "                     and c.status = 3 and STR_TO_DATE(selected_date, '%Y-%m-%d')"
                    + "                      between STR_TO_DATE(c.start_date, '%d/%m/%Y')"
                    + "                      and STR_TO_DATE(c.end_date, '%d/%m/%Y')"
                    + "                limit 1) is not null"
                    + "        then"
                    + "            (select"
                    + "                    concat(d.leave_type)"
                    + "                from"
                    + "                    leave_employee_detail c"
                    + "                        left join"
                    + "                    leave_type_master d ON d.id = c.leave_type_id"
                    + "                where"
                    + "                    c.employee_master_id = " + employeeShiftData.getId() + ""
                    + "                    and c.status = 3 and STR_TO_DATE(selected_date, '%Y-%m-%d')"
                    + "                    between STR_TO_DATE(c.start_date, '%d/%m/%Y')"
                    + "                    and STR_TO_DATE(c.end_date, '%d/%m/%Y')"
                    + "                limit 1)"
                    + "        when"
                    + "            (select"
                    + "                    d.title"
                    + "                from"
                    + "                    holiday_master d,"
                    + "                    employee_master emp"
                    + "                where"
                    + "                    emp.id = " + employeeShiftData.getId() + " "
                    + "                 and emp.company_location = d.location_id "
                    + "                 and STR_TO_DATE(selected_date, '%Y-%m-%d')"
                    + "                 between STR_TO_DATE(d.holiday_from_date, '%d/%m/%Y')"
                    + "                 and STR_TO_DATE(d.holiday_to_date, '%d/%m/%Y')"
                    + "                 limit 1) is not null"
                    + "        then"
                    + "            (select"
                    + "                    concat(d.title,' ? ',' ho ') as holiday"
                    + "                from"
                    + "                    holiday_master d,"
                    + "                    employee_master emp"
                    + "                where"
                    + "                    emp.id = " + employeeShiftData.getId() + " "
                    + "                    and emp.company_location = d.location_id "
                    + "                    and STR_TO_DATE(selected_date, '%Y-%m-%d')"
                    + "                    between STR_TO_DATE(d.holiday_from_date, '%d/%m/%Y')"
                    + "                    and STR_TO_DATE(d.holiday_to_date, '%d/%m/%Y') "
                    + "                limit 1)"
                    + " WHEN"
                    + "                (SELECT "
                    + "                            'AR'"
                    + "                        FROM"
                    + "                            attendance_regularization a,"
                    + "                            employee_master b"
                    + "                        WHERE"
                    + "                            b.id = " + employeeShiftData.getId()
                    + "                                AND b.user_master_id = a.user_master_id"
                    + "                                AND a.status = 1"
                    + "                                AND DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') between"
                    + "                                 DATE_FORMAT(STR_TO_DATE(a.start_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%d/%m/%Y') AND   DATE_FORMAT(STR_TO_DATE(a.end_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%d/%m/%Y')"
                    + "                        LIMIT 1) IS NOT NULL"
                    + "                        "
                    + "                        THEN"
                    + "                        (SELECT "
                    + "                           'AR'"
                    + "                        FROM"
                    + "                            attendance_regularization a,"
                    + "                            employee_master b"
                    + "                        WHERE"
                    + "                            b.id = " + employeeShiftData.getId()
                    + "                                AND b.user_master_id = a.user_master_id"
                    + "                                AND a.status = 1"
                    + "                                AND DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') between"
                    + "                                 DATE_FORMAT(STR_TO_DATE(a.start_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%d/%m/%Y') AND   DATE_FORMAT(STR_TO_DATE(a.end_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%d/%m/%Y')"
                    + "                        LIMIT 1)"
                    + "  WHEN"
                    + "(SELECT 'TR'"
                    + "                       FROM"
                    + "                          travel_request_master a"
                    + "                        WHERE"
                    + "               a.employee_master_id = " + employeeShiftData.getId() + " and a.status = 5 AND DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') between DATE_FORMAT(STR_TO_DATE(a.start_date_time, '%d/%m/%Y - %H:%i:%s'),"
                    + "                                    '%d/%m/%Y') AND DATE_FORMAT(STR_TO_DATE(a.end_date_time, '%d/%m/%Y - %H:%i:%s'),"
                    + "                                    '%d/%m/%Y')"
                    + "                        limit 1) is not null"
                    + "                then"
                    + "                    (SELECT "
                    + "                            'TR'"
                    + "                        FROM"
                    + "                            travel_request_master a"
                    + "                        WHERE"
                    + "                            a.employee_master_id = " + employeeShiftData.getId() + " and a.status = 5 AND DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') between DATE_FORMAT(STR_TO_DATE(a.start_date_time, '%d/%m/%Y - %H:%i'),"
                    + "                                    '%d/%m/%Y') AND DATE_FORMAT(STR_TO_DATE(a.end_date_time, '%d/%m/%Y - %H:%i'),"
                    + "                                    '%d/%m/%Y')"
                    + "                        limit 1)"
                    + "        else 'AB'"
                    + "    end "
                    + " from"
                    + "    (select"
                    + "        adddate('1970-01-01', t4 * 10000 + t3 * 1000 + t2 * 100 + t1 * 10 + t0) selected_date"
                    + "    from"
                    + "        (select 0 t0 union select 1 union select 2 union select 3 union select 4 union select 5 union select 6 union select 7 union select 8 union select 9) t0, (select 0 t1 union select 1 union select 2 union select 3 union select 4 union select 5 union select 6 union select 7 union select 8 union select 9) t1, (select 0 t2 union select 1 union select 2 union select 3 union select 4 union select 5 union select 6 union select 7 union select 8 union select 9) t2, (select 0 t3 union select 1 union select 2 union select 3 union select 4 union select 5 union select 6 union select 7 union select 8 union select 9) t3, (select 0 t4 union select 1 union select 2 union select 3 union select 4 union select 5 union select 6 union select 7 union select 8 union select 9) t4) v"
                    + " where selected_date between '" + employeeShiftData.getInDateTime() + "' and '" + employeeShiftData.getOutDateTime() + "'";
        }
        Query query1 = getSession().createSQLQuery(query);
//        List results = query1.list();
        return query1.list();
    }

    @Override
    public List<?> empOrMonthlySearch(T object) {
        EmployeeShiftData employeeShiftData = (EmployeeShiftData) object;
        String query = "";
        String condition = "";

        if (null != employeeShiftData.getId()) {
            condition += "b.id = " + employeeShiftData.getId();
        }
        if (null != employeeShiftData.getInDateTime() && !"".equals(employeeShiftData.getInDateTime())) {
//            condition += " and  a.inDateTime = '" + employeeShiftData.getInDateTime() + "' ";
            condition += " and a.inDateTime BETWEEN '" + employeeShiftData.getInDateTime() + "' AND '" + employeeShiftData.getOutDateTime() + "' ";
        }
        if (null != employeeShiftData.getOutDateTime() && !"".equals(employeeShiftData.getOutDateTime())) {
//            condition += " and  a.outDateTime = '" + employeeShiftData.getOutDateTime() + "' ";
            condition += " and a.outDateTime BETWEEN '" + employeeShiftData.getInDateTime() + "' AND '" + employeeShiftData.getOutDateTime() + "' ";
        }
        if (condition == "") {
            query += " Select b.employeeId, a.inDateTime, a.outDateTime "
                    + " From EmployeeShiftData a "
                    + " LEFT JOIN a.employeeMaster b ";

        } else {

            query = "select"
                    + "     DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),'%d/%m/%Y') As selecteddate ,"
                    + "    case"
                    + "        when"
                    + "            (select"
                    + "                    a.in_date_time"
                    + "                from"
                    + "                    employee_shift_data a"
                    + "                where"
                    + "                    a.employee_master_id = " + employeeShiftData.getId() + " and DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                            '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                            '%d/%m/%Y')"
                    + "                limit 1) is not null"
                    + "        then"
                    + "            case"
                    + "                when"
                    + "                    (select"
                    + "                            '1' as fullDay"
                    + "                        from"
                    + "                            employee_shift_data a,"
                    + "                            shift_master sm"
                    + "                        where"
                    + "                            a.shift_master_id = sm.id and a.employee_master_id = " + employeeShiftData.getId() + " and DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') and (((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time1, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time1, '%H:%i'),"
                    + "                                    '%H:%i'))) and ((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time2, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time2, '%H:%i'),"
                    + "                                    '%H:%i'))))"
                    + "                        limit 1) is not null"
                    + "                then"
                    + "                    (select"
                    + "                            concat('1',"
                    + "                                        ' ` ',"
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),"
                    + "                                        ' ! ', "
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),' @ ',"
                    + "                                        'fullday',' # ',sm.shift_name,' $ ',"
                    + "                                sm.late_hours,"
                    + "                                ' % ',"
                    + "                                sm.half_end_time1,"
                    + "                                ' ^ ',"
                    + "                                sm.half_start_time2,"
                    + "                                ' & ',"
                    + "                                sm.half_end_time2) as fullDay"
                    + "                        from"
                    + "                            employee_shift_data a,"
                    + "                            shift_master sm"
                    + "                        where"
                    + "                            a.shift_master_id = sm.id and a.employee_master_id = " + employeeShiftData.getId() + " and DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') and (((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time1, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time1, '%H:%i'),"
                    + "                                    '%H:%i'))) and ((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time2, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time2, '%H:%i'),"
                    + "                                    '%H:%i'))))"
                    + "                        limit 1)"
                    + "                when"
                    + "                    (select"
                    + "                            '0.5' as leaveDay"
                    + "                        from"
                    + "                            employee_shift_data a,"
                    + "                            shift_master sm,"
                    + "                            leave_employee_detail c"
                    + "                        where"
                    + "                            a.employee_master_id = c.employee_master_id "
                    + "                            and a.shift_master_id = sm.id and c.status = 3 and a.employee_master_id = " + employeeShiftData.getId() + " "
                    + "                            and STR_TO_DATE(a.in_date_time, '%d/%m/%Y') = "
                    + "                            STR_TO_DATE(selected_date, '%Y-%m-%d') and "
                    + "                            ((DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(c.start_date, '%d/%m/%Y'),"
                    + "                                    '%d/%m/%Y')) or (DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') =  DATE_FORMAT(STR_TO_DATE(c.end_date, '%d/%m/%Y'),"
                    + "                                    '%d/%m/%Y')))"
                    + "                        limit 1) is not null"
                    + "                then"
                    + "                    (select"
                    + "                            concat('0.5',"
                    + "                                        ' ` ',"
                    + "                                         DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),"
                    + "                                        ' ! ', "
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),"
                    + "                                        ' @ ',"
                    + "                                        (select a.leave_type from leave_type_master a where a.id=c.leave_type_id),' # ',sm.shift_name,' $ ',"
                    + "                                sm.late_hours,"
                    + "                                ' % ',"
                    + "                                sm.half_end_time1,"
                    + "                                ' ^ ',"
                    + "                                sm.half_start_time2,"
                    + "                                ' & ',"
                    + "                                sm.half_end_time2,"
                    + "                                ' * ',DATE_FORMAT(STR_TO_DATE(c.start_date, '%d/%m/%Y - %H:%i'),'%H:%i'),"
                    + "                                 ' - ',DATE_FORMAT(STR_TO_DATE(c.end_date, '%d/%m/%Y - %H:%i'),'%H:%i'),"
                    + "                                 ' + ',sm.half_start_time1) as leaveDay"
                    + "                        from"
                    + "                            employee_shift_data a,"
                    + "                            shift_master sm,"
                    + "                            leave_employee_detail c"
                    + "                        where"
                    + "                            a.employee_master_id = c.employee_master_id "
                    + "                            and a.shift_master_id = sm.id and c.status = 3 and a.employee_master_id = " + employeeShiftData.getId() + " "
                    + "                            and STR_TO_DATE(a.in_date_time, '%d/%m/%Y') = "
                    + "                            STR_TO_DATE(selected_date, '%Y-%m-%d') and "
                    + "                            ((DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(c.start_date, '%d/%m/%Y'),"
                    + "                                    '%d/%m/%Y')) or (DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') =  DATE_FORMAT(STR_TO_DATE(c.end_date, '%d/%m/%Y'),"
                    + "                                    '%d/%m/%Y')))"
                    + "                        limit 1)"
                    + "                when"
                    + "                    (select"
                    + "                            concat('0.5',"
                    + "                                        ' ` ',"
                    + "                                        a.in_date_time,"
                    + "                                        ' ! ',"
                    + "                                        a.out_date_time) as halfDay"
                    + "                        from"
                    + "                            employee_shift_data a,"
                    + "                            shift_master sm"
                    + "                        where"
                    + "                            a.shift_master_id = sm.id and a.employee_master_id = " + employeeShiftData.getId() + " and DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') and (((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time1, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time1, '%H:%i'),"
                    + "                                    '%H:%i'))) or ((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time2, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time2, '%H:%i'),"
                    + "                                    '%H:%i'))))"
                    + "                        limit 1) is not null"
                    + "                then"
                    + "                    (select"
                    + "                            concat('0.5',"
                    + "                                        ' ` ',"
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),"
                    + "                                        ' ! ', "
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),' @ ',"
                    + "                                        'AB',' # ',sm.shift_name,' $ ',"
                    + "                                sm.late_hours,"
                    + "                                ' % ',"
                    + "                                sm.half_end_time1,"
                    + "                                ' ^ ',"
                    + "                                sm.half_start_time2,"
                    + "                                ' & ',"
                    + "                                sm.half_end_time2,"
                    + "                                ' + ',sm.half_start_time1) as halfDay"
                    + "                        from"
                    + "                            employee_shift_data a,"
                    + "                            shift_master sm"
                    + "                        where"
                    + "                            a.shift_master_id = sm.id and a.employee_master_id = " + employeeShiftData.getId() + " and DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                    '%d/%m/%Y') and (((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time1, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time1, '%H:%i'),"
                    + "                                    '%H:%i'))) or ((DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') <= DATE_FORMAT(STR_TO_DATE(sm.half_start_time2, '%H:%i'),"
                    + "                                    '%H:%i')) and (DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                                    '%H:%i') >= DATE_FORMAT(STR_TO_DATE(sm.half_end_time2, '%H:%i'),"
                    + "                                    '%H:%i'))))"
                    + "                        limit 1)"
                    + " When"
                    + "  (SELECT"
                    + "                    a.in_date_time"
                    + "                FROM"
                    + "                    employee_shift_data a"
                    + "                WHERE"
                    + "                    a.employee_master_id = " + employeeShiftData.getId()
                    + "                        AND DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                            '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                            '%d/%m/%Y')"
                    + "                LIMIT 1) IS NOT NULL"
                    + "                THEN"
                    + "                 (SELECT"
                    + "                                      concat('0',"
                    + "                                        ' ` ',"
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),"
                    + "                                        ' ! ', "
                    + "                                        DATE_FORMAT(STR_TO_DATE(a.out_date_time, '%d/%m/%Y %H:%i:%s'),'%H:%i'),' @ ',"
                    + "                                        'AB',' # ',sm.shift_name,' $ ',"
                    + "                                sm.late_hours,"
                    + "                                ' % ',"
                    + "                                sm.half_end_time1,"
                    + "                                ' ^ ',"
                    + "                                sm.half_start_time2,"
                    + "                                ' & ',"
                    + "                                sm.half_end_time2,"
                    + "                                ' + ',sm.half_start_time1) as inOutPunch"
                    + "                FROM"
                    + "                    employee_shift_data a,"
                    + "                    shift_master sm"
                    + "                WHERE"
                    + "                        a.shift_master_id = sm.id and a.employee_master_id = " + employeeShiftData.getId()
                    + "                        AND DATE_FORMAT(STR_TO_DATE(a.in_date_time, '%d/%m/%Y %H:%i:%s'),"
                    + "                            '%d/%m/%Y') = DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                            '%d/%m/%Y')"
                    + "                LIMIT 1)"
                    + "                else '-'"
                    + "            end"
                    + "        when"
                    + "            (select"
                    + "                    sm.weekof"
                    + "                from"
                    + "                    employee_shift_data a,"
                    + "                    shift_master sm"
                    + "                where"
                    + "                    a.employee_master_id = " + employeeShiftData.getId() + " and sm.id = a.shift_master_id and sm.weekof like CONCAT('%',"
                    + "                            DAYNAME(DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                            '%Y-%m-%d')),"
                    + "                            '%')"
                    + "                limit 1) is not null"
                    + "        then"
                    + "            (select"
                    + "                    'WO' as sunday"
                    + "                from"
                    + "                    employee_shift_data a,"
                    + "                    shift_master sm"
                    + "                where"
                    + "                    a.employee_master_id = " + employeeShiftData.getId() + " and sm.id = a.shift_master_id and sm.weekof like CONCAT('%',"
                    + "                            DAYNAME(DATE_FORMAT(STR_TO_DATE(selected_date, '%Y-%m-%d'),"
                    + "                                            '%Y-%m-%d')),"
                    + "                            '%')"
                    + "                limit 1)"
                    + "        when"
                    + "            (select"
                    + "                    c.start_date"
                    + "                from"
                    + "                    leave_employee_detail c"
                    + "                where"
                    + "                    c.employee_master_id = " + employeeShiftData.getId() + " "
                    + "                     and c.status = 3 and STR_TO_DATE(selected_date, '%Y-%m-%d')"
                    + "                      between STR_TO_DATE(c.start_date, '%d/%m/%Y')"
                    + "                      and STR_TO_DATE(c.end_date, '%d/%m/%Y')"
                    + "                limit 1) is not null"
                    + "        then"
                    + "            (select"
                    + "                    concat(d.leave_type)"
                    + "                from"
                    + "                    leave_employee_detail c"
                    + "                        left join"
                    + "                    leave_type_master d ON d.id = c.leave_type_id"
                    + "                where"
                    + "                    c.employee_master_id = " + employeeShiftData.getId() + ""
                    + "                    and c.status = 3 and STR_TO_DATE(selected_date, '%Y-%m-%d')"
                    + "                    between STR_TO_DATE(c.start_date, '%d/%m/%Y')"
                    + "                    and STR_TO_DATE(c.end_date, '%d/%m/%Y')"
                    + "                limit 1)"
                    + "        when"
                    + "            (select"
                    + "                    d.title"
                    + "                from"
                    + "                    holiday_master d,"
                    + "                    employee_master emp"
                    + "                where"
                    + "                    emp.id = " + employeeShiftData.getId() + " "
                    + "                 and emp.company_location = d.location_id "
                    + "                 and STR_TO_DATE(selected_date, '%Y-%m-%d')"
                    + "                 between STR_TO_DATE(d.holiday_from_date, '%d/%m/%Y')"
                    + "                 and STR_TO_DATE(d.holiday_to_date, '%d/%m/%Y')"
                    + "                 limit 1) is not null"
                    + "        then"
                    + "            (select"
                    + "                    concat(d.title)"
                    + "                from"
                    + "                    holiday_master d,"
                    + "                    employee_master emp"
                    + "                where"
                    + "                    emp.id = " + employeeShiftData.getId() + " "
                    + "                    and emp.company_location = d.location_id "
                    + "                    and STR_TO_DATE(selected_date, '%Y-%m-%d')"
                    + "                    between STR_TO_DATE(d.holiday_from_date, '%d/%m/%Y')"
                    + "                    and STR_TO_DATE(d.holiday_to_date, '%d/%m/%Y') "
                    + "                limit 1)"
                    + "        else '-'"
                    + "    end "
                    + " from"
                    + "    (select"
                    + "        adddate('1970-01-01', t4 * 10000 + t3 * 1000 + t2 * 100 + t1 * 10 + t0) selected_date"
                    + "    from"
                    + "        (select 0 t0 union select 1 union select 2 union select 3 union select 4 union select 5 union select 6 union select 7 union select 8 union select 9) t0, (select 0 t1 union select 1 union select 2 union select 3 union select 4 union select 5 union select 6 union select 7 union select 8 union select 9) t1, (select 0 t2 union select 1 union select 2 union select 3 union select 4 union select 5 union select 6 union select 7 union select 8 union select 9) t2, (select 0 t3 union select 1 union select 2 union select 3 union select 4 union select 5 union select 6 union select 7 union select 8 union select 9) t3, (select 0 t4 union select 1 union select 2 union select 3 union select 4 union select 5 union select 6 union select 7 union select 8 union select 9) t4) v"
                    + " where selected_date between '" + employeeShiftData.getInDateTime() + "' and '" + employeeShiftData.getOutDateTime() + "'";
        }

        Query query1 = getSession().createSQLQuery(query);
        List results = query1.list();
        return query1.list();
    }

    @Override
    public List<?> getPastAndCurrentPunch(T object, String endShiftTime) {
        EmployeeShiftData employeeShiftData = (EmployeeShiftData) object;
        String query = "";
        Date date = new Date();
        Date dateBefore = new Date(date.getTime() - 24 * 60 * 60 * 1000);
        Format formatter = new SimpleDateFormat("dd/MM/YYYY");
        String s = formatter.format(date);
//        String s = "04/04/2016";
//        String s1 = "03/04/2016";
        String s1 = formatter.format(dateBefore);

        query += " From EmployeeShiftData a "
                + " Where a.employeeMaster.id = '" + employeeShiftData.getEmployeeMaster().getId() + "'"
                //                                + "and STR_TO_DATE(a.inDateTime,'%d/%m/%Y') = STR_TO_DATE('"+ s + "','%d/%m/%Y')";
                //                + "and STR_TO_DATE(a.inDateTime,'%d/%m/%Y') IN (STR_TO_DATE('" + s + "','%d/%m/%Y'),STR_TO_DATE('" + s1 + "','%d/%m/%Y'))";
                + "and STR_TO_DATE(a.inDateTime,'%d/%m/%Y %H:%i:%s') BETWEEN STR_TO_DATE('" + s1 + " " + endShiftTime + ":00','%d/%m/%Y %H:%i:%s') AND (STR_TO_DATE('" + s + " 23:59:00','%d/%m/%Y %H:%i:%s'))";

        return getHibernateTemplate().find(query);
    }

    @Override
    public List<?> checkTodayPresent(T object) {
        EmployeeShiftData employeeShiftData = (EmployeeShiftData) object;
        String query = "";
        query += " From EmployeeShiftData a "
                + "Where a.employeeMaster.id=" + employeeShiftData.getEmployeeMaster().getId()
                + " and STR_TO_DATE(a.inDateTime,'%d/%m/%Y') = STR_TO_DATE('" + employeeShiftData.getOutDateTime() + "','%d/%m/%Y')";
        return getHibernateTemplate().find(query);
    }

    @Override
    public List<?> checkTodayFirstHalfDayPresent(T object) {
        EmployeeShiftData employeeShiftData = (EmployeeShiftData) object;
        String query = "";
        query += " From EmployeeShiftData a"
                + " LEFT JOIN a.shiftMaster b"
                + " Where a.employeeMaster.id=" + employeeShiftData.getEmployeeMaster().getId()
                + " and STR_TO_DATE(a.inDateTime,'%d/%m/%Y') = STR_TO_DATE('" + employeeShiftData.getOutDateTime() + "','%d/%m/%Y')"
                + " and DATE_FORMAT(STR_TO_DATE(a.outDateTime, '%d/%m/%Y %H:%i:%s'),'%H:%i:%s') >= DATE_FORMAT(STR_TO_DATE(b.halfEndTime1, '%H:%i:%s'),'%H:%i:%s')";
        return getHibernateTemplate().find(query);
    }

    @Override
    public List<?> checkTodaySecondHalfDayPresent(T object) {
        EmployeeShiftData employeeShiftData = (EmployeeShiftData) object;
        String query = "";
        query += " From EmployeeShiftData a"
                + " LEFT JOIN a.shiftMaster b"
                + " Where a.employeeMaster.id=" + employeeShiftData.getEmployeeMaster().getId()
                + " and STR_TO_DATE(a.inDateTime,'%d/%m/%Y') = STR_TO_DATE('" + employeeShiftData.getOutDateTime() + "','%d/%m/%Y')"
                + " and DATE_FORMAT(STR_TO_DATE(a.outDateTime, '%d/%m/%Y %H:%i'),'%H:%i') > DATE_FORMAT(STR_TO_DATE(b.endTime, '%H:%i'),'%H:%i')";
        return getHibernateTemplate().find(query);
    }
}
