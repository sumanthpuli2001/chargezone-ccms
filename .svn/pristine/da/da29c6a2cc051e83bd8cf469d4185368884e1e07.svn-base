package com.bul.zydex.controller.level;

import com.bul.zydex.controller.CustomAbstract;
import com.bul.zydex.model.LevelMaster;
import com.bul.zydex.service.level.LevelMasterService;
import org.springframework.validation.Validator;

/**
 *
 * @author admin
 */
public class LevelMasterAbstract extends CustomAbstract{
    protected LevelMasterService<LevelMaster> levelMasterService;
    protected Validator levelMasterValidator;

    public LevelMasterService<LevelMaster> getLevelMasterService() {
        return levelMasterService;
    }

    public void setLevelMasterService(LevelMasterService<LevelMaster> levelMasterService) {
        this.levelMasterService = levelMasterService;
    }

    public Validator getLevelMasterValidator() {
        return levelMasterValidator;
    }

    public void setLevelMasterValidator(Validator levelMasterValidator) {
        this.levelMasterValidator = levelMasterValidator;
    }
    
    
}
