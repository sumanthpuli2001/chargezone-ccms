<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.AocFormMultiAttachmentHistory" table="aoc_form_multi_attachment_history" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="aocForm" type="java.lang.Integer">    
            <column name="aoc_form_id" length="100"  />
        </property>
               
        <property name="attachment" type="string">    
            <column name="attachment"  />
        </property>
          <property name="description" type="string">    
            <column name="description"  />
        </property>
          <property name="history" type="string">    
            <column name="history"   />
        </property>
         <property name="aocMultiId" type="java.lang.Integer">    
            <column name="aoc_multi_id"  />
        </property>
         <property name="aocHistoryId" type="java.lang.Integer">    
            <column name="aoc_history_id"  />
        </property>
    </class>
</hibernate-mapping>
