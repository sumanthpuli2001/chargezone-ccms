<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.AocLogMaster" table="aoc_log_master" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="aocId" type="java.lang.Integer">    
            <column name="aoc_id"   />
        </property>
        <property name="activity" type="string">    
            <column name="activity"   />
        </property>
         <property name="activityBy" type="string">    
            <column name="activity_by"   />
        </property>
        <property name="date" type="string">    
            <column name="date"   />
        </property>
        <property name="status" type="string">    
            <column name="status"  />
        </property>
         <property name="comments" type="string">    
            <column name="comments"  />
        </property>
          <property name="komId" type="java.lang.Integer">    
            <column name="kom_id"   />
        </property>
    </class>
  

</hibernate-mapping>
