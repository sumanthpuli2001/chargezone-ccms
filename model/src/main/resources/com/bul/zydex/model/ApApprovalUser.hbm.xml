<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.ApApprovalUser" table="ap_approval_user" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="apApprovalSetting" class="com.bul.zydex.model.ApApprovalSetting" fetch="select">
            <column name="ap_approval_setting_id"  />
        </many-to-one>
        <property name="userId" type="string">    
            <column name="user_id" length="1000"  />
        </property>
        <property name="level" type="java.lang.Integer">    
            <column name="level" length="1000"  />
        </property>
    </class>
</hibernate-mapping>
