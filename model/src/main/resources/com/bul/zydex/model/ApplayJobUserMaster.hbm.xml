<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.ApplayJobUserMaster" table="applay_job_user_master" catalog="hr_power_vnc">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="userName" type="string">
            <column name="user_name" />
        </property>
        <property name="password" type="string">
            <column name="password" />
        </property>
        <property name="createdDate" type="string">
            <column name="created_date" />
        </property>
        <property name="firstTime" type="java.lang.Integer">
            <column name="first_time" />
        </property>
        <property name="profileSubmit" type="java.lang.Integer">
            <column name="profile_submit" />
        </property>
        <property name="otp" type="string">
            <column name="otp" />
        </property>
        <property name="statusOtp" type="java.lang.Integer">
            <column name="status_otp" />
        </property>
        <property name="timeValidity" type="string">
            <column name="time_validite" />
        </property>
    </class>
</hibernate-mapping>
