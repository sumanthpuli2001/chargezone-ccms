<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.ApprovalUser" table="approval_user" catalog="hr_power_astral">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="approvalMaster" class="com.bul.zydex.model.ApprovalMaster" fetch="select">
            <column name="approvalMaster" />
        </many-to-one>
        <property name="userId" type="java.lang.Integer">
            <column name="user_id" />
        </property>
    </class>
</hibernate-mapping>
