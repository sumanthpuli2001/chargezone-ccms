<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.AuctionAttachment" table="auction_attachment" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="auctionNo" type="string">    
            <column name="auction_no" length="200"  />
        </property>
        <property name="attachmentDoc" type="string">    
            <column name="attachment_doc" length="200"  />
        </property>
        <property name="attachmentType" type="java.lang.Integer">    
            <column name="attachment_type" length="200"  />
        </property>
        <property name="rfqNo" type="string">    
            <column name="rfq_no" length="500"  />
        </property>
    </class>
  

</hibernate-mapping>
