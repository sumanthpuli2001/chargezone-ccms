<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.AuctionItemMaster" table="auction_item_master" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="auctionNo" type="string">    
            <column name="auction_no" length="200"  />
        </property>
        <property name="srNo" type="string">    
            <column name="sr_no" length="200"  />
        </property>
        <property name="itemCode" type="string">    
            <column name="item_code" length="200"  />
        </property>
        <property name="itemName" type="string">    
            <column name="item_name" length="200"  />
        </property>
        <property name="itemDesc" type="string">    
            <column name="item_desc" length="200"  />
        </property>
        <property name="itemRemark" type="string">    
            <column name="item_remark" length="200"  />
        </property>
        <property name="uom" type="string">    
            <column name="uom" length="200"  />
        </property>
        <property name="qty" type="string">    
            <column name="qty" length="200"  />
        </property>
    </class>
  

</hibernate-mapping>
