<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.AuctionPriceApproval" table="auction_price_approval" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="auctionNo" type="string">    
            <column name="auction_no" length="45"  />
        </property>
        <property name="totalApproval" type="java.lang.Integer">
            <column name="total_approval" length="10"  />
        </property>
        <property name="currentApproval" type="java.lang.Integer">
            <column name="current_approval" length="10"  />
        </property>
        <property name="approvalStatus" type="java.lang.Integer">    
            <column name="approval_status" length="10"  />
        </property>
        <property name="approvalRemark" type="string">    
            <column name="approval_remark"   />
        </property>
        <property name="userId" type="string">    
            <column name="user_id" length="45"  />
        </property>
        <property name="dateTime" type="string">    
            <column name="date_time" length="45"  />
        </property>
        
         
    </class>
  
</hibernate-mapping>
