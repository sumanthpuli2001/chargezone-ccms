<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.AuditorMaster" table="auditor_master" catalog="eprocsuite_chargezone">
        
        
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        
        
        
        <property name="auditorCode" type="string">
            <column name="auditor_code" length="500"  />
        </property>
        
        
        <property name="auditorName" type="string">
            <column name="auditor_name" length="200"  />
        </property>
        
        <property name="auditorAddress" type="string">
            <column name="auditor_address" length="200"  />
        </property>
        
           
        <property name="auditorEmail" type="string">
            <column name="auditor_email" length="200"  />
        </property>
        
        <property name="auditorMobileNo" type="string">
            <column name="auditor_mobile_no" length="200"  />
        </property>
        
        <property name="auditorStatus" type="string">
            <column name="auditor_status" length="200"  />
        </property>
        
        <property name="auditorRemark" type="string">
            <column name="auditor_remark" length="200"  />
        </property>
        
        <property name="auditorRole" type="string">
            <column name="auditor_role" length="200"  />
        </property>
        
        
        
        
        
    </class>

</hibernate-mapping>
