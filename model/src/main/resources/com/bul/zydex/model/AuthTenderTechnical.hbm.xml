<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.AuthTenderTechnical" table="auth_tender_technical" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="refNo" type="string">    
            <column name="ref_no" length="200"  />
        </property>
        <property name="remark" type="string">    
            <column name="remark" length="500"  />
        </property>
        <property name="technicalDoc" type="string">    
            <column name="technical_doc" length="500"  />
        </property>
        <property name="technicalRemark" type="string">    
            <column name="technical_remark" length="500"  />
        </property>
        <property name="termsConditionDoc" type="string">    
            <column name="terms_condition_doc" length="500"  />
        </property>
        <property name="termsConditionRemark" type="string">    
            <column name="terms_condition_remark" length="500"  />
        </property>
        <property name="document" type="string">    
            <column name="document" length="500"  />
        </property>
        <property name="documentRemark" type="string">    
            <column name="document_remark" length="500"  />
        </property>
        
    </class>
  
</hibernate-mapping>
