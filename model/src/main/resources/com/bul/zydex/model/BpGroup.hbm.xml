<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.BpGroup" table="bp_Group" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        
        <property name="bpGroupName" type="string">    
            <column name="bp_group_name" length="1000"  />
        </property>
        <property name="accountGroup" type="string">    
            <column name="account_group" length="1000"  />
        </property>
         <property name="discription" type="string">    
            <column name="description" length="1000"  />
        </property>
    </class>
</hibernate-mapping>
