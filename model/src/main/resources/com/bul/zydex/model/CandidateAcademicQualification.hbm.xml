<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.CandidateAcademicQualification" table="candidate_academic_qualification" catalog="hr_power_astral">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="increment" />
        </id>
        
        <property name="academicYearFrom" type="java.lang.Integer">
            <column name="academic_year_from" />
        </property>
        
        <property name="academicYearTo" type="java.lang.Integer">
            <column name="academic_year_to" />
        </property>
        
        <property name="academicExamination" type="string">
            <column name="academic_examination" />
        </property>
        
        <property name="academicBoard" type="string">
            <column name="academic_board" />
        </property>
        
        <property name="academicNumberOfAttempts" type="java.lang.Integer">
            <column name="academic_no_of_attempts" />
        </property>
        
        <property name="academicMarksInPercent" type="string">
            <column name="academic_marks_in_percent" />
        </property>
        
        <property name="academicClass" type="string">
            <column name="academic_class" />
        </property>
        
        <property name="academicRankOrScholarship" type="string">
            <column name="rank_or_scholarship" />
        </property>
        
        <property name="createdDate" type="string">
            <column name="created_date" />
        </property>
        
        <many-to-one name="candidateApplyJob" class="com.bul.zydex.model.CandidateApplyJob" fetch="select">
            <column name="candidate_apply_job_id" not-null="true"/>
        </many-to-one>
    </class>
</hibernate-mapping>
