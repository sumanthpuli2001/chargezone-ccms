<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="com.bul.zydex.model.CandidateApplyJob" table="candidate_apply_job" catalog="hr_power_astral">
         <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="name" type="string">
            <column name="name" />
        </property>
        <property name="fatherName" type="string">
            <column name="father_name" />
        </property>
        <property name="motherName" type="string">
            <column name="mother_name" />
        </property>
        <property name="fatherDob" type="string">
            <column name="father_dob" />
        </property>
        <property name="motherDob" type="string">
            <column name="mother_dob" />
        </property>
        <property name="sex" type="string">
            <column name="sex" />
        </property>
        <property name="martialStatus" type="string">
            <column name="martial_status" />
        </property>
        <property name="dob" type="string">
            <column name="dob" />
        </property>
        <property name="photograph" type="string">
            <column name="photograph" />
        </property>
        <property name="presentAddress" type="string">
            <column name="present_address" />
        </property>
        <property name="permanentAddress" type="string">
            <column name="permanent_address" />
        </property>
        <property name="city" type="string">
            <column name="city" />
        </property>
        <property name="bloodGroup" type="string">
            <column name="blood_group" />
        </property>
        <property name="emailId" type="string">
            <column name="email_id" />
        </property>
        <property name="contactNo" type="string">
            <column name="contact_no" />
        </property>
        <property name="emergencyContactPerson" type="string">
            <column name="emergency_contact_person" />
        </property>
        <property name="emergencyContactNo" type="string">
            <column name="emergency_contact_no" />
        </property>
        <property name="highestEducationQualification" type="string">
            <column name="highest_education_qualification" />
        </property>
        <property name="experianceDateJoiningYear" type="string">
            <column name="experiance_date_joining_year" />
        </property>
        <property name="experianceDateJoiningMonth" type="string">
            <column name="experiance_date_joining_month" />
        </property>
        <property name="certificateAttach" type="string">
            <column name="certificate_attach" />
        </property>
        <many-to-one name="vacancyId" class="com.bul.zydex.model.VacancyMaster" fetch="select">
            <column name="vacancy_id" />
        </many-to-one>
       
    </class>
</hibernate-mapping>
