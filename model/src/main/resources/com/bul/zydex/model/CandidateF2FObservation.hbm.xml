<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.CandidateF2FObservation" table="candidate_f2f_observation" catalog="hr_power_gipcl">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="candidateJobApplication" class="com.bul.zydex.model.CandidateJobApplication" fetch="select">
            <column name="candidate_job_application_id" />
        </many-to-one>
       
        <many-to-one name="vacancyMaster" class="com.bul.zydex.model.VacancyMaster" fetch="select">
            <column name="vacancy_master_id" />
        </many-to-one>
        <many-to-one name="candidateApplyJob" class="com.bul.zydex.model.CandidateApplyJob" fetch="select">
            <column name="candidate_job_apply_id" />
        </many-to-one>
        <property name="hrEmpId" type="java.lang.Integer">
            <column name="hr_emp_id" />
        </property>
       
        <property name="technicalKnowledge" type="int">
            <column name="technical_knowledge" not-null="true" />
        </property>
        <property name="experience" type="int">
            <column name="experience" not-null="true" />
        </property>
        <property name="commSkill" type="int">
            <column name="comm_skill" not-null="true" />
        </property>
        <property name="interPerSkill" type="int">
            <column name="inter_per_skill" not-null="true" />
        </property>
        <property name="leaderSkill" type="int">
            <column name="leader_skill" not-null="true" />
        </property>
        <property name="strengths" type="string">
            <column name="strengths" />
        </property>
        <property name="weaknesses" type="string">
            <column name="weaknesses" />
        </property>
        <property name="typeOfTraining" type="string">
            <column name="type_of_training" />
        </property>
        <property name="technicalareas" type="string">
            <column name="technical_areas" />
        </property>
        <property name="otherSkills" type="string">
            <column name="other_skills" />
        </property>
        <property name="excellent" type="int">
            <column name="excellent" not-null="true" />
        </property>
          <property name="comment" type="string">
            <column name="comment" />
        </property>
         <property name="hrName" type="string">
            <column name="hr_name" />
        </property>
    </class>
</hibernate-mapping>
