<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.CandidateF2FRequest" table="candidate_f2f_request" catalog="hr_power_astral">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="candidateJobApplication" class="com.bul.zydex.model.CandidateJobApplication" fetch="select">
            <column name="candidate_job_application_id" />
        </many-to-one>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        <property name="currentApproverCount" type="java.lang.Integer">
            <column name="current_approver_count" />
        </property>
        <property name="totalApproverCount" type="java.lang.Integer">
            <column name="total_approver_count" />
        </property>
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
        <property name="createdDate" type="string">
            <column name="created_date" />
        </property>
        <property name="updatedBy" type="java.lang.Integer">
            <column name="updated_by" />
        </property>
        <property name="updatedDate" type="string">
            <column name="updated_date" />
        </property>
        <property name="message" type="string">
            <column name="message" />
        </property>
        <property name="location" type="string">
            <column name="location" />
        </property>
        <property name="dateOfInterview" type="string">
            <column name="date_Of_Interview" />
        </property>
    </class>
</hibernate-mapping>
