<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.CandidateFamilyBackground" table="candidate_family_background" catalog="hr_power_astral">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="increment" />
        </id>
        
        <property name="familyMemberName" type="string">
            <column name="family_member_name" />
        </property>
        
        <property name="relationWithFamilyMember" type="string">
            <column name="relation_with_family_member" />
        </property>
        
        <property name="familyMemberAge" type="string">
            <column name="family_member_age" />
        </property>
        
        <property name="familyMemberQualification" type="string">
            <column name="family_member_qualification" />
        </property>
        
        <property name="familyMemberDesignationOccupation" type="string">
            <column name="family_member_designation_occupation" />
        </property>
        
        <property name="familyMemberMonthlyIncome" type="string">
            <column name="family_member_monthly_income" />
        </property>
        
        <property name="createdDate" type="string">
            <column name="created_date" />
        </property>
        
        <many-to-one name="candidateApplyJob" class="com.bul.zydex.model.CandidateApplyJob" fetch="select">
            <column name="candidate_apply_job_id" not-null="true"/>
        </many-to-one>
    </class>
</hibernate-mapping>
