<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.CandidateJobApplication" table="candidate_job_application" catalog="hr_power_vnc">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="candidateApplyJob" class="com.bul.zydex.model.CandidateApplyJob" fetch="select">
            <column name="candidate_apply_job_id" />
        </many-to-one>
        <many-to-one name="vacancyMaster" class="com.bul.zydex.model.VacancyMaster" fetch="select">
            <column name="vacancy_master_id" />
        </many-to-one>
        
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
        
        <property name="createdDate" type="string">
            <column name="created_date" />
        </property>
          <many-to-one name="applayJobUserMaster" class="com.bul.zydex.model.ApplayJobUserMaster" fetch="select">
            <column name="applay_job_user_master_id" />
        </many-to-one>
      
       
      
    </class>
</hibernate-mapping>
