<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.CandidateOtherReferences" table="candidate_other_references" catalog="hr_power_gipcl">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="increment" />
        </id>
        
        <property name="referenceNonRelativesName" type="string">
            <column name="reference_non_relatives_name" />
        </property>
        
        <property name="referenceNonRelativesOrganization" type="string">
            <column name="reference_non_relatives_organization" />
        </property>
        
        <property name="referenceNonRelativesPosition" type="string">
            <column name="reference_non_relatives_position" />
        </property>
        
        <property name="referenceNonRelativesContactNmber" type="string">
            <column name="reference_non_relatives_contact_no" />
        </property>
        
        <property name="createdDate" type="string">
            <column name="created_date" />
        </property>
        
        <many-to-one name="candidateApplyJob" class="com.bul.zydex.model.CandidateApplyJob" fetch="select">
            <column name="candidate_apply_job_id" not-null="true"/>
        </many-to-one>
    </class>
</hibernate-mapping>
