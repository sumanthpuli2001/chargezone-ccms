<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.Candidatef2fInterviewRating" table="candidate_f2f_interview_rating" catalog="hr_power_astral">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="candidateF2FRequest" class="com.bul.zydex.model.CandidateF2FRequest" fetch="select">
            <column name="candidate_f2f_request_id" />
        </many-to-one>
    </class>
  

</hibernate-mapping>
