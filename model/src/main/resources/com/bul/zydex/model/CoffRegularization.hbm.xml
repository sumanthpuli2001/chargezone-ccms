<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
 <class name="com.bul.zydex.model.CoffRegularization" table="coff_regularization" catalog="hr_power_vnc">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="approverId" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="approver_id" />
        </many-to-one>
        <many-to-one name="userMasterId" class="com.bul.zydex.model.UserMaster" fetch="select">
            <column name="user_master_id" />
        </many-to-one>
        
        <property name="status" type="int">
            <column name="status" />
        </property>
        <property name="approvalComment" type="string">
            <column name="approval_comment" />
        </property>
       
        <property name="startDateCoff" type="string">
            <column name="start_date_coff" />
        </property>
        <property name="endDateCoff" type="string">
            <column name="end_date_coff" />
        </property>
        <property name="dateOfApproval" type="string">
            <column name="date_of_approval" length="45" />
        </property>
        <property name="dateOfSubmit" type="string">
            <column name="date_of_submit" length="45" />
        </property>
        <property name="coffType" type="string">
            <column name="coff_type" />
        </property>
    </class>
  

</hibernate-mapping>
