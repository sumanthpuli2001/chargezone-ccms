<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.CommMaster" table="comm_master" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="vendorCode" type="string">
            <column name="vendor_code" length="500"  />
        </property>
        <property name="tenderNo" type="string">
            <column name="tender_no" length="200"  />
        </property>
        
        <property name="subject" type="string">
            <column name="subject" length="200"  />
        </property>
        <property name="msg" type="string">
            <column name="msg" length="2000"  />
        </property>
        <property name="isread" type="string">
            <column name="isread" length="200"  />
        </property>
        <property name="msgdatetime" type="string">
            <column name="msgdatetime" length="200"  />
        </property>
        <property name="userId" type="string">
            <column name="user_id" length="200"  />
        </property>
        <property name="idAdmin" type="string">
            <column name="idadmin" length="200"  />
        </property>
        <property name="isintendor" type="string">
            <column name="isintendor" length="200"  />
        </property>
    </class>

</hibernate-mapping>
