<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
     <class name="com.bul.zydex.model.ComponentMaster" table="component_master" catalog="hr_power_vnc" optimistic-lock="version">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="modules" class="com.bul.zydex.model.Modules" fetch="select">
            <column name="module_id" not-null="true" />
        </many-to-one>
        <property name="componentName" type="string">
            <column name="component_name" length="45" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
    </class>
  

</hibernate-mapping>
