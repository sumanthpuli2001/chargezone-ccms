<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.CountryCode" table="country_codes" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="countryName" type="string">    
            <column name="country_name" length="200"  />
        </property>
        <property name="countryCode" type="java.lang.Integer">    
            <column name="country_code" length="200"  />
        </property>
    </class>
  

</hibernate-mapping>
