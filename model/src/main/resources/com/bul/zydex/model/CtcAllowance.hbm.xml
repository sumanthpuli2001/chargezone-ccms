<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.CtcAllowance" table="ctc_allowance" catalog="hr_power_gipcl">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="ctcName" type="string">
            <column name="ctc_name" length="45" not-null="true" />
        </property>
         <set name="employeeCtcDetail" inverse="true">
            <key>
                <column name="ctc_master_id" />
            </key>
            <one-to-many class="com.bul.zydex.model.EmployeeCtcDetail" />
        </set>
        
    </class>
  

</hibernate-mapping>
