<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.DataTableReportMaster" table="data_table_report_master" catalog="hr_power_astral" optimistic-lock="version">
        <id name="id" type="int">
            <column name="id" />
            <generator class="assigned" />
        </id>
        <many-to-one name="componentMaster" class="com.bul.zydex.model.ComponentMaster" fetch="select">
            <column name="report_component" not-null="true" />
        </many-to-one>
        <property name="reportName" type="string">
            <column name="report_name" length="45" />
        </property>
        <property name="query" type="string">
            <column name="query" length="1000" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
        <property name="createdDate" type="string">
            <column name="created_date" length="45" />
        </property>
        <property name="updatedBy" type="java.lang.Integer">
            <column name="updated_by" />
        </property>
        <property name="updatedDate" type="string">
            <column name="updated_date" length="45" />
        </property>
    </class>
  

</hibernate-mapping>
