<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.DesignCoordinatorMultiAttach" table="design_coordinator_multi_attach" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="deliverableMultiId" type="java.lang.Integer">    
            <column name="deliverable_multi_id"   />
        </property>
        <property name="description" type="string">    
            <column name="description"   />
        </property>
        <property name="attachement" type="string">    
            <column name="attachment"   />
        </property>
        <property name="oapId" type="java.lang.Integer">    
            <column name="oap_id"   />
        </property>
        <property name="aocId" type="java.lang.Integer">    
            <column name="aoc_id"   />
        </property>
    </class>
</hibernate-mapping>
