<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.DeviceDetails" table="device_detail" catalog="eprocsuite_chargezone" optimistic-lock="version">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="deviceId" type="string">
            <column name="device_id" />
        </property>
        <property name="deviceIP" type="string">
            <column name="dev_IP" />
        </property>
        <property name="deviceDescription" type="string">
            <column name="dev_desc"/>
        </property>
        <property name="workDisp" type="string">
            <column name="wrk_dsp"/>
        </property>
    </class>
</hibernate-mapping>
