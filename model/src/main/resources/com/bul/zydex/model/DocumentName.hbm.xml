<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.DocumentName" table="document_name" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="documentName" type="string">    
            <column name="document_name"  />
        </property>
         <property name="state" type="string">    
            <column name="state"  />
        </property>
         <property name="compalsuary" type="string">    
            <column name="compalsuary"  />
        </property>
         <property name="discomId" type="java.lang.Integer">    
            <column name="discom_id"  />
        </property>
         <property name="connectionTypeId" type="java.lang.Integer">    
            <column name="connection_type_id"  />
        </property>
         
        
    </class>
    
</hibernate-mapping>
