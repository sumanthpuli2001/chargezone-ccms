<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
     <class name="com.bul.zydex.model.DynamicApprovalSetting" table="dynamic_approval_setting" catalog="hr_power_astral" optimistic-lock="version">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="company" class="com.bul.zydex.model.Company" fetch="select">
            <column name="company_id" not-null="true" />
        </many-to-one>
        <many-to-one name="designationMaster" class="com.bul.zydex.model.DesignationMaster" fetch="select">
            <column name="designation_id" not-null="true" />
        </many-to-one>
        <many-to-one name="modules" class="com.bul.zydex.model.Modules" fetch="select">
            <column name="module_id" not-null="true" />
        </many-to-one>
        <many-to-one name="zydexLocationMaster" class="com.bul.zydex.model.ZydexLocationMaster" fetch="select">
            <column name="location_id" not-null="true" />
        </many-to-one>
        <property name="projectName" type="java.lang.Integer">
            <column name="project_name"/>
        </property>
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
        <property name="createdDate" type="string">
            <column name="created_date" length="45" />
        </property>
        <property name="updatedBy" type="java.lang.Integer">
            <column name="updated_by" />
        </property>
        <property name="updatedDate" type="string">
            <column name="updated_date" length="45" />
        </property>
    </class>
</hibernate-mapping>

