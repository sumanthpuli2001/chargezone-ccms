<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.DynamicApprovalSettingApprover" table="dynamic_approval_setting_approver" catalog="hr_power_vnc" >
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="dynamicApprovalSettingId" class="com.bul.zydex.model.DynamicApprovalSetting" fetch="select">
            <column name="dynamic_approval_setting_id"  />
        </many-to-one>
        <many-to-one name="employeeMaster" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="approver_id"  />
        </many-to-one>
        <property name="approverName" type="string">
            <column name="approver_name" length="45" />
        </property>
    </class>
</hibernate-mapping>
