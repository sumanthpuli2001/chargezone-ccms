<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.DynamicApprovalSettingEmail" table="dynamic_approval_setting_email" catalog="hr_power_vnc" optimistic-lock="version">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="employeeMaster" class="com.bul.zydex.model.EmployeeMaster" >
            <column name="appover_id" not-null="true" />
        </many-to-one>
        <many-to-one name="dynamicApprovalSettingId" class="com.bul.zydex.model.DynamicApprovalSetting" >
            <column name="dynamic_approval_setting_id" not-null="true" />
        </many-to-one>
        <property name="approverName" type="string">
            <column name="approver_name" length="45" />
        </property>
        <property name="emailId" type="string">
            <column name="email_id" length="45" />
        </property>
    </class>
</hibernate-mapping>
