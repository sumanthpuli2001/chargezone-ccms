<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.ElectricalContractor" table="electrical_contractor" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="vendorCriteriaMasterId" type="java.lang.Integer">    
            <column name="vendor_criteria_master_id" length="500"  />
        </property>
        <property name="criteria" type="string">    
            <column name="criteria" length="500"  />
        </property>
        <property name="selectionCriteria" type="string">    
            <column name="selection_critera" length="500"  />
        </property>
        <property name="comment" type="string">    
            <column name="comment" length="5000"  />
        </property>
        <property name="attachment" type="string">    
            <column name="attachment"   />
        </property>
        <property name="score" type="string">    
            <column name="score"   />
        </property>
        
        <many-to-one name="vendorInformation" class="com.bul.zydex.model.VendorInformation" fetch="select">
            <column name="vendor_information_id"  />
        </many-to-one>
        
        
         <property name="response" type="string">    
            <column name="response"   />
        </property>
         
         <property name="technicalComment" type="string">    
            <column name="technical_comment"   />
        </property>
        
        <property name="compulsaryFlag" type="string">    
            <column name="compulsary_flag"   />
        </property>
        
    </class>
</hibernate-mapping>
