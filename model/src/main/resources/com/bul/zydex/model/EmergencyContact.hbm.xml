<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.EmergencyContact" table="emergency_contact" catalog="hr_power_vnc">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
 
        <property name="contactDescription" type="string">
            <column name="contact_description" />
        </property>
      
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
        
        <property name="createdDate" type="string">
            <column name="created_date" />
        </property>
      
        <property name="updatedBy" type="java.lang.Integer">
            <column name="updated_by" />
        </property>
        
        <property name="updatedDate" type="java.lang.String">
            <column name="updated_date" />
        </property>
    </class>
</hibernate-mapping>
