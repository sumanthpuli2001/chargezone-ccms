<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
<class name="com.bul.zydex.model.EmployeeCtcDetail" table="employee_ctc_detail" catalog="hr_power_gipcl">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="employeeMaster" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="employee_master_id" />
        </many-to-one>
        <many-to-one name="ctcAllowance" class="com.bul.zydex.model.CtcAllowance" fetch="select">
            <column name="ctc_master_id" />
        </many-to-one>
        <property name="amount" type="java.lang.Double">
            <column name="amount" precision="22" scale="0" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        <property name="month" type="string">
            <column name="month" length="45" />
        </property>
        <property name="year" type="string">
            <column name="year" length="45" />
        </property>
      
    </class>
  

</hibernate-mapping>
