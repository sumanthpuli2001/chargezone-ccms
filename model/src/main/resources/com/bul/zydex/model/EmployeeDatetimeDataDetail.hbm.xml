<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.EmployeeDateTimeDataDetail" table="employee_datetime_data_detail" catalog="hr_power_vnc">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="employeeDatetimeData" class="com.bul.zydex.model.EmployeeDateTimeDataDetail" fetch="select">
            <column name="employee_datetime_id" />
        </many-to-one>
        <property name="createdDate" type="string">
            <column name="created_date" />
        </property>
        <property name="updatedDate" type="string">
            <column name="updated_date" />
        </property>
        <property name="createdBy" type="string">
            <column name="created_by" />
        </property>
        <property name="updatedBy" type="string">
            <column name="updated_by" />
        </property>
    </class>
</hibernate-mapping>
