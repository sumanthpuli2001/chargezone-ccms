<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.EmployeeMaster" table="employee_master" catalog="ccms">
        <id name="employeeCode" type="string">
            <column name="Employee_Code" />
        </id>
        <property name="name" type="string">
            <column name="Name" length="30"  />
        </property>
        <property name="department" type="string">
            <column name="Department" length="30"  />
        </property>
        <property name="designation" type="string">
            <column name="Designation" length="30"  />
        </property>
        <property name="rightsName" type="string">
            <column name="Rights_Name" length="30"  />
        </property>
        <property name="dRow" type="string">
            <column name="D_Row" length="30"  />
        </property>
        <property name="rfId" type="string">
            <column name="RF_ID" length="30"  />
        </property>
        <property name="rfIdDept" type="string">
            <column name="RF_ID_DEP" length="30"  />
        </property>
        <property name="rfIdGuest" type="string">
            <column name="RF_ID_GUEST" length="30"  />
        </property>
    </class>
  

</hibernate-mapping>
