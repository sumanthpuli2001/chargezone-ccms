<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

    <class name="com.bul.zydex.model.EmployeePolicyDetail" table="employee_policy_detail" catalog="hr_power_vnc">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="employeeMaster" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="employee_master_id" />
        </many-to-one>
        <many-to-one name="policyMaster" class="com.bul.zydex.model.PolicyMaster" fetch="select">
            <column name="policy_master_id" />
        </many-to-one>
        <property name="amount" type="java.lang.Double">
            <column name="amount" precision="22" scale="0" />
        </property>
        <property name="policyNum" type="string">
            <column name="policy_num" length="45" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status"/>
        </property>
    </class>

</hibernate-mapping>
