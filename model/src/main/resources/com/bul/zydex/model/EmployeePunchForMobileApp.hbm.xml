<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
<class name="com.bul.zydex.model.EmployeePunchForMobileApp" table="employee_punch_data_for_mobile_app" catalog="hira_technology">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="employeeMaster" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="employee_master_id" not-null="true" />
        </many-to-one>
        <property name="punchTime" type="string">
            <column name="punch_time" />
        </property>
        <property name="punchLocation" type="string">
            <column name="punch_location" />
        </property>
    </class>
</hibernate-mapping>
