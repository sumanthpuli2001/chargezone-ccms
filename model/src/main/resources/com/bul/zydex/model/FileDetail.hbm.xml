<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.FileDetail" table="file_detail" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="tenderNo" type="string">    
            <column name="tender_no" length="200"  />
        </property>
        <property name="title" type="string">    
            <column name="title" length="200"  />
        </property>
        <property name="fileName" type="string">    
            <column name="file_name" length="200"  />
        </property>
        <property name="serType" type="string">    
            <column name="ser_type" length="200"  />
        </property>
        <property name="taxReq" type="string">    
            <column name="tax_req" length="200"  />
        </property>
        <property name="totReq" type="string">    
            <column name="tot_req" length="200"  />
        </property>
        <property name="negativeAmount" type="string">    
            <column name="negative_amount" length="200"  />
        </property>
        <property name="allowance" type="string">    
            <column name="allowance" length="200"  />
        </property>
        <property name="uniformTrainingCost" type="string">    
            <column name="uniform_training_cost" length="200"  />
        </property>
        <property name="serviceCharge" type="string">    
            <column name="service_charge" length="200"  />
        </property>
        <property name="dateWise" type="string">    
            <column name="date_wise" length="200"  />
        </property>
        <property name="toDate" type="string">    
            <column name="to_date" length="200"  />
        </property>
        <property name="fromDate" type="string">    
            <column name="from_date" length="200"  />
        </property>
        <property name="allowReg" type="string">    
            <column name="allow_reg" length="200"  />
        </property>
        <property name="refNo" type="string">    
            <column name="ref_no" length="200"  />
        </property>
    </class>
</hibernate-mapping>
