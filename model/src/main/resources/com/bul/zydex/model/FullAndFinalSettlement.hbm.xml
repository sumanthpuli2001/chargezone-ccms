<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.FullAndFinalSettlement" table="full_and_final_settlement" catalog="hr_power_vnc">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="employeeMaster" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="employee_master_id" />
        </many-to-one>
        <property name="noticePeriod" type="java.lang.Integer">
            <column name="notice_period" />
        </property>
        <property name="givenNotice" type="java.lang.Integer">
            <column name="given_notice" />
        </property>
        <property name="createdDate" type="string">
            <column name="created_date" />
        </property>
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
        <property name="updateDate" type="string">
            <column name="updated_date" />
        </property>
        <property name="updatedBy" type="java.lang.Integer">
            <column name="updated_by" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        <property name="recoveryDays" type="java.lang.Integer">
            <column name="recovery_dy" />
        </property>
        <property name="noticePeriodRecovery" type="java.lang.Integer">
            <column name="notice_period_recovery" />
        </property>
        <property name="shoesDeduction" type="java.lang.Integer">
            <column name="shoes_deduction" />
        </property>
        <property name="uniformDeduction" type="java.lang.Integer">
            <column name="uniform_deduction" />
        </property>
        <property name="otherDeduction" type="java.lang.Integer">
            <column name="other_deduction" />
        </property>
    </class>
  

</hibernate-mapping>
