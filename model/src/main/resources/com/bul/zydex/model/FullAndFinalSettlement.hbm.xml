<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.FullAndFinalSettlement" table="full_and_final_settlement" catalog="hr_power_astral">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="employeeMaster" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="resignation_emp_id" />
        </many-to-one>
        <property name="noticePeriod" type="java.lang.Integer">
            <column name="notice_period" />
        </property>
        <property name="givenNotice" type="java.lang.Integer">
            <column name="given_notice" />
        </property>
        <property name="createdDate" type="string">
            <column name="created_date" />
        </property>
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
        <property name="updateDate" type="string">
            <column name="updated_date" />
        </property>
        <property name="updatedBy" type="java.lang.Integer">
            <column name="updated_by" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
    </class>
  

</hibernate-mapping>
