<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.GroupCategory" table="group_category" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="groupCatogryName" type="string">    
            <column name="group_category_name" length="200"  />
        </property>
        <property name="groupMasterId" type="java.lang.Integer">    
            <column name="group_master_id" length="200"  />
        </property>
    </class>
  

</hibernate-mapping>
