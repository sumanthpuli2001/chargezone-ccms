<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.InvoiceAttachment" table="invoice_attachment" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="invoiceAttachment" type="string">
            <column name="invoice_attachment"  />
        </property>
        <property name="poId" type="java.lang.Integer">
            <column name="po_id"  />
        </property>
        <property name="documentNo" type="string">
            <column name="document_no"  />
        </property>
        <property name="poNo" type="string">
            <column name="po_no"  />
        </property>
        <property name="tenderNo" type="string">
            <column name="tender_no"  />
        </property>
        <property name="invoiceAmount" type="string">
            <column name="invoice_amount"  />
        </property>
        <property name="otherDocumentNo" type="string">
            <column name="other_document_no"  />
        </property>
        <property name="documentType" type="string">
            <column name="document_type"  />
        </property>
        <property name="vendorCode" type="string">
            <column name="vendor_code"  />
        </property>
        <property name="vendorName" type="string">
            <column name="vendor_name"  />
        </property>
        
        <property name="status" type="java.lang.Integer">
            <column name="status"  />
        </property>
        
        
        <property name="buyerAttachment" type="string">
            <column name="buyer_attachment"  />
        </property>
        <property name="buyerComment" type="string">
            <column name="buyer_comment"  />
        </property>
        <property name="vendorComment" type="string">
            <column name="vendor_comment"  />
        </property>

      <property name="grnStatus" type="java.lang.Integer">
            <column name="grn_status"  />
        </property>
        <property name="grnComment" type="string">
            <column name="grn_comment"  />
        </property>
        <property name="grnNumber" type="string">
            <column name="grn_number"  />
        </property>
        <property name="grnAttachment" type="string">
            <column name="grn_attachment"  />
        </property>
         <property name="financialStatus" type="java.lang.Integer">
            <column name="financial_status"  />
        </property>
        <property name="financialComment" type="string">
            <column name="financial_comment"  />
        </property>
        <property name="financialAttachment" type="string">
            <column name="financial_attachment"  />
        </property>
         <property name="grnExectiveCode" type="string">    
            <column name="grn_exective_code"/>
        </property>
         <property name="financialPersonCode" type="string">    
            <column name="financial_person_code"/>
        </property>
    </class>

</hibernate-mapping>
