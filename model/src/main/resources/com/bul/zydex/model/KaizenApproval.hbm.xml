<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.KaizenApproval" table="kaizen_approval" catalog="hr_power_astral" optimistic-lock="version">
        <id name="id" type="int">
            <column name="id" />
            <generator class="assigned" />
        </id>
        <many-to-one name="employeeMaster" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="employee_master_id" not-null="true" />
        </many-to-one>
        <many-to-one name="kaizenMaster" class="com.bul.zydex.model.KaizenMaster" fetch="select">
            <column name="kaizen_master_id" not-null="true" />
        </many-to-one>
        <property name="level" type="java.lang.Integer">
            <column name="level" />
        </property>
        <property name="comment" type="string">
            <column name="comment" length="45" />
        </property>
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
        <property name="createdDate" type="string">
            <column name="created_date" length="45" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        
        
    </class>
  

</hibernate-mapping>
