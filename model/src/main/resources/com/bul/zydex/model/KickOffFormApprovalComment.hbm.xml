<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.KickOffFormApprovalComment" table="kickoff_form_approval_comment" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="kickOffFormApproval" class="com.bul.zydex.model.KickOffFormApproval" fetch="select">
            <column name="kickoff_form_approval_id"  />
        </many-to-one>
         <property name="userId" type="string">    
            <column name="user_id"  />
        </property>
        <property name="approvalComment" type="string">    
            <column name="approval_comment"  />
        </property>
        <property name="approvalStatus" type="string">    
            <column name="approval_status"  />
        </property>
       
      
    </class>
</hibernate-mapping>
