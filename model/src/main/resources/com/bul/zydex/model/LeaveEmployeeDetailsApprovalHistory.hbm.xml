<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="com.bul.zydex.model.LeaveEmployeeDetailsApprovalHistory" table="leave_employee_details_approval_history" catalog="hr_power_gipcl">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="leaveEmployeeDetail" class="com.bul.zydex.model.LeaveEmployeeDetail" fetch="select">
            <column name="leave_emp_details_id" not-null="true" />
        </many-to-one>
        <property name="approvalId" type="java.lang.Integer">
            <column name="approval_id" />
        </property>
        <property name="approvalName" type="string">
            <column name="approval_name"  />
        </property>
        <property name="comment" type="string">
            <column name="comment" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status"  />
        </property>
        <property name="statusMessage" type="string">
            <column name="status_message"  />
        </property>
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
        <property name="createdDate" type="string">
            <column name="created_date"  />
        </property>
    </class>
</hibernate-mapping>
