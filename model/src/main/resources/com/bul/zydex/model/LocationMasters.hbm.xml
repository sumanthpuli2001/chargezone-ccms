<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.LocationMasters" table="location_masters" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="companyCode" type="string">    
            <column name="company_code"  />
        </property>
          <property name="plantCode" type="string">    
            <column name="plant_code"  />
        </property>
         <property name="loactionCode" type="string">    
            <column name="location_code"  />
        </property>
          <property name="loactionName" type="string">    
            <column name="location_name"  />
        </property>
         <property name="address" type="string">    
            <column name="address"  />
        </property>
         
        
    </class>
</hibernate-mapping>
