<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.ManagerialPerson" table="managerial_person" catalog="eprocsuite_chargezone" optimistic-lock="version">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="vendorInvitationId" type="java.lang.Integer">
            <column name="vendor_invitation_id" />
        </property>
        <property name="name" type="string">
            <column name="name" />
        </property>
        <property name="designation" type="string">
            <column name="designation" />
        </property>
          
        <property name="phoneNo" type="string">
            <column name="phone_no" />
        </property>
        
        <property name="emailId" type="string">
            <column name="email_id" />
        </property>
        <property name="countryCode" type="string">
            <column name="country_code" />
        </property>
      
      
        
    </class>
</hibernate-mapping>
