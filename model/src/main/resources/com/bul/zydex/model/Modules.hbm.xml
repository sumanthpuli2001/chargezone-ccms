<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.Modules" table="modules" catalog="hr_power_vnc" optimistic-lock="version">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="moduleName" type="string">
            <column name="module_name" length="45" not-null="true" />
        </property>
        <property name="moduleStatus" type="int">
            <column name="module_status" not-null="true" />
        </property>
        <set name="componentMasters" table="component_master" inverse="true" lazy="true" fetch="select">
            <key>
                <column name="module_id" not-null="true" />
            </key>
            <one-to-many class="com.bul.zydex.model.ComponentMaster" />
        </set>
    </class>
  

</hibernate-mapping>
