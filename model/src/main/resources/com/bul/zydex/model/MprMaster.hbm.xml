<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.MprMaster" table="mpr_master" catalog="hr_power_vnc">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="locationMaster" class="com.bul.zydex.model.LocationMaster" fetch="select">
            <column name="location_id" />
        </many-to-one>
        <many-to-one name="departmentMaster" class="com.bul.zydex.model.DepartmentMaster" fetch="select">
            <column name="department_id" />
        </many-to-one>
        <many-to-one name="jobtypeMaster" class="com.bul.zydex.model.JobtypeMaster" fetch="select">
            <column name="jobtype_id" />
        </many-to-one>
        <property name="name" type="string">
            <column name="name" />
        </property>
        <property name="numberOfPosition" type="java.lang.Integer">
            <column name="number_of_position" />
        </property>
        <property name="budget" type="java.lang.Integer">
            <column name="budget" />
        </property>
        <property name="experience" type="string">
            <column name="experience" />
        </property>
        <property name="description" type="string">
            <column name="description" />
        </property>
        <many-to-one name="designationMaster" class="com.bul.zydex.model.DesignationMaster" fetch="select">
            <column name="designation_id" />
        </many-to-one>
        <property name="dateOfLeaving" type="string">
            <column name="date_of_leaving" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        <property name="currentLevel" type="java.lang.Integer">
            <column name="current_level" />
        </property>
        <property name="totalLevel" type="java.lang.Integer">
            <column name="total_level" />
        </property>
        <property name="remainingBudget" type="java.lang.Integer">
            <column name="remaining_budget" />
        </property>
          <property name="approvalComment" type="string">
            <column name="approval_comment" />
        </property>
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
          <property name="createdDate" type="string">
            <column name="created_date" />
        </property>
        <property name="updatedBy" type="java.lang.Integer">
            <column name="updated_by" />
        </property>
          <property name="updatedDate" type="string">
            <column name="updated_date" />
        </property>
         <many-to-one name="recruitmentMaster" class="com.bul.zydex.model.RecruitmentMaster" fetch="select">
            <column name="mpp_master_id" />
        </many-to-one>
    </class>
</hibernate-mapping>
