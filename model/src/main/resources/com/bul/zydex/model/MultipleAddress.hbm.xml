<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.MultipleAddress" table="multiple_address" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="prNumber" type="string">    
            <column name="pr_number" length="200"  />
        </property>
       
        <property name="address1" type="string">    
            <column name="address1" length="200"  />
        </property>
        <property name="address2" type="string">    
            <column name="address2" length="200"  />
        </property>
        <property name="state" type="string">    
            <column name="state" length="200"  />
        </property>
        <property name="city" type="string">    
            <column name="city" length="200"  />
        </property>
        <property name="pincode" type="string">    
            <column name="pincode" length="200"  />
        </property>
       <property name="remark" type="string">    
            <column name="remark" length="200"  />
        </property>
    </class>
  

</hibernate-mapping>
