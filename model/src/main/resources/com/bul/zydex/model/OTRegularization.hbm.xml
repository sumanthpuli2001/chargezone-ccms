<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

   <class name="com.bul.zydex.model.OTRegularization" table="ot_regularization" catalog="hr_power_gipcl">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="employeeMaster" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="approver_id" />
        </many-to-one>
        <many-to-one name="clientDetailsMaster" class="com.bul.zydex.model.ClientDetailsMaster" fetch="select">
            <column name="client_master_id" />
        </many-to-one>
        <property name="userMasterId" type="int">
            <column name="user_master_id" not-null="true" />
        </property>
        <property name="startDateTime" type="string">
            <column name="start_date_time" length="45" />
        </property>
        <property name="endDateTime" type="string">
            <column name="end_date_time" length="45" />
        </property>
        <property name="reason" type="string">
            <column name="reason" length="65535" />
        </property>
        <property name="status" type="int">
            <column name="status" not-null="true" />
        </property>
        <property name="managerRemark" type="string">
            <column name="manager_remark" />
        </property>
        <property name="approvedDate" type="string">
            <column name="approved_date" length="45" />
        </property>
        <property name="dateOfSubmit" type="string">
            <column name="date_of_submit" length="45" />
        </property>
        <property name="differentCompare" type="string">
            <column name="diff_compare" length="45" />
        </property>
        <property name="arType" type="string">
            <column name="ar_Type" length="45" />
        </property>
        <property name="startDateAr" type="string">
            <column name="start_date_ar" length="45" />
        </property>
        <property name="endDateAr" type="string">
            <column name="end_date_ar" length="45" />
        </property>
    </class>

</hibernate-mapping>
