<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.OapMultiAttachment" table="oap_multi_attachment" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="oapForm" class="com.bul.zydex.model.OapForm" fetch="select">
            <column name="oap_form_id"  />
        </many-to-one>
               
        <property name="attachment" type="string">    
            <column name="attachment"  />
        </property>
          <property name="description" type="string">    
            <column name="description"  />
        </property>
        
        
        
    </class>
</hibernate-mapping>
