<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.OapSurveyAttachment" table="oap_survey_attachment" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="oapId" type="java.lang.Integer">    
            <column name="oap_id"   />
        </property>
        <property name="surveyNo" type="string">    
            <column name="survey_no"   />
        </property>
        <property name="projectRepresentative" type="string">    
            <column name="project_representative"   />
        </property>
       
    </class>
  

</hibernate-mapping>
