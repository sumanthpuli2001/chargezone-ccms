<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.OapSurveyAttachmentHistory" table="oap_survey_attachment_history" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="oapId" type="java.lang.Integer">    
            <column name="oap_id"   />
        </property>
        <property name="surveyNo" type="string">    
            <column name="survey_no"   />
        </property>
         <property name="history" type="string">    
            <column name="history"   />
        </property>
         <property name="dateTime" type="string">    
            <column name="date_time"   />
        </property>
        <property name="oapSurveyAttachmentId" type="java.lang.Integer">    
            <column name="oap_survey_attachment_id"   />
        </property>
         <property name="oapFormHistoryId" type="java.lang.Integer">    
            <column name="oap_form_history_id"   />
        </property>
    </class>
  

</hibernate-mapping>
