<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.OmsMaster" table="oms_master" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="ticketId" type="string">    
            <column name="ticket_id" length="128"  />
        </property>
        <property name="prNumber" type="string">    
            <column name="pr_number" length="128"  />
        </property>
        <property name="dateTime" type="string">    
            <column name="date_time" length="128"  />
        </property>
        <property name="prFlag" type="java.lang.Integer">    
            <column name="pr_flag" />
        </property>
        <property name="omsPrId" type="string">    
            <column name="oms_pr_id" length="128"  />
        </property>
            
    </class>
</hibernate-mapping>
