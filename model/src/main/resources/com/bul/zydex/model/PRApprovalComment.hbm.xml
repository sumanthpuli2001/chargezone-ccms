<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.PRApprovalComment" table="pr_approval_comment" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="prNo" type="string">    
            <column name="pr_no" length="45"  />
        </property>
        <property name="dateTime" type="string">    
            <column name="date_time" length="45"  />
        </property>
        <property name="comment" type="string">    
            <column name="comment"   />
        </property>
        <property name="approvalStatus" type="string">    
            <column name="approval_status"   />
        </property>
        <property name="userId" type="string">    
            <column name="user_id" length="45"  />
        </property>
        
         
    </class>
  
</hibernate-mapping>
