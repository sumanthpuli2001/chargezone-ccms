<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="com.bul.zydex.model.PayrollTaxDeclarationPeriodMaster" table="payroll_tax_declaration_period_master" catalog="hr_power_gipcl">
        <id name="id" type="java.lang.Integer">
             <column name="id"/>
             <generator class="identity"/>
        </id>

        <many-to-one name="payrollFinancialYear" class="com.bul.zydex.model.PayrollFinancialYear" fetch="select">
            <column name="financial_year_id" not-null="true"/>
        </many-to-one>
        
        <property name="declarationThresholdDate" type="string" not-null="true">
            <column name="declaration_threshold_date" not-null="true"/>
        </property>
        
        <property name="proofThresholdDate" type="string" not-null="true">
            <column name="proof_threshold_date" not-null="true" />
        </property>
      
        <property name="tdpStatus" type="java.lang.Integer">
            <column name="tdp_status" />
        </property>
        
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
        
        <property name="createdDate" type="string">
            <column name="created_date" />
        </property>
        
        <property name="updatedBy" type="java.lang.Integer">
            <column name="updated_by" />
        </property>
        
        <property name="updatedDate" type="java.lang.String">
            <column name="updated_date" />
        </property>
  </class>
</hibernate-mapping>
