<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="com.bul.zydex.model.PayrollTaxRateMaster" table="payroll_tax_rate_master" catalog="hr_power_gipcl">
      
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        
        <property name="incomeFrom" type="string" not-null="true">
            <column name="income_from"/>
        </property>
        
        <property name="incomeTo" type="string" not-null="true">
            <column name="income_to"/>
        </property>
        
        <property name="taxRate" type="string" not-null="true">
             <column name="tax_rate"/>
        </property>
            
        <property name="ageFrom" type="java.lang.Integer" not-null="true">
            <column name="age_from"/>
        </property>
                
        <property name="ageTo" type="java.lang.Integer" not-null="true">
            <column name="age_to"/>
        </property>
        
        <property name="status" type="java.lang.Integer" not-null="true">
            <column name="status" />
        </property>
        
        <property name="createdBy" type="java.lang.Integer" not-null="true">
            <column name="created_by" />
        </property>
        
        <property name="createdDate" type="string" not-null="true">
            <column name="created_date" />
        </property>
        
        <property name="updatedBy" type="java.lang.Integer">
            <column name="updated_by" />
        </property>
        
        <property name="updatedDate" type="string">
            <column name="updated_date" />
        </property>
        
  </class>
</hibernate-mapping>
