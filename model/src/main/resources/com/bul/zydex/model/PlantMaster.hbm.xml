<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.PlantMaster" table="plant_master" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="plantName" type="string">    
            <column name="plant_name" length="1000"  />
        </property>
        <property name="plantCode" type="string">    
            <column name="plant_code" length="1000"  />
        </property>
        <property name="statusFlag" type="java.lang.Integer">    
            <column name="status_flag" length="10"  />
        </property>
        <property name="location" type="string">    
            <column name="location" length="1000"  />
        </property>
    </class>
</hibernate-mapping>
