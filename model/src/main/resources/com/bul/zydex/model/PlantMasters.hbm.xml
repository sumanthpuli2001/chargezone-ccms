<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.PlantMasters" table="plant_masters" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="companyCode" type="string">    
            <column name="company_code"  />
        </property>
        
        <property name="plantCode" type="string">    
            <column name="plant_code"  />
        </property>
        <property name="plantName" type="string">    
            <column name="plant_name"  />
        </property>
        <property name="address" type="string">    
            <column name="address"  />
        </property>
        <property name="gst" type="string">    
            <column name="gst"  />
        </property>
        <property name="purchasingOrganisation" type="string">    
            <column name="purchasing_organisation"  />
        </property>
        
        <property name="postalCode" type="string">    
            <column name="postal_code"  />
        </property>
        <property name="country" type="string">    
            <column name="country"  />
        </property>
        <property name="region" type="string">    
            <column name="region"  />
        </property>
        
        <property name="language" type="string">    
            <column name="language"  />
        </property>
        
    </class>
</hibernate-mapping>
