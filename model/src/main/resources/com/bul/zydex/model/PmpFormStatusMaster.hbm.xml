<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
     <class name="com.bul.zydex.model.PmpFormStatusMaster" table="pmp_form_status" catalog="hr_power_vnc">
         <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="employeeMaster" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="emp_id" not-null="true" />
        </many-to-one>
        <property name="startYearStatus" type="boolean">
            <column name="start_year_status" not-null="true" />
        </property>
        <property name="midYearStatus" type="boolean">
            <column name="mid_year_status" not-null="true" />
        </property>
        <property name="endYearStatus" type="boolean">
            <column name="end_year_statue" not-null="true" />
        </property>
        <property name="managerSide" type="boolean">
            <column name="manager_side" not-null="true" />
        </property>
        <property name="employeeSide" type="boolean">
            <column name="employee_side" not-null="true" />
        </property>
        <property name="compentencyStartYearStatus" type="boolean">
            <column name="compentency_start_year_status" not-null="true" />
        </property>
        <property name="compentencyMidYearStatus" type="boolean">
            <column name="compentency_mid_year_status" not-null="true" />
        </property>
        <property name="compentencyEndYearStatus" type="boolean">
            <column name="compentency_end_year_status" not-null="true" />
        </property>
        <property name="compentencyManagerSide" type="boolean">
            <column name="compentency_manager_side" not-null="true" />
        </property>
        <property name="compentencyEmployeeSide" type="boolean">
            <column name="compentency_employee_side" not-null="true" />
        </property>
       
    </class>

</hibernate-mapping>
