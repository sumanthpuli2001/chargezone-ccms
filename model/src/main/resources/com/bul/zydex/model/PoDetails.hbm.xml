<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.PoDetails" table="po_details" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        
               
        <property name="prNo" type="string">    
            <column name="pr_no"  />
        </property>
        
        <property name="tenderNo" type="string">    
            <column name="tender_no"  />
        </property>
        
        
         <property name="poNo" type="string">    
            <column name="po_no"  />
        </property>
        
         <property name="poDate" type="string">    
            <column name="po_date"  />
        </property>
        
         <property name="vendorCode" type="string">    
            <column name="vendor_code"  />
        </property>
        
         <property name="vendorName" type="string">    
            <column name="vendor_name"  />
        </property>
        
         <property name="poValue" type="string">    
            <column name="po_value"  />
        </property>
         <property name="noDocumentAttached" type="java.lang.Integer">    
            <column name="no_document_attached"  />
        </property>
         <property name="status" type="java.lang.Integer">    
            <column name="status"  />
        </property>
        
    </class>
</hibernate-mapping>
