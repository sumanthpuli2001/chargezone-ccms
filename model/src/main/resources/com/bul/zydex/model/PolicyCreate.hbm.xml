<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.PolicyCreate" table="policy_hr_created" catalog="hr_power_vnc">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="name" type="string">
            <column name="name" />
        </property>
        <many-to-one name="policyDropDown" class="com.bul.zydex.model.PolicyDropDown" fetch="select">
            <column name="policy" />
        </many-to-one>
        <property name="attachment" type="string">
            <column name="attachment" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        <property name="createdDate" type="string">
            <column name="created_date" />
        </property>
        <property name="createdBy" type="string">
            <column name="created_by" />
        </property>
          <property name="updatedDate" type="string">
            <column name="updated_date" />
        </property>
        <property name="updatedBy" type="string">
            <column name="updated_by" />
        </property>
        <property name="acceptPolicy" type="java.lang.Integer">
            <column name="accept_policy" />
        </property>
           <property name="readDate" type="string">
            <column name="read_date" />
        </property>
        <property name="readBy" type="string">
            <column name="read_by" />
        </property>
        <property name="acceptPolicyTime" type="string">
            <column name="accept_policy_time" />
        </property>
        <property name="acceptByPolicyId" type="java.lang.Integer">
            <column name="accept_by_policy_id" />
        </property>
    </class>
  

</hibernate-mapping>
