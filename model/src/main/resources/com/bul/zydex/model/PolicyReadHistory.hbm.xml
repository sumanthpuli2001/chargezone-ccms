<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.PolicyReadHistory" table="policy_read_history" catalog="hr_power_astral">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
          <property name="policyId" type="java.lang.Integer">
            <column name="policy_id" />
        </property>
        <property name="readerDate" type="string">
            <column name="reader_date" />
        </property>
        <property name="readerBy" type="string">
            <column name="reader_by" />
        </property>
        <property name="policyAcept" type="java.lang.Integer">
            <column name="policy_accept" />
        </property>
         <property name="policyAceptTime" type="string">
            <column name="policy_accept_time" />
        </property>
           <property name="policyReadStatus" type="java.lang.Integer">
            <column name="policy_read_status" />
        </property>
    </class>
  

</hibernate-mapping>
