<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.ProjectManagementMaster" table="project_management_master" catalog="hr_power_gipcl" optimistic-lock="version">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="clientMaster" class="com.bul.zydex.model.ClientMaster" fetch="select">
            <column name="client" not-null="true" />
        </many-to-one>
        <many-to-one name="priorityMaster" class="com.bul.zydex.model.PriorityMaster" fetch="select">
            <column name="priority" not-null="true" />
        </many-to-one>
        <many-to-one name="stateMaster" class="com.bul.zydex.model.StateMaster" fetch="select">
            <column name="state" not-null="true" />
        </many-to-one>
        <many-to-one name="zydexLocationMaster" class="com.bul.zydex.model.ZydexLocationMaster" fetch="select">
            <column name="work_location" not-null="true" />
        </many-to-one>
        <property name="projectCode" type="string">
            <column name="project_code" length="45" />
        </property>
        <property name="name" type="string">
            <column name="name" length="45" />
        </property>
        <property name="plannedDate" type="string">
            <column name="planned_date" length="45" />
        </property>
        <property name="deadline" type="string">
            <column name="deadline" length="45" />
        </property>
        <property name="riskImpact" type="string">
            <column name="risk_Impact" length="45" />
        </property>
        <property name="manager" type="string">
            <column name="manager" length="45" />
        </property>
        <property name="finishDate" type="string">
            <column name="finish_date" length="45" />
        </property>
        <property name="taskCompleted" type="string">
            <column name="task_completed" length="45" />
        </property>
        <property name="budget" type="string">
            <column name="budget" length="45" />
        </property>
        <property name="billingType" type="string">
            <column name="billing_type" length="45" />
        </property>
        <property name="description" type="string">
            <column name="description" length="45" />
        </property>
    </class>
</hibernate-mapping>
