<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.PunchedDataMaster" table="punched_data" catalog="eprocsuite_chargezone" optimistic-lock="version">
        <id name="srNo" type="java.lang.Long">
            <column name="sr_no" />
        </id>
        <property name="item" type="string">
            <column name="item" />
        </property>
        <property name="empCode" type="string">
            <column name="emp_cd" />
        </property>
        <property name="lDate" type="string">
            <column name="l_date"/>
        </property>
        <property name="lTime" type="string">
            <column name="l_time"/>
        </property>
        <property name="quantity" type="string">
            <column name="qty"/>
        </property>  
        <property name="price" type="java.lang.Double">
            <column name="price"/>
        </property>  
        <property name="cid" type="string">
            <column name="cid"/>
        </property>
        <property name="disp" type="java.lang.Integer">
            <column name="disp"/>
        </property>
        <property name="remark" type="string">
            <column name="remarks"/>
        </property>

    </class>

</hibernate-mapping>
