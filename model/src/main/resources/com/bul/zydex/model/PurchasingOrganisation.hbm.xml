<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.PurchasingOrganisation" table="purchasing_organisation" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="companyCode" type="string">    
            <column name="comapny_code"  />
        </property>
         <property name="purchasingOrganisation" type="string">    
            <column name="purchasing_organisation"  />
        </property> 
        <property name="description" type="string">    
            <column name="description"  />
        </property>
        
        
        
         
        
    </class>
</hibernate-mapping>
