<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.QuestionAnswerSubmit" table="question_answer_submit" catalog="hr_power_astral">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="questionLibraryId" class="com.bul.zydex.model.QuestionLibrary" fetch="select">
            <column name="question_library_id"  />
        </many-to-one>
        <many-to-one name="candidateJobApplicationid" class="com.bul.zydex.model.CandidateJobApplication" fetch="select">
            <column name="candidate_job_application_id"/>
        </many-to-one>
        <many-to-one name="questionAnsId" class="com.bul.zydex.model.QuestionAns" fetch="select">
            <column name="question_ans_id" />
        </many-to-one>
        <property name="description" type="string">
            <column name="description"  />
        </property>
        <property name="obtainMarks" type="java.lang.Double">
            <column name="obtain_marks" />
        </property>
        <property name="ansStatus" type="java.lang.Integer">
            <column name="ans_status"/>
        </property>
       
    </class>
</hibernate-mapping>
