<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="com.bul.zydex.model.QuestionDetails" table="questions_details" catalog="hr_power_vnc">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="questionPaper" class="com.bul.zydex.model.QuestionPaper" fetch="select">
            <column name="question_paper_id" />
        </many-to-one>
        <many-to-one name="questionLibrary" class="com.bul.zydex.model.QuestionLibrary" fetch="select">
            <column name="questions" />
        </many-to-one>
    </class>
</hibernate-mapping>
