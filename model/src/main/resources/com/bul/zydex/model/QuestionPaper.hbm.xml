<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="com.bul.zydex.model.QuestionPaper" table="question_paper" catalog="hr_power_astral" >
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="categoryName" class="com.bul.zydex.model.MprEmployeeCategory" fetch="select">
            <column name="category_name" />
        </many-to-one>
<!--        <property name="categoryName" type="string">
            <column name="category_name" />
        </property>-->
        <property name="paperName" type="string">
            <column name="paper_name"  />
        </property>
        <property name="totalMarks" type="java.lang.Double">
            <column name="total_marks"  />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
        <property name="createdDate" type="string">
            <column name="created_date"  />
        </property>
        <property name="updatedBy" type="java.lang.Integer">
            <column name="updated_by" />
        </property>
        <property name="updatedDate" type="string">
            <column name="updated_date"/>
        </property>
    </class>
</hibernate-mapping>
