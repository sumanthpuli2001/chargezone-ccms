<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.RechargeMaster" table="recharge_master" catalog="ccms" optimistic-lock="version">
        <id name="limit" type="java.lang.Double">
            <column name="Limit" />
        </id>
        <property name="startDate" type="string">
            <column name="Starting_Date" />
        </property>
        <property name="endDate" type="string">
            <column name="Ending_Date" />
        </property>
        <property name="dRow" type="string">
            <column name="D_Row"/>
        </property>
    </class>

</hibernate-mapping>
