<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.RecruitmentApprovalHistory" table="recruitment_approval_history" catalog="hr_power_gipcl">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="approvalUserName" type="string">
            <column name="approval_user_name" />
        </property>
        <property name="approvalUserId" type="java.lang.Integer">
            <column name="approval_user_id" />
        </property>
        <property name="comment" type="string">
            <column name="comment" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        <property name="statusMessage" type="string">
            <column name="status_message" />
        </property>
        <property name="createDate" type="string">
            <column name="created_date" />
        </property>
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
           <many-to-one name="recruitmentMaster" class="com.bul.zydex.model.RecruitmentMaster" fetch="select">
            <column name="mpp_id" />
        </many-to-one>
    </class>
  

</hibernate-mapping>
