<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.RegisterMobForPunch" table="register_mob_for_punch" catalog="hr_power_gipcl">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="employeeMaster" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="employee_master_id" not-null="true" />
        </many-to-one>
   
        <property name="imeiNo" type="string">
            <column name="imei_no" not-null="true" />
        </property>

    </class>
</hibernate-mapping>
