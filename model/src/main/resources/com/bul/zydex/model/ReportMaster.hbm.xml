<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.ReportMaster" table="report_master" catalog="eprocsuite_chargezone">
        <id name="code" type="string">
            <column name="Code" />
        </id>
        <property name="name" type="string">
            <column name="Name" length="80"  />
        </property>
        <property name="designation" type="string">
            <column name="Designation" length="30" />
        </property>
        <property name="department" type="string">
            <column name="Department" length="30"  />
        </property>
        <property name="tdate" type="string">
            <column name="T_Date" length="30"  />
        </property>
        <property name="tTime" type="string">
            <column name="T_Time" length="30"  />
        </property>
        <property name="item" type="string">
            <column name="Item" length="30"  />
        </property>
        <property name="numberOfItem" type="java.lang.Integer">
            <column name="Number_Item"  />
        </property>
        <property name="id" type="string">
            <column name="ID" length="30"  />
        </property>
    </class>
</hibernate-mapping>
