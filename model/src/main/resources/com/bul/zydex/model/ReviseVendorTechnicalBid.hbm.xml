<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.ReviseVendorTechnicalBid" table="revise_vendor_technical_bid" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="refNo" type="string">    
            <column name="ref_no" length="200"  />
        </property>
        <property name="vendorCode" type="string">    
            <column name="vendor_code" length="500"  />
        </property>
        <property name="technicalDeviation" type="string">    
            <column name="technical_deviation" length="500"  />
        </property>
        <property name="technicalRemark" type="string">    
            <column name="technical_remark" length="500"  />
        </property>
        <property name="dateTime" type="string">    
            <column name="date_time" length="500"  />
        </property>
    </class>
  
</hibernate-mapping>
