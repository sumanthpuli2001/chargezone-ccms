<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>

<class name="com.bul.zydex.model.SapConnection" table="sap_connection" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id"/>
            <generator class="identity" />
        </id>
         <property name="serverip" type="string">
            <column name="server_ip" length="200"  />
        </property>
        <property name="clientid" type="string">
            <column name="client_id" length="200"  />
        </property>
        <property name="username" type="string">
            <column name="user_name" length="200"  />
        </property>
        <property name="password" type="string">
            <column name="password" length="200"  />
        </property>
        <property name="systemid" type="string">
            <column name="system_id" length="200"  />
        </property>
        <property name="name" type="string">
            <column name="name" length="200"  />
        </property>
 </class>
</hibernate-mapping>