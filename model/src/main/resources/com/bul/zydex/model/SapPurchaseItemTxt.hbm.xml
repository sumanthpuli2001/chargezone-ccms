<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.SapPurchaseItemTxt" table="sap_purchase_item_txt" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="purNo" type="string">
            <column name="pur_no" length="200"  />
        </property>
        <property name="itemNo" type="string">
            <column name="item_no" length="200"  />
        </property>
        <property name="txt" type="string">
            <column name="txt" length="200"  />
        </property>
        
    </class>
  

</hibernate-mapping>
