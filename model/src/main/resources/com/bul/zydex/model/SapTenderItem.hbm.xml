<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.SapTenderItem" table="sap_tender_item" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="itemCode" type="string">
            <column name="item_code" length="200"  />
        </property>
        <property name="itemDesc" type="string">
            <column name="item_desc" length="500"  />
        </property>
        <property name="category" type="string">
            <column name="category" length="200"  />
        </property>
        <property name="location" type="string">
            <column name="location" length="200"  />
        </property>
        <property name="type" type="string">
            <column name="type" length="200"  />
        </property>
        <property name="uom" type="string">
            <column name="uom" length="200"  />
        </property>
        <property name="qty" type="string">
            <column name="qty" length="200"  />
        </property>
        <property name="deliSch" type="string">
            <column name="deli_sch" length="200"  />
        </property>
        <property name="deliSchDate" type="string">
            <column name="deli_sch_date" length="200"  />
        </property>
        <property name="tenderNo" type="string">
            <column name="tender_no" length="200"  />
        </property>
        <property name="purNo" type="string">
            <column name="pur_no" length="200"  />
        </property>
        <property name="itemNo" type="string">
            <column name="item_no" length="200"  />
        </property>
        <property name="srNo" type="string">
            <column name="sr_no" length="200"  />
        </property>
        <property name="prNo" type="string">
            <column name="pr_no" length="200"  />
        </property>
    </class>

</hibernate-mapping>
