<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.SapVendorEmail" table="sap_vendor_email" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="addrNumber" type="string">
            <column name="ADDRNUMBER" length="200"  />
        </property>
        <property name="smtpAddr" type="string">
            <column name="SMTP_ADDR" length="500"  />
        </property>
    </class>

</hibernate-mapping>
