<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.ServiceDetail3" table="service_detail_3" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="srNo" type="double">    
            <column name="sr_no" length="200"  />
        </property>
        <property name="particular" type="string">    
            <column name="particular" length="200"  />
        </property>
        <property name="scheduledAmount" type="string">    
            <column name="scheduled_amount" length="200"  />
        </property>
        <property name="fileName" type="string">    
            <column name="file_name" length="200"  />
        </property>
        <property name="negativeAmount" type="string">    
            <column name="negative_amount" length="200"  />
        </property>
        <property name="tenderNo" type="string">    
            <column name="tender_no" length="200"  />
        </property>
        <property name="refNo" type="string">    
            <column name="ref_no" length="200"  />
        </property>
        
    </class>
</hibernate-mapping>
