<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
 <class name="com.bul.zydex.model.ShiftRegularization" table="shift_regularization" catalog="hr_power_vnc">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="approverId" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="approver_id" />
        </many-to-one>
        <many-to-one name="userMasterId" class="com.bul.zydex.model.UserMaster" fetch="select">
            <column name="user_master_id" />
        </many-to-one>
        <many-to-one name="shiftMasterPrevious" class="com.bul.zydex.model.ShiftMaster" fetch="select">
            <column name="shift_master_previous" />
        </many-to-one>
        <many-to-one name="shiftMasterCurrent" class="com.bul.zydex.model.ShiftMaster" fetch="select">
            <column name="shift_master_current" />
        </many-to-one>
       
        
      
        
        <property name="status" type="int">
            <column name="status" />
        </property>
        <property name="approvalComment" type="string">
            <column name="approval_comment" />
        </property>
        <property name="comment" type="string">
            <column name="comment" />
        </property>
        <property name="rotationDate" type="string">
            <column name="rotation_date" />
        </property>
        <property name="dateOfApproval" type="string">
            <column name="date_of_approval" length="45" />
        </property>
        <property name="dateOfSubmit" type="string">
            <column name="date_of_submit" length="45" />
        </property>
    </class>
  

</hibernate-mapping>
