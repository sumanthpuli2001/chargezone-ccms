<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.SpecialCouponMaster" table="coupon_con_master" catalog="eprocsuite_chargezone" optimistic-lock="version">
        <id name="srNo" type="java.lang.Integer">
            <column name="Sr_no" />
            <generator class="identity" />
        </id>
        <property name="couponType" type="string">
            <column name="Coupon_Type" />
        </property>
        <property name="department" type="string">
            <column name="Department" />
        </property>
        <property name="limitMonth" type="java.lang.Integer">
            <column name="Limit_Month"/>
        </property>
        <property name="limitDay" type="java.lang.Integer">
            <column name="Limit_Day"/>
        </property>
        <property name="designation" type="string">
            <column name="Designation"/>
        </property>  
        <property name="dRow" type="string">
            <column name="D_Row"/>
        </property>  
        <property name="changeAfterDayLimit" type="string">
            <column name="Charge_After_Day_Limit"/>
        </property>

    </class>
  

</hibernate-mapping>
