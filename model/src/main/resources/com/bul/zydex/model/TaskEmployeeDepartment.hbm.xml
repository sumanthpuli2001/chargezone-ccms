<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.TaskEmployeeDepartment" table="task_employee_department" catalog="hr_power_vnc" optimistic-lock="version">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="createTask" class="com.bul.zydex.model.CreateTask" fetch="select">
            <column name="task_id" />
        </many-to-one>
        <many-to-one name="departmentMaster" class="com.bul.zydex.model.DepartmentMaster" fetch="select">
            <column name="department_id" />
        </many-to-one>
        <many-to-one name="employeeMaster" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="employee_id" />
        </many-to-one>
        <property name="authorize" type="java.lang.Boolean">
            <column name="authorize" />
        </property>
    </class>
  

</hibernate-mapping>
