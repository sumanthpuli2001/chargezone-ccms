<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.TaxDeductionDecarationSubmit" table="tax_deduction_decaration_submit" catalog="hr_power_vnc">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="taxSavingSubmit" class="com.bul.zydex.model.TaxSavingSubmit" fetch="select">
            <column name="tax_saving_submit_id" />
        </many-to-one>
        <many-to-one name="payrollTaxDeductionMaster" class="com.bul.zydex.model.PayrollTaxDeductionMaster" fetch="select">
            <column name="payroll_tax_deduction_master_id" />
        </many-to-one>
        <many-to-one name="payrollTaxDeductionComponent" class="com.bul.zydex.model.PayrollTaxDeductionComponent" fetch="select">
            <column name="payroll_tax_deduction_component_id" />
        </many-to-one>
        <property name="amountTaxDecaration" type="java.lang.Double">
            <column name="amount_tax_decaration" precision="22" scale="0" />
        </property>
        <property name="createdDate" type="string">
            <column name="created_date" length="45" />
        </property>
        <property name="updatedDate" type="string">
            <column name="updated_date" length="45" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        <property name="actionStatus" type="java.lang.Integer">
            <column name="action_status" />
        </property>
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
        <property name="updatedBy" type="java.lang.Integer">
            <column name="updated_by" />
        </property>
        <property name="attachment" type="string">
            <column name="attachment" length="45" />
        </property>
        
    </class>
</hibernate-mapping>
