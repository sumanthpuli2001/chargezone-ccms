<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="com.bul.zydex.model.TaxDeductionDeclarationSavingStatus" table="tax_deduction_declaration_saving_status" catalog="hr_power_astral">
   
    <id name="id" type="java.lang.Integer">
      <column name="id"/>
      <generator class="identity"/>
    </id>
    
    <property name="status" type="java.lang.Integer">
      <column name="status"/>
    </property>
    
    <many-to-one class="com.bul.zydex.model.TaxDeductionDecarationSubmit" fetch="select" name="taxDeductionDecarationSubmit">
      <column name="tax_deduction_decaration_submit_id"/>
    </many-to-one>
    
    <property name="statusUpdatedBy" type="java.lang.Integer">
      <column name="status_updated_by"/>
    </property>
    
    <property name="statusUpdatedDate" type="string">
      <column name="status_updated_date"/>
    </property>
    
  </class>
</hibernate-mapping>
