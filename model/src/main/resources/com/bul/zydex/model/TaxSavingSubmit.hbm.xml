<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.TaxSavingSubmit" table="tax_saving_submit" catalog="hr_power_vnc">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="employeeMaster" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="employee_master_id" />
        </many-to-one>
        <many-to-one name="payrollFinancialYear" class="com.bul.zydex.model.PayrollFinancialYear" fetch="select">
            <column name="payroll_financial_year_id" />
        </many-to-one>
       
        <property name="createdDate" type="string">
            <column name="created_date" length="45" />
        </property>
        <property name="updatedDate" type="string">
            <column name="updated_date" length="45" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
        <property name="updatedBy" type="java.lang.Integer">
            <column name="updated_by" />
        </property>
        
    </class>
  

</hibernate-mapping>
