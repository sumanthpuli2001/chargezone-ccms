<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.TechnicalTenderPriceApprovalUser" table="technical_tender_price_approval_user" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="tenderApprovalId" type="java.lang.Integer">
            <column name="tender_approval_id" length="10"  />
        </property>
        <property name="tenderNo" type="string">    
            <column name="tender_no" length="45"  />
        </property>
        <property name="vendorCode" type="string">    
            <column name="vendor_code" length="245"  />
        </property>
       
    
        <property name="userId" type="string">    
            <column name="user_id" length="45"  />
        </property>
        <property name="level" type="java.lang.Integer">
            <column name="level" length="10"  />
        </property>
        <property name="approvalStatus" type="java.lang.Integer">
            <column name="approval_status" length="10"  />
        </property>
       
    </class>
  
</hibernate-mapping>
