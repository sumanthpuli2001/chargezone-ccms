<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.TenderCommittee" table="tender_committee" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="tenderNo" type="string">    
            <column name="tender_no" length="200"  />
        </property>
        <property name="userId" type="string">    
            <column name="user_id" length="200"  />
        </property>
        <property name="bidType" type="java.lang.Integer">
            <column name="bid_type" length="100"  />
        </property>
        <property name="bidOpenStatus" type="java.lang.Integer">
            <column name="bid_open_status" length="100"  />
        </property>
        <property name="bidOpenDate" type="string">    
            <column name="bid_open_date" length="200"  />
        </property>
        <property name="fullName" type="string">    
            <column name="full_name" length="200"  />
        </property>
         
    </class>
  
</hibernate-mapping>
