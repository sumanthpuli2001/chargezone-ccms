<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.TenderFollowup" table="tender_followup" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="activityDate" type="string">    
            <column name="activity_date" length="200"  />
        </property>
        <property name="activity" type="string">    
            <column name="activity" length="200"  />
        </property>
        <property name="person" type="string">    
            <column name="person" length="200"  />
        </property>
        <property name="tenderNo" type="string">    
            <column name="tender_no" length="200"  />
        </property>
        <property name="location" type="string">    
            <column name="location" length="200"  />
        </property>
        <property name="personFullname" type="string">    
            <column name="person_fullname" length="200"  />
        </property>
        
    </class>
</hibernate-mapping>
