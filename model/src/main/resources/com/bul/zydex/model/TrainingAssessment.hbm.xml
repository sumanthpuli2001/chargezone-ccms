<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.TrainingAssessment" table="training_assessment" catalog="hr_power_gipcl" optimistic-lock="version">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="employeeMaster" class="com.bul.zydex.model.EmployeeMaster" fetch="select">
            <column name="emp_id" not-null="true" />
        </many-to-one>
        <many-to-one name="questionPaper" class="com.bul.zydex.model.QuestionPaper" fetch="select">
            <column name="question_paper" not-null="true" />
        </many-to-one>
        <many-to-one name="trainingMaster" class="com.bul.zydex.model.TrainingMaster" fetch="select">
            <column name="training_master_id" not-null="true" />
        </many-to-one>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        <property name="passingPercentage" type="java.lang.Double">
            <column name="passing_percentage" precision="22" scale="0" />
        </property>
        <property name="validityFrom" type="string">
            <column name="validity_from" length="45" />
        </property>
        <property name="validityTo" type="string">
            <column name="validity_to" length="45" />
        </property>
        <property name="duration" type="string">
            <column name="duration" length="45" />
        </property>
        <property name="noOfAttampt" type="java.lang.Integer">
            <column name="no_of_attampt" />
        </property>
        <property name="noOfQue" type="java.lang.Integer">
            <column name="no_of_que" />
        </property>
        <property name="totalMarks" type="java.lang.Double">
            <column name="total_marks" precision="22" scale="0" />
        </property>
        <property name="createdBy" type="java.lang.Integer">
            <column name="created_by" />
        </property>
        <property name="createdDate" type="string">
            <column name="created_date" length="45" />
        </property>
        <property name="updatedBy" type="java.lang.Integer">
            <column name="updated_by" />
        </property>
        <property name="udatedDate" type="string">
            <column name="udated_date" length="45" />
        </property>
        <property name="StartTimeNow" type="string">
            <column name="Start_time_now" length="45" />
        </property>
        <property name="assessmentResultStatus" type="java.lang.Integer">
            <column name="assessment_result_status" />
        </property>
    </class>
  

</hibernate-mapping>
