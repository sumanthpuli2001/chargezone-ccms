<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.TrainingQuestionAnswerSubmit" table="training_question_answer_submit" catalog="hr_power_gipcl" optimistic-lock="version">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="questionAns" class="com.bul.zydex.model.QuestionAns" fetch="select">
            <column name="question_ans_id" />
        </many-to-one>
        <many-to-one name="questionLibrary" class="com.bul.zydex.model.QuestionLibrary" fetch="select">
            <column name="question_library_id" />
        </many-to-one>
        <many-to-one name="trainingAssessment" class="com.bul.zydex.model.TrainingAssessment" fetch="select">
            <column name="training_ass_id" />
        </many-to-one>
        <property name="description" type="string">
            <column name="description" />
        </property>
        <property name="ansStatus" type="java.lang.Integer">
            <column name="ans_status" />
        </property>
        <property name="obtainMarks" type="java.lang.Double">
            <column name="obtain_marks" precision="22" scale="0" />
        </property>
    </class>
  

</hibernate-mapping>
