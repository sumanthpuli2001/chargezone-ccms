<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"classpath://org/hibernate/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VacancyApprovalHistory" table="vacancy_approval_history" catalog="hr_power_gipcl" optimistic-lock="version">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="vacancyMaster" class="com.bul.zydex.model.VacancyMaster" fetch="select">
            <column name="vacancy_id" />
        </many-to-one>
        <property name="comment" type="string">
            <column name="comment" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        <property name="statusMessage" type="string">
            <column name="status_message" />
        </property>
        <property name="createdDate" type="string">
            <column name="created_date" />
        </property>
        <property name="createdBy" type="string">
            <column name="created_by" />
        </property>
    </class>

</hibernate-mapping>
