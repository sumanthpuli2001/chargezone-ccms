<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VacancyMaster" table="vacancy_master" catalog="hr_power_astral">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="locationMaster" class="com.bul.zydex.model.LocationMaster" fetch="select">
            <column name="location_id" />
        </many-to-one>
        <many-to-one name="departmentMaster" class="com.bul.zydex.model.DepartmentMaster" fetch="select">
            <column name="department_id" />
        </many-to-one>
        <many-to-one name="jobtypeMaster" class="com.bul.zydex.model.JobtypeMaster" fetch="select">
            <column name="jobtype_id" />
        </many-to-one>
        <property name="name" type="string">
            <column name="name" />
        </property>
        <property name="numberOfPosition" type="java.lang.Integer">
            <column name="number_of_position" />
        </property>
        <property name="salaryRange" type="java.lang.Integer">
            <column name="salary_range" />
        </property>
        <property name="experience" type="string">
            <column name="experience" />
        </property>
        <property name="responsibility" type="string">
            <column name="responsibility" />
        </property>
        <property name="skill" type="string">
            <column name="skill" />
        </property>
        <property name="fromDate" type="string">
            <column name="from_date" />
        </property>
        <property name="toDate" type="string">
            <column name="to_date" />
        </property>
        <property name="description" type="string">
            <column name="description" />
        </property>
        <property name="status" type="java.lang.Integer">
            <column name="status" />
        </property>
        <many-to-one name="designationMaster" class="com.bul.zydex.model.DesignationMaster" fetch="select">
            <column name="designation_id" />
        </many-to-one>
        <many-to-one name="mprMaster" class="com.bul.zydex.model.MprMaster" fetch="select">
            <column name="mpr_master_id" />
        </many-to-one>
    </class>
</hibernate-mapping>
