<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorApproval" table="vendor_approval" catalog="eprocsuite_chargezone" optimistic-lock="version">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="vendorInformationId" type="java.lang.Integer">
            <column name="vendor_information_id" />
        </property>
        <property name="activity" type="string">
            <column name="activity" />
        </property>
        <property name="description" type="string">
            <column name="description" />
        </property>
        <property name="userId" type="string">
            <column name="user_id" />
        </property>
        <property name="dateTime" type="string">
            <column name="date_time" />
        </property>
        <property name="userRole" type="string">
            <column name="user_role" />
        </property>
    </class>
</hibernate-mapping>
