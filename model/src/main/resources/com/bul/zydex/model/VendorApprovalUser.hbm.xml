<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorApprovalUser" table="vendor_approval_user" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
     
        <many-to-one name="vendorApprovalSetting" class="com.bul.zydex.model.VendorApprovalSetting">
            <column name="vendor_approval_id" not-null="true"></column>
        </many-to-one>
        <property name="userId" type="string">    
            <column name="user_id" length="1000"  />
        </property>
        <property name="level" type="java.lang.Integer">    
            <column name="level" length="1000"  />
        </property>
       
        
    </class>
</hibernate-mapping>
