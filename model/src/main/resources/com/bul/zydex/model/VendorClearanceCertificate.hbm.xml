<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorClearanceCertificate" table="vendor_clearance_certificate" catalog="eprocsuite_chargezone" optimistic-lock="version">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="vendorInformationId" type="java.lang.Integer">
            <column name="vendor_information_id" />
        </property>
        <property name="processDetail" type="string">
            <column name="process_detail" />
        </property>
        <property name="hazardiousMaterial" type="string">
            <column name="hazardious_material" />
        </property>
        <property name="certificateNo" type="string">
            <column name="certificate_no" />
        </property>
        <property name="description" type="string">
            <column name="description" />
        </property>
    </class>
</hibernate-mapping>
