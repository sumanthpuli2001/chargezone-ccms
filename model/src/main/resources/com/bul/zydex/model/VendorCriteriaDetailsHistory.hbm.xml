<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorCriteriaDetailsHistory" table="vendor_criteria_details_history" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="vendorCriteriaMasterHistoryId" type="java.lang.Integer">    
            <column name="vendor_criteria_master_history_id"   />
        </property>
         <property name="actionBy" type="string">    
            <column name="action_by"   />
        </property>
         <property name="date" type="string">    
            <column name="date"   />
        </property>
        <property name="criteriaName" type="string">    
            <column name="criteria_name"   />
        </property>
         <property name="criteriaDescription" type="string">    
            <column name="criteria_description"   />
        </property>
        <property name="mandatory" type="string">    
            <column name="mandatory"   />
        </property>
          <property name="compulsary" type="string">    
            <column name="compulsary"   />
        </property>
         <property name="vendorCriteriaMasterId" type="java.lang.Integer">    
            <column name="vendor_criteria_master_id"   />
        </property>
         <property name="action" type="string">    
            <column name="action"   />
        </property>
    </class>
  

</hibernate-mapping>
