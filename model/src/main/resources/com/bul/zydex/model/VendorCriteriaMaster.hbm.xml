<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorCriteriaMaster" table="vendor_criteria_master" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="groupMasterId" type="java.lang.Integer">    
            <column name="group_master_id"  />
        </property>
        <property name="groupCategoryId" type="java.lang.Integer">    
            <column name="group_category_id" />
        </property>
        <property name="groupSubCategoryId" type="java.lang.Integer">    
            <column name="group_sub_category_id"/>
        </property>
       
         <property name="departmentCategory" type="string">    
            <column name="department_category"/>
        </property>
    </class>
  

</hibernate-mapping>
