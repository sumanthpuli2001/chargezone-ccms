<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorCriteriaMasterHistory" table="vendor_criteria_master_history" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="vendorCriteriaMasterId" type="java.lang.Integer">    
            <column name="vendor_critera_master_id"   />
        </property>
        <property name="createdBy" type="string">    
            <column name="created_by"   />
        </property>
         <property name="createdDate" type="string">    
            <column name="created_date"   />
        </property>
        <property name="actionBy" type="string">    
            <column name="action_by"   />
        </property>
        
    </class>
  

</hibernate-mapping>
