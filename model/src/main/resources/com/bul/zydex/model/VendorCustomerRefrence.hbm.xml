<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorCustomerRefrence" table="vendor_customer_refrence" catalog="eprocsuite_chargezone" optimistic-lock="version">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="vendorInformationId" type="java.lang.Integer">
            <column name="vendor_information_id" />
        </property>
        <property name="companyName" type="string">
            <column name="company_name" />
        </property>
        <property name="contactPersonName" type="string">
            <column name="contact_person_name" />
        </property>
        <property name="contactDetails" type="string">
            <column name="contact_details" />
        </property>
        
    </class>
</hibernate-mapping>
