<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorDepartmentApproval" table="vendor_department_approval" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="departmentId" type="string">    
            <column name="department_id" length="200"  />
        </property>
          <property name="approvalName" type="string">    
            <column name="approval_Name" length="200"  />
        </property>
    </class>
  

</hibernate-mapping>
