<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorEmd" table="vendor_emd" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="refNo" type="string">    
            <column name="ref_no" length="200"  />
        </property>
        <property name="vendorCode" type="string">    
            <column name="vendor_code" length="500"  />
        </property>
        <property name="emdDate" type="string">    
            <column name="emd_date" length="500"  />
        </property>
        <property name="emdAmount" type="string">    
            <column name="emd_amount" length="500"  />
        </property>
        <property name="draweeBank" type="string">    
            <column name="drawee_bank" length="500"  />
        </property>
        <property name="attachment" type="string">    
            <column name="attachment" length="500"  />
        </property>
        <property name="cashCheque" type="string">    
            <column name="cash_cheque" length="500"  />
        </property>
        <property name="chequeNo" type="string">    
            <column name="cheque_no" length="500"  />
        </property>
    </class>
  
</hibernate-mapping>
