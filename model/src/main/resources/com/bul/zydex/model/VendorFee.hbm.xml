<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorFee" table="vendor_fee" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="refNo" type="string">    
            <column name="ref_no" length="200"  />
        </property>
        <property name="vendorCode" type="string">    
            <column name="vendor_code" length="500"  />
        </property>
        <property name="feeDate" type="string">    
            <column name="fee_date" length="500"  />
        </property>
        <property name="feeAmount" type="string">    
            <column name="fee_amount" length="500"  />
        </property>
        <property name="draweeBank" type="string">    
            <column name="drawee_bank" length="500"  />
        </property>
        <property name="attachment" type="string">    
            <column name="attachment" length="500"  />
        </property>
        <property name="chequeNo" type="string">    
            <column name="cheque_no" length="500"  />
        </property>
    </class>
  
</hibernate-mapping>
