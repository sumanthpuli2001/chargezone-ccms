<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>

<class name="com.bul.zydex.model.VendorInvitationCategory" table="vendor_invitation_category" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id"/>
            <generator class="identity" />
        </id>
         <property name="vendorId" type="string">
            <column name="vendor_id" length="50"  />
        </property>
        <property name="groupId" type="string">
            <column name="group_id" length="50"  />
        </property>
        <property name="groupCategoryId" type="string">
            <column name="group_category_id" length="50"  />
        </property>
        <property name="groupSubCategoryId" type="string">
            <column name="group_sub_category_id" length="50"  />
        </property>
       
        
 </class>
</hibernate-mapping>