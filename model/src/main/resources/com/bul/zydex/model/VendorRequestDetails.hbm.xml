<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorRequestDetails" table="vendor_request_details" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        
        <property name="contactaName" type="string">    
            <column name="contact_name" length="1000"  />
        </property>
        <property name="email" type="string">    
            <column name="email" length="1000"  />
        </property>
         <property name="phoneNo" type="string">    
            <column name="phone_no" length="1000"  />
        </property>
        <property name="company" type="string">    
            <column name="company" length="1000"  />
        </property>
        <property name="address" type="string">    
            <column name="address" length="1000"  />
        </property>
        <property name="description" type="string">    
            <column name="description" length="1000"  />
        </property>
         <property name="flagStatus" type="java.lang.Integer">    
            <column name="flag_status" length="1000"  />
        </property>
         <property name="vendorApprovalSetting" type="java.lang.Integer">    
            <column name="vendor_approval_setting" length="1000"  />
        </property>
         <property name="createdBy" type="string">    
            <column name="createdBy" length="1000"  />
        </property>
    </class>
</hibernate-mapping>
