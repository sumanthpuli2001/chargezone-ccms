<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorSafetyCriteriaComment" table="vendor_safety_criteria_comment" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="vendorCriteriaMasterId" type="java.lang.Integer">    
            <column name="vendor_criteria_master_id" length="500"  />
        </property>
        <property name="criteriaName" type="string">    
            <column name="criteria_name" length="500"  />
        </property>
        <property name="criteriaDescription" type="string">    
            <column name="criteria_description" length="500"  />
        </property>
        <property name="comment" type="string">    
            <column name="comment" length="500"  />
        </property>
        <property name="attachement" type="string">    
            <column name="attachment" length="500"  />
        </property>
        <property name="vendorInformationId" type="string">    
            <column name="vendor_information_id" length="250"  />
        </property>
        
        
        <property name="accept" type="java.lang.Integer">    
            <column name="accept"   />
        </property>
        
        <property name="remark" type="string">    
            <column name="remark" length="250"  />
        </property>
        <property name="score" type="string">    
            <column name="score" length="250"  />
        </property>
        <property name="safetyComment" type="string">    
            <column name="safety_comment" length="250"  />
        </property>
        <property name="compulsaryFlag" type="string">    
            <column name="compulsary_flag" length="250"  />
        </property>
    </class>
  

</hibernate-mapping>
