<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorTechnicalBid" table="vendor_technical_bid" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="refNo" type="string">    
            <column name="ref_no" length="200"  />
        </property>
        <property name="vendorCode" type="string">    
            <column name="vendor_code" length="500"  />
        </property>
        <property name="technicalDeviation" type="string">    
            <column name="technical_deviation" length="500"  />
        </property>
        <property name="technicalRemark" type="string">    
            <column name="technical_remark" length="500"  />
        </property>
        <property name="bidOpenDate" type="string">    
            <column name="bid_open_date" length="500"  />
        </property>
        <property name="bidOpenBy" type="string">    
            <column name="bid_open_by" length="500"  />
        </property>
        <property name="bidOpenById" type="string">    
            <column name="bid_open_by_id" length="500"  />
        </property>
        <property name="bidOpenFlag" type="string">    
            <column name="bid_open_flag" length="500"  />
        </property>
        <property name="bidApproveDate" type="string">    
            <column name="bid_approve_date" length="500"  />
        </property>
        <property name="bidApproveBy" type="string">    
            <column name="bid_approve_by" length="500"  />
        </property>
        <property name="bidApproveById" type="string">    
            <column name="bid_approve_by_id" length="500"  />
        </property>
        <property name="bidApproveFlag" type="string">    
            <column name="bid_approve_flag" length="500"  />
        </property>     
        <property name="reviseBidFlag" type="java.lang.Integer">    
            <column name="revise_bid_flag" length="500"  />
        </property>
        <property name="techPercentage" type="string">    
            <column name="tech_percentage" length="500"  />
        </property>     
    </class>
  
</hibernate-mapping>
