<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorTechnicalBidTerms" table="vendor_technical_bid_terms" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="refNo" type="string">    
            <column name="ref_no" length="200"  />
        </property>
        <property name="vendorCode" type="string">    
            <column name="vendor_code" length="500"  />
        </property>
        <property name="description" type="string">    
            <column name="description" length="500"  />
        </property>
        <property name="details" type="string">    
            <column name="details" length="500"  />
        </property>
        <property name="attachmentRequired" type="string">    
            <column name="attachment_required" length="500"  />
        </property>
        <property name="vendorResponse" type="java.lang.Integer">    
            <column name="vendor_response" length="500"  />
        </property>
        <property name="remark" type="string">    
            <column name="remark" length="500"  />
        </property>
        <property name="attachment" type="string">    
            <column name="attachment" length="500"  />
        </property>
        <property name="itemCode" type="string">    
            <column name="item_code" length="500"  />
        </property>
        <property name="uom" type="string">    
            <column name="uom" length="500"  />
        </property>
        <property name="qty" type="string">    
            <column name="qty" length="500"  />
        </property>
        <property name="srNo" type="string">    
            <column name="sr_no" length="500"  />
        </property>
        <property name="buyerResponse" type="java.lang.Integer">    
            <column name="buyer_response" length="500"  />
        </property>
        <property name="buyerRemark" type="string">    
            <column name="buyer_remark" length="500"  />
        </property>
        <property name="reviseVendorTechnicalBidId" type="java.lang.Integer">    
            <column name="revise_vendor_technical_bid_id" length="500"  />
        </property>
    </class>
  
</hibernate-mapping>
