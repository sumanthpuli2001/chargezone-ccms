<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorTechnicalCriteria" table="vendor_technical_criteria" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
       
        <property name="groupMasterId" type="java.lang.Integer">    
            <column name="group_master_id" length="200"  />
        </property>
        <property name="groupCategoryId" type="java.lang.Integer">    
            <column name="group_category_id" length="200"  />
        </property>
        <property name="groupSubCategoryId" type="java.lang.Integer">    
            <column name="group_sub_category_id" length="200"  />
        </property>
        <property name="criteriaName" type="string">    
            <column name="criteria_name" length="200"  />
        </property>
        <property name="criteriaDescription" type="string">    
            <column name="criteria_description" length="200"  />
        </property>
        <property name="mandatory" type="string">    
            <column name="mandatory" length="250"  />
        </property>
          <property name="compulsaryFlag" type="string">    
            <column name="compulsary_flag" length="250"  />
        </property>
    </class>
  

</hibernate-mapping>
