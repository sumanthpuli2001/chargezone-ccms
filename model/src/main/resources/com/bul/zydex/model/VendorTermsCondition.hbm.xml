<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.bul.zydex.model.VendorTermsCondition" table="vendor_terms_condition" catalog="eprocsuite_chargezone">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="tenderNo" type="string">    
            <column name="tender_no" length="200"  />
        </property>
        <property name="vendorCode" type="string">    
            <column name="vendor_code" length="200"  />
        </property>
        <property name="termsCondition" type="string">    
            <column name="terms_condition" length="200"  />
        </property>
        <property name="response" type="string">    
            <column name="response" length="200"  />
        </property>
         <property name="comment" type="string">    
            <column name="comment" length="200"  />
        </property>
        
        <property name="description" type="string">    
            <column name="description" length="1000"  />
        </property>
    </class>

</hibernate-mapping>
