<script>
	function closewindow() {
            if(${vendorTechnicalBidTermsAttachment.size()} !== 0)
            {
                window.opener.document.getElementById('termDocument' + document.getElementById("srNo").value).innerHTML='Document Attached';
            }
            else
            {
                window.opener.document.getElementById('termDocument' + document.getElementById("srNo").value).innerHTML='';
            }
            window.opener.document.getElementById('vendor_terms_attach' + document.getElementById("srNo").value).value=${vendorTechnicalBidTermsAttachment.size()};
            window.close();
	}
</script>

